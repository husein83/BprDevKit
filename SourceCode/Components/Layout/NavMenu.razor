@using BprDevKit.Utility
@using BprDevKit.Localization
@inject ITranslationFactory TranslationFactory
@implements IDisposable

@{
    var t = TranslationFactory.Current;
}

<div class="sidebar-shell">
    <div class="sidebar-brand">
        <a href="" class="brand-link" aria-label="BprDevKit home">
            <span class="brand-mark">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.75A2.75 2.75 0 0 1 7.75 2h8.5A2.75 2.75 0 0 1 19 4.75v14.5A2.75 2.75 0 0 1 16.25 22h-8.5A2.75 2.75 0 0 1 5 19.25V4.75Zm3 2.5v2h8v-2H8Zm0 5v4.5h3v-4.5H8Zm5 0v4.5h3v-4.5h-3Z" /></svg>
            </span>
            <span><strong>@t[TranslationKeys.AppName]</strong><small>@t[TranslationKeys.SqlWorkspace]</small></span>
        </a>
        <label class="navbar-toggler" for="sidebar-menu-toggle" aria-label="Toggle navigation menu"><span></span><span></span><span></span></label>
    </div>

    <input id="sidebar-menu-toggle" type="checkbox" class="sidebar-menu-toggle" />

    <div class="nav-scrollable" onclick="document.querySelector('.sidebar-menu-toggle').checked = false">
        <nav class="sidebar-nav" aria-label="Main navigation">
            <NavLink class="side-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10.5 9-7 9 7v9.25A1.25 1.25 0 0 1 19.75 21H15v-6H9v6H4.25A1.25 1.25 0 0 1 3 19.75V10.5Z" /></svg></span>
                <span>@t[TranslationKeys.Home]</span>
            </NavLink>
            <NavLink class="side-link" href="database-management">
                <span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5C4 3.57 7.58 2 12 2s8 1.57 8 3.5S16.42 9 12 9 4 7.43 4 5.5Zm0 6C4 13.43 7.58 15 12 15s8-1.57 8-3.5v4C20 17.43 16.42 19 12 19s-8-1.57-8-3.5v-4Zm0 6C4 19.43 7.58 21 12 21s8-1.57 8-3.5v-1.1C18.17 20.4 15.2 21 12 21s-6.17-.6-8-1.6v-1.9Z" /></svg></span>
                <span>@t[TranslationKeys.DatabaseManagement]</span>
            </NavLink>
            <NavLink class="side-link" href="script-generator">
                <span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm-1.5 14.5-2.5-2.5 2.5-2.5 1.06 1.06-1.44 1.44 1.44 1.44-1.06 1.06zm3 0-1.06-1.06 1.44-1.44-1.44-1.44 1.06-1.06 2.5 2.5-2.5 2.5zM13 9V3.5L18.5 9H13z"/></svg></span>
                <span>@t[TranslationKeys.ScriptGenerator]</span>
            </NavLink>
            <NavLink class="side-link" href="data-model-generator">
                <span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.4 16.6-4.6-4.6 4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0 4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg></span>
                <span>@t[TranslationKeys.DataModelTitle]</span>
            </NavLink>
            <NavLink class="side-link" href="configuration-setting">
                <span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8.25a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Zm0 2.25c.8 0 1.57-.16 2.27-.45l1.6 1.6-1.2 2.08 1.55 2.68 2.4-.62 1.2 2.08-1.74 1.74-2.08-1.2-2.68 1.55.62 2.4H10.8l.62-2.4-2.68-1.55-2.08 1.2-1.74-1.74 1.2-2.08-1.55-2.68-2.4.62v-2.4l2.4.62 1.55-2.68-1.2-2.08 1.74-1.74 2.08 1.2c.7-.29 1.47-.45 2.27-.45Zm0 2.5a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Z" /></svg></span>
                <span>@t[TranslationKeys.Settings]</span>
            </NavLink>
            <NavLink class="side-link" href="logs">
                <span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg></span>
                <span>@t[TranslationKeys.Logs]</span>
            </NavLink>
        </nav>

        <div class="px-3 py-2 border-top border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
            <button class="btn btn-sm theme-toggle-btn w-100 d-flex align-items-center justify-content-center gap-2"
                    type="button"
                    onclick="window.themeManager.toggleTheme()"
                    title="@t[TranslationKeys.ThemeToggle]">
                <i class="bi bi-moon-stars-fill" id="theme-toggle-icon"></i>
                <small id="theme-label-dark">@t[TranslationKeys.ThemeDarkMode]</small>
                <small id="theme-label-light" style="display: none;">@t[TranslationKeys.ThemeLightMode]</small>
            </button>
        </div>

        <footer class="sidebar-footer">
            <span class="footer-dot"></span>
            <span>@Constants.Copyright</span>
        </footer>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        TranslationFactory.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(Language language)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TranslationFactory.LanguageChanged -= OnLanguageChanged;
    }
}
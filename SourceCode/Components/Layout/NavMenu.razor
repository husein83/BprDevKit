@using BprDevKit.Utility

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BprDevKit</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable d-flex flex-column" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="server-management">
                <span class="bi bi-gear-fill" aria-hidden="true"></span> Server Settings
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard">
                <span class="bi bi-database-fill" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
    </nav>

    <footer class="mt-auto py-3 text-center text-white-50">
        <div class="fs-6">
            <i class="bi bi-c-circle-fill me-1"></i> @Constants.Copyright
        </div>
    </footer>
</div>

@using System.Data
@using BprDevKit.Config
@using BprDevKit.DatabaseManagement.Models.Operations;
@using BprDevKit.DatabaseManagement.Services
@inject DatabaseManagerFactory DatabaseManagerFactory

<div class="databases-management">
    <div class="database-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h4 mb-1"><i class="bi bi-database-fill text-primary me-2"></i>Databases</h2>
            <p class="text-muted mb-0">Create, update, inspect, and remove databases on the selected server.</p>
        </div>
        <button class="create-database-button btn btn-primary" type="button" @onclick="OpenCreateDatabase">
            <i class="bi bi-plus-lg me-1"></i> Create database
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="database-alert alert @_messageClass alert-dismissible fade show" role="alert">
            <i class="bi @_messageIcon me-2"></i>@_message
            <button class="btn-close" type="button" @onclick="ClearMessage"></button>
        </div>
    }

    @if (_showCreateForm)
    {
        <div class="database-editor card border-primary shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-database-add me-2"></i>Create database</span>
                <button class="btn-close btn-close-white" type="button" @onclick="CloseCreateDatabase"></button>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="database-name">Database name</label>
                        <input id="database-name" class="form-control" maxlength="128" @bind="_createConfiguration.DatabaseName" placeholder="ExampleDb" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="database-collation">Collation <span class="text-muted fw-normal">(optional)</span></label>
                        <select id="database-collation" class="form-select" @bind="_createConfiguration.Collation">
                            <option value="">Server default</option>
                            @foreach (var collation in _collations)
                            {
                                <option value="@collation">@collation</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="data-directory">Data directory</label>
                        <input id="data-directory" class="form-control" @bind="_createConfiguration.DataFilePath" placeholder="D:\\SqlData" />
                        <div class="form-text">The application creates <code>DatabaseName.mdf</code> in this directory.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="log-directory">Log directory <span class="text-muted fw-normal">(optional)</span></label>
                        <input id="log-directory" class="form-control" @bind="_createConfiguration.LogFilePath" placeholder="D:\\SqlLogs" />
                        <div class="form-text">Empty uses the data directory and creates <code>DatabaseName_log.ldf</code>.</div>
                    </div>
                </div>

                <hr class="my-4" />
                <h3 class="h6 text-uppercase text-muted mb-3">Data file</h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="data-initial-size">Initial size (MB)</label>
                        <input id="data-initial-size" type="number" min="1" class="form-control" @bind="_createConfiguration.InitialSizeMB" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="data-max-size">Max size (MB)</label>
                        <input id="data-max-size" type="number" min="1" class="form-control" @bind="_createConfiguration.MaxSizeMB" placeholder="Unlimited" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="data-growth">Growth (MB)</label>
                        <input id="data-growth" type="number" min="1" class="form-control" @bind="_createConfiguration.FileGrowthMB" />
                    </div>
                </div>

                <h3 class="h6 text-uppercase text-muted mb-3 mt-4">Log file</h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="log-initial-size">Initial size (MB)</label>
                        <input id="log-initial-size" type="number" min="1" class="form-control" @bind="_createConfiguration.LogInitialSizeMB" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="log-max-size">Max size (MB)</label>
                        <input id="log-max-size" type="number" min="1" class="form-control" @bind="_createConfiguration.LogMaxSizeMB" placeholder="Unlimited" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="log-growth">Growth (MB)</label>
                        <input id="log-growth" type="number" min="1" class="form-control" @bind="_createConfiguration.LogFileGrowthMB" />
                    </div>
                </div>

                <h3 class="h6 text-uppercase text-muted mb-3 mt-4">Database options</h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="recovery-model">Recovery model</label>
                        <select id="recovery-model" class="form-select" @bind="_createConfiguration.RecoveryModel">
                            <option value="SIMPLE">Simple</option>
                            <option value="FULL">Full</option>
                            <option value="BULK_LOGGED">Bulk logged</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="page-verify">Page verify</label>
                        <select id="page-verify" class="form-select" @bind="_createConfiguration.PageVerify">
                            <option value="CHECKSUM">Checksum</option>
                            <option value="TORN_PAGE_DETECTION">Torn page detection</option>
                            <option value="NONE">None</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="compatibility-level">Compatibility level <span class="text-muted fw-normal">(optional)</span></label>
                        <input id="compatibility-level" type="number" min="1" class="form-control" @bind="_createConfiguration.CompatibilityLevel" placeholder="Server default" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="file-group">Additional filegroup <span class="text-muted fw-normal">(optional)</span></label>
                        <input id="file-group" maxlength="128" class="form-control" @bind="_createConfiguration.FileGroup" placeholder="Reporting" />
                        <div class="form-text">Creates an empty filegroup after the database is created.</div>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input id="is-read-only" class="form-check-input" type="checkbox" @bind="_createConfiguration.IsReadOnly" /><label class="form-check-label" for="is-read-only">Read-only</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input id="auto-shrink" class="form-check-input" type="checkbox" @bind="_createConfiguration.AutoShrink" /><label class="form-check-label" for="auto-shrink">Auto shrink</label>
                        </div>
                    </div>
                    <div class="col-md-4"><div class="form-check form-switch"><input id="auto-close" class="form-check-input" type="checkbox" @bind="_createConfiguration.AutoClose" /><label class="form-check-label" for="auto-close">Auto close</label></div></div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn btn-light" type="button" @onclick="CloseCreateDatabase">Cancel</button>
                    <button class="btn btn-success" type="button" @onclick="CreateDatabase" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Create database
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (_isLoading)
            {
                <div class="text-center py-5"><span class="spinner-border text-primary me-2"></span>Loading databases…</div>
            }
            else if (_databases.Count == 0)
            {
                <div class="text-center text-muted py-5"><i class="bi bi-database-x display-6"></i><p class="mt-3 mb-0">No user databases were found on this server.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="database-list-table table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th class="ps-4">Database</th><th class="text-end pe-4">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var databaseName in _databases)
                            {
                                <tr>
                                    <td class="ps-4"><i class="bi bi-database me-2 text-primary"></i><span class="font-monospace">@databaseName</span></td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" type="button" title="View details" @onclick="() => ViewDatabase(databaseName)"><i class="bi bi-info-circle"></i></button>
                                            <button class="btn btn-outline-secondary" type="button" title="Edit options" @onclick="() => OpenEditDatabase(databaseName)"><i class="bi bi-pencil-square"></i></button>
                                            <button class="btn btn-outline-danger" type="button" title="Delete database" @onclick="() => OpenDeleteDatabase(databaseName)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (_showEditDialog)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header"><h2 class="modal-title fs-5"><i class="bi bi-pencil-square me-2"></i>Edit <span class="font-monospace">@_editConfiguration.DatabaseName</span></h2><button class="btn-close" type="button" @onclick="CloseDialogs"></button></div>
                    <div class="modal-body">
                        <p class="text-muted small">Leave a select box on “Keep current value” to leave that setting unchanged.</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="edit-collation">Collation</label><select id="edit-collation" class="form-select" @bind="_editConfiguration.Collation">
                                <option value="">Keep current value</option>@foreach (var collation in _collations) {
                                <option value="@collation">@collation</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="edit-recovery">Recovery model</label><select id="edit-recovery" class="form-select" @bind="_editConfiguration.RecoveryModel"><option value="">Keep current value</option><option value="SIMPLE">Simple</option><option value="FULL">Full</option><option value="BULK_LOGGED">Bulk logged</option></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="edit-page-verify">Page verify</label><select id="edit-page-verify" class="form-select" @bind="_editConfiguration.PageVerify"><option value="">Keep current value</option><option value="CHECKSUM">Checksum</option><option value="TORN_PAGE_DETECTION">Torn page detection</option><option value="NONE">None</option></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="edit-compatibility">Compatibility level</label><input id="edit-compatibility" type="number" min="1" class="form-control" @bind="_editConfiguration.CompatibilityLevel" placeholder="Keep current value" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="edit-read-only">Read-only</label><select id="edit-read-only" class="form-select" @bind="_readOnlySelection"><option value="">Keep current value</option><option value="true">Enable</option><option value="false">Disable</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="edit-auto-shrink">Auto shrink</label><select id="edit-auto-shrink" class="form-select" @bind="_autoShrinkSelection"><option value="">Keep current value</option><option value="true">Enable</option><option value="false">Disable</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="edit-auto-close">Auto close</label><select id="edit-auto-close" class="form-select" @bind="_autoCloseSelection"><option value="">Keep current value</option><option value="true">Enable</option><option value="false">Disable</option></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-light" type="button" @onclick="CloseDialogs">Cancel</button><button class="btn btn-primary" type="button" @onclick="SaveDatabaseChanges" disabled="@_isSaving">Save changes</button></div>
        </div>
    </div>
</div><div class="modal-backdrop fade show"></div>
}

@if (_showDeleteDialog)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h2 class="modal-title fs-5"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete database</h2><button class="btn-close btn-close-white" type="button" @onclick="CloseDialogs"></button>
                </div>
                <div class="modal-body">
                    <p>Delete <strong class="font-monospace">@_deleteConfiguration.DatabaseName</strong> permanently?</p><p class="text-danger small">This action cannot be undone.</p><div class="form-check"><input id="force-disconnect" type="checkbox" class="form-check-input" @bind="_deleteConfiguration.ForceDisconnect" /><label class="form-check-label" for="force-disconnect">Disconnect active users and roll back their transactions</label></div><div class="form-check mt-2"><input id="ignore-if-not-exists" type="checkbox" class="form-check-input" @bind="_deleteConfiguration.IgnoreIfNotExists" /><label class="form-check-label" for="ignore-if-not-exists">Treat an already deleted database as successful</label></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" type="button" @onclick="CloseDialogs">Cancel</button><button class="btn btn-danger" type="button" @onclick="DeleteDatabase" disabled="@_isSaving">Delete database</button>
                </div>
            </div>
        </div>
    </div><div class="modal-backdrop fade show"></div>
}

@if (_showInformationDialog && _databaseInformation is not null)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5"><i class="bi bi-info-circle me-2"></i>Database details</h2><button class="btn-close" type="button" @onclick="CloseDialogs"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
                        @foreach (DataColumn column in _databaseInformation.Columns)
                        {
                            <dt class="col-sm-5 text-muted">@column.ColumnName</dt>
                            <dd class="col-sm-7 text-break">@FormatValue(_databaseInformation.Rows[0][column])</dd>
                        }
                    </dl>
                </div>
                <div class="modal-footer"><button class="btn btn-primary" type="button" @onclick="CloseDialogs">Close</button></div>
            </div>
        </div>
    </div><div class="modal-backdrop fade show"></div>
}
</div>

@code {
    [Parameter] public ServerConfiguration? ServerConfig { get; set; }
    [Parameter] public EventCallback<string> OnOperationComplete { get; set; }

    private DatabaseManager? _databaseManager;
    private Guid? _loadedServerId;
    private List<string> _databases = new();
    private List<string> _collations = new();
    private DatabaseOperation.Create _createConfiguration = new();
    private DatabaseOperation.Alter _editConfiguration = new();
    private DatabaseOperation.Drop _deleteConfiguration = new();
    private DataTable? _databaseInformation;
    private bool _showCreateForm;
    private bool _showEditDialog;
    private bool _showDeleteDialog;
    private bool _showInformationDialog;
    private bool _isLoading;
    private bool _isSaving;
    private string? _message;
    private string _messageClass = "alert-info";
    private string _messageIcon = "bi-info-circle-fill";
    private string _readOnlySelection = string.Empty;
    private string _autoShrinkSelection = string.Empty;
    private string _autoCloseSelection = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (ServerConfig?.Id == _loadedServerId)
            return;

        _loadedServerId = ServerConfig?.Id;
        _databaseManager = ServerConfig is null ? null : DatabaseManagerFactory.Create(ServerConfig);
        _databases.Clear();
        _collations.Clear();
        CloseCreateDatabase();
        CloseDialogs();

        if (_databaseManager is not null)
        {
            await LoadDatabases();
            await LoadCollations();
        }
    }

    private async Task LoadDatabases()
    {
        if (_databaseManager is null) return;
        _isLoading = true;
        try
        {
            var result = await _databaseManager.GetDatabases();
            if (result.operationResult.Success)
                _databases = result.databases;
            else
                ShowMessage(result.operationResult.Message, "alert-danger", "bi-x-octagon-fill");
        }
        catch (Exception exception)
        {
            ShowMessage($"Unable to load databases: {exception.Message}", "alert-danger", "bi-x-octagon-fill");
        }
        finally { _isLoading = false; }
    }

    private async Task LoadCollations()
    {
        if (_databaseManager is null) return;
        var result = await _databaseManager.GetCollations();
        if (result.operationResult.Success) _collations = result.collations;
    }

    private void OpenCreateDatabase()
    {
        _createConfiguration = new DatabaseOperation.Create { InitialSizeMB = 8, FileGrowthMB = 64, LogInitialSizeMB = 8, LogFileGrowthMB = 64, RecoveryModel = "SIMPLE", PageVerify = "CHECKSUM" };
        _showCreateForm = true;
    }

    private void CloseCreateDatabase() { _showCreateForm = false; _createConfiguration = new DatabaseOperation.Create(); }

    private async Task CreateDatabase()
    {
        if (_databaseManager is null) return;
        _isSaving = true;
        try
        {
            var result = await _databaseManager.CreateDatabase(_createConfiguration);
            ShowMessage(result.Message, result.Success ? "alert-success" : "alert-danger", result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill");
            if (result.Success) { CloseCreateDatabase(); await LoadDatabases(); }
            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowMessage($"Unable to create database: {exception.Message}", "alert-danger", "bi-x-octagon-fill"); }
        finally { _isSaving = false; }
    }

    private async Task OpenEditDatabase(string databaseName)
    {
        if (_databaseManager is null) return;

        _isSaving = true;
        try
        {
            var result = await _databaseManager.GetDatabaseConfiguration(new DatabaseOperation.Information { DatabaseName = databaseName });
            if (result.operationResult.Success && result.configuration is not null)
            {
                _editConfiguration = result.configuration;
                _readOnlySelection = _editConfiguration.IsReadOnly switch
                {
                    true => "true",
                    false => "false",
                    _ => string.Empty
                };
                _autoShrinkSelection = _editConfiguration.AutoShrink switch
                {
                    true => "true",
                    false => "false",
                    _ => string.Empty
                };
                _autoCloseSelection = _editConfiguration.AutoClose switch
                {
                    true => "true",
                    false => "false",
                    _ => string.Empty
                };
                _showEditDialog = true;
            }
            else
            {
                ShowMessage(result.operationResult.Message, "alert-danger", "bi-x-octagon-fill");
            }
        }
        catch (Exception exception)
        {
            ShowMessage($"Unable to load database configuration: {exception.Message}", "alert-danger", "bi-x-octagon-fill");
        }
        finally { _isSaving = false; }
    }

    private async Task SaveDatabaseChanges()
    {
        if (_databaseManager is null) return;
        _editConfiguration.IsReadOnly = ParseNullableBoolean(_readOnlySelection);
        _editConfiguration.AutoShrink = ParseNullableBoolean(_autoShrinkSelection);
        _editConfiguration.AutoClose = ParseNullableBoolean(_autoCloseSelection);
        _isSaving = true;
        try
        {
            var result = await _databaseManager.AlterDatabase(_editConfiguration);
            ShowMessage(result.Message, result.Success ? "alert-success" : "alert-danger", result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill");
            if (result.Success) CloseDialogs();
            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowMessage($"Unable to update database: {exception.Message}", "alert-danger", "bi-x-octagon-fill"); }
        finally { _isSaving = false; }
    }

    private void OpenDeleteDatabase(string databaseName)
    {
        _deleteConfiguration = new DatabaseOperation.Drop { DatabaseName = databaseName, IgnoreIfNotExists = true, ForceDisconnect = true };
        _showDeleteDialog = true;
    }

    private async Task DeleteDatabase()
    {
        if (_databaseManager is null) return;
        _isSaving = true;
        try
        {
            var result = await _databaseManager.DropDatabase(_deleteConfiguration);
            ShowMessage(result.Message, result.Success ? "alert-success" : "alert-danger", result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill");
            if (result.Success) { CloseDialogs(); await LoadDatabases(); }
            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowMessage($"Unable to delete database: {exception.Message}", "alert-danger", "bi-x-octagon-fill"); }
        finally { _isSaving = false; }
    }

    private async Task ViewDatabase(string databaseName)
    {
        if (_databaseManager is null) return;
        try
        {
            var result = await _databaseManager.GetDatabaseInformation(new DatabaseOperation.Information { DatabaseName = databaseName });
            if (result.operationResult.Success && result.information is not null)
            {
                _databaseInformation = result.information;
                _showInformationDialog = true;
            }
            else ShowMessage(result.operationResult.Message, "alert-danger", "bi-x-octagon-fill");
        }
        catch (Exception exception) { ShowMessage($"Unable to retrieve database details: {exception.Message}", "alert-danger", "bi-x-octagon-fill"); }
    }

    private void CloseDialogs()
    {
        _showEditDialog = _showDeleteDialog = _showInformationDialog = false;
        _databaseInformation = null;
    }

    private void ShowMessage(string message, string messageClass, string messageIcon) { _message = message; _messageClass = messageClass; _messageIcon = messageIcon; }
    private void ClearMessage() => _message = null;
    private static bool? ParseNullableBoolean(string value) => bool.TryParse(value, out var result) ? result : null;
    private static string FormatValue(object value) => value == DBNull.Value ? "—" : Convert.ToString(value) ?? "—";
}
@using System.Data
@using System.Globalization
@using BprDevKit.Config
@using BprDevKit.DatabaseManagement.Models.Operations
@using BprDevKit.DatabaseManagement.Services
@using BprDevKit.Utility
@using BprDevKit.Localization
@inject DatabaseManagerFactory DatabaseManagerFactory
@inject ITranslationFactory TranslationFactory
@inject IJSRuntime JS

@{
    var t = TranslationFactory.Current;
}

<div class="functions-management">
    <div class="functions-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h5 mb-1"><i class="bi bi-function text-primary me-2"></i>@t[TranslationKeys.Functions]</h2>
            <p class="text-muted small mb-0">@t[TranslationKeys.FuncTabSubtitle]</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="RefreshFunctions" disabled="@(_isLoading || string.IsNullOrWhiteSpace(_selectedDatabase))">
                <i class="bi bi-arrow-clockwise me-1"></i>@t[TranslationKeys.Refresh]
            </button>
            <button class="btn btn-primary btn-sm" type="button" @onclick="OpenCreate" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase) || _isLoading)">
                <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.FuncTabCreateFunc]
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold mb-1" for="func-database-select">@t[TranslationKeys.Databases]</label>
                    <select id="func-database-select" class="form-select form-select-sm" value="@_selectedDatabase" @onchange="OnDatabaseChanged">
                        <option value="">@t[TranslationKeys.SchemaTabSelectDbPrompt]</option>
                        @foreach (var db in _databases)
                        {
                            <option value="@db">@db</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1" for="func-schema-filter">@t[TranslationKeys.Schemas]</label>
                    <select id="func-schema-filter" class="form-select form-select-sm" @bind="_selectedSchemaFilter" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase) || _schemas.Count == 0)">
                        <option value="">@t[TranslationKeys.TableTabAllSchemas]</option>
                        @foreach (var schema in _schemas)
                        {
                            <option value="@schema">@schema</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold mb-1" for="func-search-filter">@t[TranslationKeys.Search]</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input id="func-search-filter" class="form-control border-start-0" placeholder="@t[TranslationKeys.Search]" @bind="_searchFilter" @bind:event="oninput" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase))" />
                        @if (!string.IsNullOrWhiteSpace(_searchFilter))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => _searchFilter = string.Empty"><i class="bi bi-x"></i></button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <BprAlert Message="@_bprMessage" OnDismiss="ClearMessage" CssClass="mb-4" />

    @if (string.IsNullOrWhiteSpace(_selectedDatabase))
    {
        <div class="text-center text-muted py-5 border rounded bg-light">
            <i class="bi bi-database display-6 d-block mb-2 text-secondary"></i>
            <p class="mb-0">@t[TranslationKeys.FuncTabSelectDbToManage]</p>
        </div>
    }
    else if (_isLoading)
    {
        <div class="text-center text-muted py-5">
            <span class="spinner-border text-primary me-2"></span>
            <span>@t[TranslationKeys.FuncTabLoadingFuncs]</span>
        </div>
    }
    else if (_functions.Count == 0)
    {
        <div class="text-center text-muted py-5 border rounded bg-light">
            <i class="bi bi-slash-circle display-6 d-block mb-2 text-secondary"></i>
            <p class="mb-0">@t[TranslationKeys.FuncTabNoFuncsFound]</p>
        </div>
    }
    else if (FilteredFunctions.Count == 0)
    {
        <div class="text-center text-muted py-4 border rounded bg-light">
            <p class="mb-0">@t[TranslationKeys.FuncTabNoMatchFilter]</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 3.5rem;">#</th>
                            <th style="width: 12rem;">@t[TranslationKeys.SchemaName]</th>
                            <th>@t[TranslationKeys.Name]</th>
                            <th style="width: 12rem;">@t[TranslationKeys.Created]</th>
                            <th style="width: 12rem;">@t[TranslationKeys.LastModified]</th>
                            <th style="width: 8rem;" class="text-end">@t[TranslationKeys.Actions]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var index = 1; }
                        @foreach (var func in FilteredFunctions)
                        {
                            <tr>
                                <td class="text-muted small">@(index++)</td>
                                <td>
                                    <span class="badge text-bg-light border font-monospace">@func.SchemaName</span>
                                </td>
                                <td>
                                    <strong class="font-monospace text-primary">@func.FunctionName</strong>
                                    @if (func.IsEncrypted)
                                    {
                                        <span class="badge text-bg-warning ms-2" title="@t[TranslationKeys.CommonEncrypted]">
                                            <i class="bi bi-lock-fill me-1"></i>@t[TranslationKeys.CommonEncrypted]
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(func.FunctionType))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border ms-1" title="@t[TranslationKeys.CommonType]">@func.FunctionType</span>
                                    }
                                </td>
                                <td class="text-muted small">@FormatDate(func.CreateDate)</td>
                                <td class="text-muted small">@FormatDate(func.ModifyDate)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" type="button" title="@t[TranslationKeys.FuncTabBody]" @onclick="() => OpenFunctionDefinition(func)" disabled="@_isSaving">
                                            <i class="bi bi-code-slash"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" type="button" title="@t[TranslationKeys.Delete]" @onclick="() => OpenDrop(func)" disabled="@_isSaving">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_showCreateModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-plus-circle me-2 text-primary"></i>@t[TranslationKeys.FuncTabCreateFunc]</h5>
                        <button type="button" class="btn-close" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        <BprAlert Message="@_modalBprMessage" OnDismiss="() => _modalBprMessage = null" CssClass="py-2 px-3 mb-3 small" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-func-schema">@t[TranslationKeys.SchemaName]</label>
                                <select id="new-func-schema" class="form-select form-select-sm" @bind="_createModel.SchemaName">
                                    @foreach (var schema in _schemas)
                                    {
                                        <option value="@schema">@schema</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-func-name">@t[TranslationKeys.Name]</label>
                                <input id="new-func-name" class="form-control form-control-sm font-monospace" maxlength="@(ServerConfig?.Database?.MaxTableNameLength ?? Constants.MaxTableNameLength)" placeholder="fn_MyFunction" @bind="_createModel.FunctionName" />
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input id="new-func-encryption" class="form-check-input" type="checkbox" @bind="_createModel.WithEncryption" />
                                    <label class="form-check-label small" for="new-func-encryption">@t[TranslationKeys.FuncTabWithEncryption]</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold" for="new-func-body">@t[TranslationKeys.FuncTabBody]</label>
                                <textarea id="new-func-body" class="form-control font-monospace" rows="12" placeholder="(@@param1 INT)&#10;RETURNS INT&#10;AS&#10;BEGIN&#10;    RETURN @@param1 * 2;&#10;END" @bind="_createModel.Body"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Cancel]</button>
                        <button type="button" class="btn btn-sm btn-success" @onclick="ExecuteCreateFunction" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_createModel.FunctionName) || string.IsNullOrWhiteSpace(_createModel.Body))">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @t[TranslationKeys.Create]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showDefinitionModal && _selectedFunction is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog @(_isFullScreen ? "modal-fullscreen" : "modal-lg") modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header d-flex align-items-center justify-content-between flex-row" style="direction: ltr !important;">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title font-monospace mb-0" style="direction: ltr; text-align: left;"><i class="bi bi-function me-2 text-primary"></i>@($"{_selectedFunction.SchemaName}.{_selectedFunction.FunctionName}")</h5>
                            @if (_selectedFunction.IsEncrypted)
                            {
                                if (_isDecrypted)
                                {
                                    <span class="badge text-bg-success"><i class="bi bi-unlock-fill me-1"></i>@t[TranslationKeys.CommonDecrypted]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning"><i class="bi bi-lock-fill me-1"></i>@t[TranslationKeys.CommonEncrypted]</span>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedFunction.FunctionType))
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border">@_selectedFunction.FunctionType</span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2 ms-auto" style="direction: ltr;">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 d-inline-flex align-items-center justify-content-center"
                                    @onclick="ToggleFullScreen"
                                    title="@t[_isFullScreen ? TranslationKeys.CommonExitFullScreen : TranslationKeys.CommonFullScreen]"
                                    style="min-width: 2rem; height: 1.85rem;">
                                @if (_isFullScreen)
                                {
                                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M3 0a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h1v-1H3a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1h1V2a2 2 0 0 0-2-2z"/>
                                        <path d="M5 4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-1 2a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M1.5 1a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-13a.5.5 0 0 0-.5-.5zM2 2h12v12H2z"/>
                                    </svg>
                                }
                            </button>
                            <button type="button" class="btn-close m-0" @onclick="CloseModals" aria-label="@t[TranslationKeys.Close]"></button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <BprAlert Message="@_modalBprMessage" OnDismiss="() => _modalBprMessage = null" CssClass="py-2 px-3 mb-3 small" />


                        @if (_isLoadingDefinition)
                        {
                            <div class="text-center py-4">
                                <span class="spinner-border spinner-border-sm text-primary me-2"></span>
                                <span class="text-muted small">@t[TranslationKeys.Loading]</span>
                            </div>
                        }
                        else
                        {
                            @if (_selectedFunction.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition))
                            {
                                <div class="alert alert-warning border-warning-subtle shadow-sm mb-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <i class="bi bi-shield-lock-fill text-warning fs-3 mt-1"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="alert-heading fw-bold mb-1">@t[TranslationKeys.CommonEncrypted]</h6>
                                            <p class="small mb-3">@t[TranslationKeys.CommonEncryptedNotice]</p>

                                            @if (_isDacRequired)
                                            {
                                                <div class="alert alert-info py-2 px-3 small border-0 mb-3">
                                                    <i class="bi bi-info-circle-fill me-2"></i>@t[TranslationKeys.CommonDacRequiredPrompt]
                                                    <div class="mt-2">
                                                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="ExecuteEnableRemoteDac" disabled="@_isEnablingDac">
                                                            @if (_isEnablingDac)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                                <span>@t[TranslationKeys.CommonEnablingRemoteDac]</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-shield-check me-1"></i>
                                                                <span>@t[TranslationKeys.CommonEnableRemoteDac]</span>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            <div>
                                                <button class="btn btn-warning btn-sm fw-semibold shadow-sm" type="button" @onclick="ExecuteDecryptFunction" disabled="@_isDecrypting">
                                                    @if (_isDecrypting)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                        <span>@t[TranslationKeys.CommonDecrypting]</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-unlock-fill me-1"></i>
                                                        <span>@t[TranslationKeys.CommonDecryptObject]</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">@t[TranslationKeys.FuncTabBody]</label>
                                <textarea class="form-control font-monospace" rows="@(_isFullScreen ? 26 : 14)" @bind="_editDefinition" @bind:event="oninput"></textarea>
                            </div>
                        }
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(_editDefinition))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyDefinitionToClipboard" title="@t[TranslationKeys.CommonCopy]">
                                    @if (_isCopied)
                                    {
                                        <i class="bi bi-check-lg text-success me-1"></i>
                                        <span class="text-success small fw-semibold">@t[TranslationKeys.CommonCopied]</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-clipboard me-1"></i>
                                        <span>@t[TranslationKeys.CommonCopy]</span>
                                    }
                                </button>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Close]</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ExecuteAlterFunction" disabled="@(_isSaving || _isLoadingDefinition || string.IsNullOrWhiteSpace(_editDefinition) || (_selectedFunction.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition)))">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @t[TranslationKeys.Save]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showDropModal && _selectedFunction is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content border-danger">
                    <div class="modal-header bg-danger text-white py-2">
                        <h5 class="modal-title h6 mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>@t.Get(TranslationKeys.FuncTabDropTitle, _selectedFunction.FunctionName)</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">@t.Get(TranslationKeys.FuncTabDropConfirm, $"{_selectedFunction.SchemaName}.{_selectedFunction.FunctionName}")</p>
                    </div>
                    <div class="modal-footer py-2">
                        <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Cancel]</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="ExecuteDropFunction" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @t[TranslationKeys.Delete]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ServerConfiguration? ServerConfig { get; set; }
    [Parameter] public EventCallback<string> OnOperationComplete { get; set; }

    private ITranslator t => TranslationFactory.Current;
    private DatabaseManager? _manager;
    private List<string> _databases = new();
    private List<string> _schemas = new();
    private List<FunctionOperation.Information> _functions = new();
    private string _selectedDatabase = string.Empty;
    private string _selectedSchemaFilter = string.Empty;
    private string _searchFilter = string.Empty;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isLoadingDefinition;
    private bool _isDecrypting;
    private bool _isDecrypted;
    private bool _isDacRequired;
    private bool _isEnablingDac;
    private BprMessage? _bprMessage;
    private BprMessage? _modalBprMessage;

    private bool _showCreateModal;
    private bool _showDefinitionModal;
    private bool _showDropModal;
    private FunctionOperation.Information? _selectedFunction;
    private FunctionOperation.Create _createModel = new();
    private string _editDefinition = string.Empty;
    private bool _isCopied;
    private bool _isFullScreen;

    private List<FunctionOperation.Information> FilteredFunctions => _functions
        .Where(f => string.IsNullOrWhiteSpace(_selectedSchemaFilter) || string.Equals(f.SchemaName, _selectedSchemaFilter, StringComparison.OrdinalIgnoreCase))
        .Where(f => string.IsNullOrWhiteSpace(_searchFilter) || f.FunctionName.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (ServerConfig is not null)
        {
            _manager = DatabaseManagerFactory.Create(ServerConfig);
            await LoadDatabases();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ServerConfig is not null)
        {
            _manager = DatabaseManagerFactory.Create(ServerConfig);
            if (_databases.Count == 0)
            {
                await LoadDatabases();
            }
        }
    }

    private async Task LoadDatabases()
    {
        if (_manager is null) return;
        _isLoading = true;
        try
        {
            var result = await _manager.GetDatabases();
            if (result.operationResult.Success)
            {
                _databases = result.databases;
                _selectedDatabase = string.Empty;
            }
            else
            {
                ShowMessage(result.operationResult);
            }
        }
        catch (Exception ex)
        {
            _bprMessage = BprMessage.Error(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnDatabaseChanged(ChangeEventArgs e)
    {
        _selectedDatabase = e.Value?.ToString() ?? string.Empty;
        _selectedSchemaFilter = string.Empty;
        _searchFilter = string.Empty;
        ClearMessage();
        if (!string.IsNullOrWhiteSpace(_selectedDatabase))
        {
            await LoadSchemasAndFunctions();
        }
    }

    private async Task LoadSchemasAndFunctions()
    {
        if (_manager is null || string.IsNullOrWhiteSpace(_selectedDatabase)) return;
        _isLoading = true;
        try
        {
            var schemasTask = _manager.GetSchemas(_selectedDatabase);
            var funcsTask = _manager.GetFunctions(_selectedDatabase);
            await Task.WhenAll(schemasTask, funcsTask);

            var schemaRes = await schemasTask;
            if (schemaRes.operationResult.Success)
                _schemas = schemaRes.schemas;

            var funcsRes = await funcsTask;
            if (funcsRes.operationResult.Success)
                _functions = funcsRes.functions;
            else
                ShowMessage(funcsRes.operationResult);
        }
        catch (Exception ex)
        {
            _bprMessage = BprMessage.Error(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshFunctions() => await LoadSchemasAndFunctions();

    private void OpenCreate()
    {
        _createModel = new FunctionOperation.Create
        {
            DatabaseName = _selectedDatabase,
            SchemaName = _schemas.FirstOrDefault() ?? "dbo",
            FunctionName = string.Empty,
            Body = "(@param1 INT)\nRETURNS INT\nAS\nBEGIN\n    RETURN @param1 * 2;\nEND",
            WithEncryption = false
        };
        _modalBprMessage = null;
        _showCreateModal = true;
    }

    private async Task ExecuteCreateFunction()
    {
        if (_manager is null) return;
        _isSaving = true;
        try
        {
            _createModel.DatabaseName = _selectedDatabase;
            var result = await _manager.CreateFunction(_createModel);
            if (result.Success)
            {
                ShowMessage(result);
                CloseModals();
                await LoadSchemasAndFunctions();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
            else
            {
                _modalBprMessage = result;
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task OpenFunctionDefinition(FunctionOperation.Information func)
    {
        if (_manager is null) return;
        _selectedFunction = func;
        _isLoadingDefinition = true;
        _showDefinitionModal = true;
        _editDefinition = string.Empty;
        _isDecrypted = false;
        _modalBprMessage = null;
        _isCopied = false;

        try
        {
            var info = await _manager.GetFunctionInformation(_selectedDatabase, func.SchemaName, func.FunctionName);
            if (info.operationResult.Success && info.function is not null)
            {
                _selectedFunction = info.function;
                _editDefinition = info.function.Definition;
            }
            else
            {
                ShowMessage(info.operationResult);
            }
        }
        finally
        {
            _isLoadingDefinition = false;
        }
    }

    private async Task ExecuteDecryptFunction()
    {
        if (_manager is null || _selectedFunction is null) return;
        _isDecrypting = true;
        _isDacRequired = false;
        _modalBprMessage = null;
        try
        {
            var result = await _manager.DecryptFunction(_selectedDatabase, _selectedFunction.SchemaName, _selectedFunction.FunctionName, _selectedFunction.FunctionType);
            if (result.Success && !string.IsNullOrWhiteSpace(result.DecryptedDefinition))
            {
                _editDefinition = result.DecryptedDefinition;
                _isDecrypted = true;
                _isDacRequired = false;
                _modalBprMessage = BprMessage.Success(t[TranslationKeys.CommonDecryptedSuccess]);
                ShowMessage(_modalBprMessage);
            }
            else
            {
                if (result.IsDacRequired)
                {
                    _isDacRequired = true;
                }
                _modalBprMessage = BprMessage.Error(t.Get(TranslationKeys.CommonDecryptionFailed, result.Message));
                ShowMessage(_modalBprMessage);
            }
        }
        finally
        {
            _isDecrypting = false;
        }
    }

    private async Task ExecuteEnableRemoteDac()
    {
        if (_manager is null) return;
        _isEnablingDac = true;
        _modalBprMessage = null;
        try
        {
            var result = await _manager.EnableRemoteDac();
            if (result.Success)
            {
                _isDacRequired = false;
                _modalBprMessage = BprMessage.Success(t[TranslationKeys.CommonRemoteDacEnabled]);
                ShowMessage(_modalBprMessage);
            }
            else
            {
                _modalBprMessage = result;
                ShowMessage(result);
            }
        }
        finally
        {
            _isEnablingDac = false;
        }
    }

    private async Task ExecuteAlterFunction()
    {
        if (_manager is null || _selectedFunction is null) return;
        _isSaving = true;
        try
        {
            var alter = new FunctionOperation.Alter
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _selectedFunction.SchemaName,
                FunctionName = _selectedFunction.FunctionName,
                Body = _editDefinition,
                WithEncryption = _selectedFunction.WithEncryption
            };
            var result = await _manager.AlterFunction(alter);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndFunctions();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDrop(FunctionOperation.Information func)
    {
        _selectedFunction = func;
        _showDropModal = true;
    }

    private async Task ExecuteDropFunction()
    {
        if (_manager is null || _selectedFunction is null) return;
        _isSaving = true;
        try
        {
            var drop = new FunctionOperation.Drop
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _selectedFunction.SchemaName,
                FunctionName = _selectedFunction.FunctionName
            };
            var result = await _manager.DropFunction(drop);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndFunctions();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseModals()
    {
        _showCreateModal = false;
        _showDefinitionModal = false;
        _showDropModal = false;
        _selectedFunction = null;
        _isDecrypted = false;
        _isDacRequired = false;
        _modalBprMessage = null;
        _isCopied = false;
        _isFullScreen = false;
    }

    private void ToggleFullScreen() => _isFullScreen = !_isFullScreen;

    private async Task CopyDefinitionToClipboard()
    {
        if (string.IsNullOrWhiteSpace(_editDefinition)) return;
        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", _editDefinition);
            _isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Ignore clipboard errors
        }
    }

    private void ShowMessage(OperationResult result) => _bprMessage = result;
    private void ShowMessage(BprMessage? message) => _bprMessage = message;
    private void ClearMessage() => _bprMessage = null;

    private static string FormatDate(DateTime date) =>
        date == DateTime.MinValue ? "—" : date.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}
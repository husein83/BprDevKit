@using System.Globalization
@using BprDevKit.Utility
@using BprDevKit.DatabaseManagement.Models.Operations
@using BprDevKit.DatabaseManagement.Services
@inject ITranslationFactory TranslationFactory

@{
    var t = TranslationFactory.Current;
}

<dl class="row small mb-3">
    <dt class="col-sm-3 text-muted fw-normal">@t[TranslationKeys.Created]</dt>
    <dd class="col-sm-9">@FormatDate(Table.CreateDate)</dd>
    <dt class="col-sm-3 text-muted fw-normal">@t[TranslationKeys.LastModified]</dt>
    <dd class="col-sm-9">@FormatDate(Table.ModifyDate)</dd>
    <dt class="col-sm-3 text-muted fw-normal">@t[TranslationKeys.TableTabFileGroup]</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Table.FileGroup) ? "—" : Table.FileGroup)</dd>
    <dt class="col-sm-3 text-muted fw-normal">@t[TranslationKeys.Description]</dt>
    <dd class="col-sm-9 mb-0">@(string.IsNullOrWhiteSpace(Table.Description) ? "—" : Table.Description)</dd>
</dl>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(_activeTab == DetailsTab.Columns ? "active" : string.Empty)" type="button" @onclick="() => _activeTab = DetailsTab.Columns">
            @t[TranslationKeys.Columns] <span class="badge text-bg-light border">@Table.Columns.Count</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_activeTab == DetailsTab.Indexes ? "active" : string.Empty)" type="button" @onclick="() => _activeTab = DetailsTab.Indexes">
            @t[TranslationKeys.Indexes] <span class="badge text-bg-light border">@Table.Indexes.Count</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_activeTab == DetailsTab.ForeignKeys ? "active" : string.Empty)" type="button" @onclick="() => _activeTab = DetailsTab.ForeignKeys">
            @t[TranslationKeys.ForeignKeys] <span class="badge text-bg-light border">@Table.ForeignKeys.Count</span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_activeTab == DetailsTab.CheckConstraints ? "active" : string.Empty)" type="button" @onclick="() => _activeTab = DetailsTab.CheckConstraints">
            @t[TranslationKeys.CheckConstraints] <span class="badge text-bg-light border">@Table.CheckConstraints.Count</span>
        </button>
    </li>
</ul>

@using BprDevKit.Config

@if (_activeTab == DetailsTab.Columns)
{
    <ColumnsPanel Manager="Manager" Table="Table" ServerConfig="ServerConfig" OnChanged="OnChanged" />
}
else if (_activeTab == DetailsTab.Indexes)
{
    <IndexesPanel Manager="Manager" Table="Table" FileGroups="FileGroups" ServerConfig="ServerConfig" OnChanged="OnChanged" />
}
else if (_activeTab == DetailsTab.ForeignKeys)
{
    <ForeignKeysPanel Manager="Manager" Table="Table" Tables="Tables" ServerConfig="ServerConfig" OnChanged="OnChanged" />
}
else
{
    <CheckConstraintsPanel Manager="Manager" Table="Table" ServerConfig="ServerConfig" OnChanged="OnChanged" />
}

@code {
    private enum DetailsTab { Columns, Indexes, ForeignKeys, CheckConstraints }

    [Parameter, EditorRequired] public DatabaseManager Manager { get; set; } = null!;
    [Parameter, EditorRequired] public TableOperation.Information Table { get; set; } = null!;
    [Parameter] public ServerConfiguration? ServerConfig { get; set; }

    /// <summary>All tables of the database (the candidates a foreign key can reference).</summary>
    [Parameter] public IReadOnlyList<TableOperation.Information> Tables { get; set; } = Array.Empty<TableOperation.Information>();

    [Parameter] public IReadOnlyList<string> FileGroups { get; set; } = Array.Empty<string>();

    /// <summary>Raised after a column, index or foreign key was changed successfully.</summary>
    [Parameter] public EventCallback<OperationResult> OnChanged { get; set; }

    private DetailsTab _activeTab = DetailsTab.Columns;

    private static string FormatDate(DateTime value) => value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}

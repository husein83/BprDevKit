@using System.Globalization
@using BprDevKit.DatabaseManagement.Models.Operations
@inject ITranslationFactory TranslationFactory

@{
    var t = TranslationFactory.Current;
}

@if (Schema is null || Schema.Objects.Count == 0)
{
    <p class="text-muted mb-0">@t[TranslationKeys.SchemaObjNoObjects]</p>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var group in Schema.Objects.GroupBy(item => item.ObjectType).OrderBy(group => group.Key))
        {
            <span class="badge text-bg-light border">@FormatType(group.Key) <span class="text-primary">@group.Count()</span></span>
        }
    </div>
    <div class="table-responsive" style="max-height: 20rem;">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>@t[TranslationKeys.Type]</th><th>@t[TranslationKeys.Name]</th><th>@t[TranslationKeys.Created]</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Schema.Objects)
                {
                    <tr>
                        <td class="text-muted small">@FormatType(item.ObjectType)</td>
                        <td class="font-monospace">@item.ObjectName</td>
                        <td class="text-muted small">@(item.CreateDate?.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public SchemaOperation.Information? Schema { get; set; }

    private static string FormatType(string objectType)
    {
        return CultureInfo.InvariantCulture.TextInfo.ToTitleCase(objectType.Replace('_', ' ').ToLowerInvariant());
    }
}

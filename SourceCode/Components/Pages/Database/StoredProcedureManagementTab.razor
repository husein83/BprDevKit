@using System.Data
@using System.Globalization
@using BprDevKit.Config
@using BprDevKit.DatabaseManagement.Models.Operations
@using BprDevKit.DatabaseManagement.Services
@using BprDevKit.Utility
@using BprDevKit.Localization
@inject DatabaseManagerFactory DatabaseManagerFactory
@inject ITranslationFactory TranslationFactory
@inject IJSRuntime JS

@{
    var t = TranslationFactory.Current;
}

<div class="stored-procedures-management">
    <div class="procedures-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h5 mb-1"><i class="bi bi-braces text-primary me-2"></i>@t[TranslationKeys.StoredProcedures]</h2>
            <p class="text-muted small mb-0">@t[TranslationKeys.ProcTabSubtitle]</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="RefreshProcedures" disabled="@(_isLoading || string.IsNullOrWhiteSpace(_selectedDatabase))">
                <i class="bi bi-arrow-clockwise me-1"></i>@t[TranslationKeys.Refresh]
            </button>
            <button class="btn btn-primary btn-sm" type="button" @onclick="OpenCreate" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase) || _isLoading)">
                <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.ProcTabCreateProc]
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold mb-1" for="proc-database-select">@t[TranslationKeys.Databases]</label>
                    <select id="proc-database-select" class="form-select form-select-sm" value="@_selectedDatabase" @onchange="OnDatabaseChanged">
                        <option value="">@t[TranslationKeys.SchemaTabSelectDbPrompt]</option>
                        @foreach (var db in _databases)
                        {
                            <option value="@db">@db</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1" for="proc-schema-filter">@t[TranslationKeys.Schemas]</label>
                    <select id="proc-schema-filter" class="form-select form-select-sm" @bind="_selectedSchemaFilter" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase) || _schemas.Count == 0)">
                        <option value="">@t[TranslationKeys.TableTabAllSchemas]</option>
                        @foreach (var schema in _schemas)
                        {
                            <option value="@schema">@schema</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold mb-1" for="proc-search-filter">@t[TranslationKeys.Search]</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input id="proc-search-filter" class="form-control border-start-0" placeholder="@t[TranslationKeys.Search]" @bind="_searchFilter" @bind:event="oninput" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase))" />
                        @if (!string.IsNullOrWhiteSpace(_searchFilter))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => _searchFilter = string.Empty"><i class="bi bi-x"></i></button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <StatusAlert Message="@_message" Success="@_messageSuccess" OnDismiss="ClearMessage" />

    @if (string.IsNullOrWhiteSpace(_selectedDatabase))
    {
        <div class="text-center text-muted py-5 border rounded bg-light">
            <i class="bi bi-database display-6 d-block mb-2 text-secondary"></i>
            <p class="mb-0">@t[TranslationKeys.ProcTabSelectDbToManage]</p>
        </div>
    }
    else if (_isLoading)
    {
        <div class="text-center text-muted py-5">
            <span class="spinner-border text-primary me-2"></span>
            <span>@t[TranslationKeys.ProcTabLoadingProcs]</span>
        </div>
    }
    else if (_procedures.Count == 0)
    {
        <div class="text-center text-muted py-5 border rounded bg-light">
            <i class="bi bi-braces display-6 d-block mb-2 text-secondary"></i>
            <p class="mb-0">@t[TranslationKeys.ProcTabNoProcsFound]</p>
        </div>
    }
    else if (FilteredProcedures.Count == 0)
    {
        <div class="text-center text-muted py-4 border rounded bg-light">
            <p class="mb-0">@t[TranslationKeys.ProcTabNoMatchFilter]</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 3.5rem;">#</th>
                            <th style="width: 12rem;">@t[TranslationKeys.SchemaName]</th>
                            <th>@t[TranslationKeys.Name]</th>
                            <th style="width: 12rem;">@t[TranslationKeys.Created]</th>
                            <th style="width: 12rem;">@t[TranslationKeys.LastModified]</th>
                            <th style="width: 8rem;" class="text-end">@t[TranslationKeys.Actions]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var index = 1; }
                        @foreach (var proc in FilteredProcedures)
                        {
                            <tr>
                                <td class="text-muted small">@(index++)</td>
                                <td>
                                    <span class="badge text-bg-light border font-monospace">@proc.SchemaName</span>
                                </td>
                                <td>
                                    <strong class="font-monospace text-primary">@proc.ProcedureName</strong>
                                    @if (proc.IsEncrypted)
                                    {
                                        <span class="badge text-bg-warning ms-2" title="@t[TranslationKeys.CommonEncrypted]">
                                            <i class="bi bi-lock-fill me-1"></i>@t[TranslationKeys.CommonEncrypted]
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">@FormatDate(proc.CreateDate)</td>
                                <td class="text-muted small">@FormatDate(proc.ModifyDate)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" type="button" title="@t[TranslationKeys.ProcTabBody]" @onclick="() => OpenProcedureDefinition(proc)" disabled="@_isSaving">
                                            <i class="bi bi-code-slash"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" type="button" title="@t[TranslationKeys.Delete]" @onclick="() => OpenDrop(proc)" disabled="@_isSaving">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_showCreateModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-plus-circle me-2 text-primary"></i>@t[TranslationKeys.ProcTabCreateProc]</h5>
                        <button type="button" class="btn-close" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-proc-schema">@t[TranslationKeys.SchemaName]</label>
                                <select id="new-proc-schema" class="form-select form-select-sm" @bind="_createModel.SchemaName">
                                    @foreach (var schema in _schemas)
                                    {
                                        <option value="@schema">@schema</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-proc-name">@t[TranslationKeys.Name]</label>
                                <input id="new-proc-name" class="form-control form-control-sm font-monospace" maxlength="128" placeholder="sp_MyProcedure" @bind="_createModel.ProcedureName" />
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input id="new-proc-encryption" class="form-check-input" type="checkbox" @bind="_createModel.WithEncryption" />
                                    <label class="form-check-label small" for="new-proc-encryption">@t[TranslationKeys.ProcTabWithEncryption]</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold" for="new-proc-body">@t[TranslationKeys.ProcTabBody]</label>
                                <textarea id="new-proc-body" class="form-control font-monospace" rows="12" placeholder="-- Parameters&#10;@@Id INT = 0&#10;AS&#10;BEGIN&#10;    SET NOCOUNT ON;&#10;    SELECT * FROM dbo.MyTable;&#10;END" @bind="_createModel.Body"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Cancel]</button>
                        <button type="button" class="btn btn-sm btn-success" @onclick="ExecuteCreateProcedure" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_createModel.ProcedureName) || string.IsNullOrWhiteSpace(_createModel.Body))">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @t[TranslationKeys.Create]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showDefinitionModal && _selectedProcedure is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title font-monospace mb-0"><i class="bi bi-braces me-2 text-primary"></i>@($"{_selectedProcedure.SchemaName}.{_selectedProcedure.ProcedureName}")</h5>
                            @if (_selectedProcedure.IsEncrypted)
                            {
                                if (_isDecrypted)
                                {
                                    <span class="badge text-bg-success"><i class="bi bi-unlock-fill me-1"></i>@t[TranslationKeys.CommonDecrypted]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning"><i class="bi bi-lock-fill me-1"></i>@t[TranslationKeys.CommonEncrypted]</span>
                                }
                            }
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(_modalMessage))
                        {
                            <div class="alert @(_modalMessageSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 px-3 mb-3 small" role="alert">
                                <i class="bi @(_modalMessageSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") me-2"></i>
                                <span>@_modalMessage</span>
                                <button type="button" class="btn-close py-2" @onclick="() => _modalMessage = null"></button>
                            </div>
                        }

                        @if (_isLoadingDefinition)
                        {
                            <div class="text-center py-4">
                                <span class="spinner-border spinner-border-sm text-primary me-2"></span>
                                <span class="text-muted small">@t[TranslationKeys.Loading]</span>
                            </div>
                        }
                        else
                        {
                            @if (_selectedProcedure.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition))
                            {
                                <div class="alert alert-warning border-warning-subtle shadow-sm mb-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <i class="bi bi-shield-lock-fill text-warning fs-3 mt-1"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="alert-heading fw-bold mb-1">@t[TranslationKeys.CommonEncrypted]</h6>
                                            <p class="small mb-3">@t[TranslationKeys.CommonEncryptedNotice]</p>

                                            @if (_isDacRequired)
                                            {
                                                <div class="alert alert-info py-2 px-3 small border-0 mb-3">
                                                    <i class="bi bi-info-circle-fill me-2"></i>@t[TranslationKeys.CommonDacRequiredPrompt]
                                                    <div class="mt-2">
                                                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="ExecuteEnableRemoteDac" disabled="@_isEnablingDac">
                                                            @if (_isEnablingDac)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                                <span>@t[TranslationKeys.CommonEnablingRemoteDac]</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-shield-check me-1"></i>
                                                                <span>@t[TranslationKeys.CommonEnableRemoteDac]</span>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            <div>
                                                <button class="btn btn-warning btn-sm fw-semibold shadow-sm" type="button" @onclick="ExecuteDecryptProcedure" disabled="@_isDecrypting">
                                                    @if (_isDecrypting)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                        <span>@t[TranslationKeys.CommonDecrypting]</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-unlock-fill me-1"></i>
                                                        <span>@t[TranslationKeys.CommonDecryptObject]</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">@t[TranslationKeys.ProcTabBody]</label>
                                <textarea class="form-control font-monospace" rows="14" @bind="_editDefinition" @bind:event="oninput"></textarea>
                            </div>
                        }
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(_editDefinition))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyDefinitionToClipboard" title="@t[TranslationKeys.CommonCopy]">
                                    @if (_isCopied)
                                    {
                                        <i class="bi bi-check-lg text-success me-1"></i>
                                        <span class="text-success small fw-semibold">@t[TranslationKeys.CommonCopied]</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-clipboard me-1"></i>
                                        <span>@t[TranslationKeys.CommonCopy]</span>
                                    }
                                </button>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Close]</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ExecuteAlterProcedure" disabled="@(_isSaving || _isLoadingDefinition || string.IsNullOrWhiteSpace(_editDefinition) || (_selectedProcedure.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition)))">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @t[TranslationKeys.Save]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showDropModal && _selectedProcedure is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content border-danger">
                    <div class="modal-header bg-danger text-white py-2">
                        <h5 class="modal-title h6 mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>@t.Get(TranslationKeys.ProcTabDropTitle, _selectedProcedure.ProcedureName)</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">@t.Get(TranslationKeys.ProcTabDropConfirm, $"{_selectedProcedure.SchemaName}.{_selectedProcedure.ProcedureName}")</p>
                    </div>
                    <div class="modal-footer py-2">
                        <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Cancel]</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="ExecuteDropProcedure" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @t[TranslationKeys.Delete]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ServerConfiguration? ServerConfig { get; set; }
    [Parameter] public EventCallback<string> OnOperationComplete { get; set; }

    private ITranslator t => TranslationFactory.Current;
    private DatabaseManager? _manager;
    private List<string> _databases = new();
    private List<string> _schemas = new();
    private List<StoredProcedureOperation.Information> _procedures = new();
    private string _selectedDatabase = string.Empty;
    private string _selectedSchemaFilter = string.Empty;
    private string _searchFilter = string.Empty;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isLoadingDefinition;
    private bool _isDecrypting;
    private bool _isDecrypted;
    private bool _isDacRequired;
    private bool _isEnablingDac;
    private string? _message;
    private bool _messageSuccess;
    private string? _modalMessage;
    private bool _modalMessageSuccess;

    private bool _showCreateModal;
    private bool _showDefinitionModal;
    private bool _showDropModal;
    private StoredProcedureOperation.Information? _selectedProcedure;
    private StoredProcedureOperation.Create _createModel = new();
    private string _editDefinition = string.Empty;
    private bool _isCopied;

    private List<StoredProcedureOperation.Information> FilteredProcedures => _procedures
        .Where(p => string.IsNullOrWhiteSpace(_selectedSchemaFilter) || string.Equals(p.SchemaName, _selectedSchemaFilter, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrWhiteSpace(_searchFilter) || p.ProcedureName.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (ServerConfig is not null)
        {
            _manager = DatabaseManagerFactory.Create(ServerConfig);
            await LoadDatabases();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ServerConfig is not null)
        {
            _manager = DatabaseManagerFactory.Create(ServerConfig);
            if (_databases.Count == 0)
            {
                await LoadDatabases();
            }
        }
    }

    private async Task LoadDatabases()
    {
        if (_manager is null) return;
        _isLoading = true;
        try
        {
            var result = await _manager.GetDatabases();
            if (result.operationResult.Success)
            {
                _databases = result.databases;
                _selectedDatabase = string.Empty;
            }
            else
            {
                ShowMessage(result.operationResult);
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnDatabaseChanged(ChangeEventArgs e)
    {
        _selectedDatabase = e.Value?.ToString() ?? string.Empty;
        _selectedSchemaFilter = string.Empty;
        _searchFilter = string.Empty;
        ClearMessage();
        if (!string.IsNullOrWhiteSpace(_selectedDatabase))
        {
            await LoadSchemasAndProcedures();
        }
    }

    private async Task LoadSchemasAndProcedures()
    {
        if (_manager is null || string.IsNullOrWhiteSpace(_selectedDatabase)) return;
        _isLoading = true;
        try
        {
            var schemasTask = _manager.GetSchemas(_selectedDatabase);
            var procsTask = _manager.GetProcedures(_selectedDatabase);
            await Task.WhenAll(schemasTask, procsTask);

            var schemaRes = await schemasTask;
            if (schemaRes.operationResult.Success)
                _schemas = schemaRes.schemas;

            var procsRes = await procsTask;
            if (procsRes.operationResult.Success)
                _procedures = procsRes.procedures;
            else
                ShowMessage(procsRes.operationResult);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshProcedures() => await LoadSchemasAndProcedures();

    private void OpenCreate()
    {
        _createModel = new StoredProcedureOperation.Create
        {
            DatabaseName = _selectedDatabase,
            SchemaName = _schemas.FirstOrDefault() ?? "dbo",
            ProcedureName = string.Empty,
            Body = "AS\nBEGIN\n    SET NOCOUNT ON;\n    -- Procedure logic here\nEND",
            WithEncryption = false
        };
        _showCreateModal = true;
    }

    private async Task ExecuteCreateProcedure()
    {
        if (_manager is null) return;
        _isSaving = true;
        try
        {
            _createModel.DatabaseName = _selectedDatabase;
            var result = await _manager.CreateProcedure(_createModel);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndProcedures();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task OpenProcedureDefinition(StoredProcedureOperation.Information proc)
    {
        if (_manager is null) return;
        _selectedProcedure = proc;
        _isLoadingDefinition = true;
        _showDefinitionModal = true;
        _editDefinition = string.Empty;
        _isDecrypted = false;
        _isDacRequired = false;
        _modalMessage = null;
        _isCopied = false;

        try
        {
            var info = await _manager.GetProcedureInformation(_selectedDatabase, proc.SchemaName, proc.ProcedureName);
            if (info.operationResult.Success && info.procedure is not null)
            {
                _selectedProcedure = info.procedure;
                _editDefinition = info.procedure.Definition;
            }
            else
            {
                ShowMessage(info.operationResult);
            }
        }
        finally
        {
            _isLoadingDefinition = false;
        }
    }

    private async Task ExecuteDecryptProcedure()
    {
        if (_manager is null || _selectedProcedure is null) return;
        _isDecrypting = true;
        _isDacRequired = false;
        _modalMessage = null;
        try
        {
            var result = await _manager.DecryptProcedure(_selectedDatabase, _selectedProcedure.SchemaName, _selectedProcedure.ProcedureName);
            if (result.Success && !string.IsNullOrWhiteSpace(result.DecryptedDefinition))
            {
                _editDefinition = result.DecryptedDefinition;
                _isDecrypted = true;
                _isDacRequired = false;
                _modalMessage = t[TranslationKeys.CommonDecryptedSuccess];
                _modalMessageSuccess = true;
                ShowMessage(OperationResult.SuccessResult(t[TranslationKeys.CommonDecryptedSuccess]));
            }
            else
            {
                if (result.IsDacRequired)
                {
                    _isDacRequired = true;
                }
                _modalMessage = t.Get(TranslationKeys.CommonDecryptionFailed, result.Message);
                _modalMessageSuccess = false;
                ShowMessage(OperationResult.ErrorResult(t.Get(TranslationKeys.CommonDecryptionFailed, result.Message)));
            }
        }
        finally
        {
            _isDecrypting = false;
        }
    }

    private async Task ExecuteEnableRemoteDac()
    {
        if (_manager is null) return;
        _isEnablingDac = true;
        _modalMessage = null;
        try
        {
            var result = await _manager.EnableRemoteDac();
            if (result.Success)
            {
                _isDacRequired = false;
                _modalMessage = t[TranslationKeys.CommonRemoteDacEnabled];
                _modalMessageSuccess = true;
                ShowMessage(OperationResult.SuccessResult(t[TranslationKeys.CommonRemoteDacEnabled]));
            }
            else
            {
                _modalMessage = result.Message;
                _modalMessageSuccess = false;
                ShowMessage(result);
            }
        }
        finally
        {
            _isEnablingDac = false;
        }
    }

    private async Task ExecuteAlterProcedure()
    {
        if (_manager is null || _selectedProcedure is null) return;
        _isSaving = true;
        try
        {
            var alter = new StoredProcedureOperation.Alter
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _selectedProcedure.SchemaName,
                ProcedureName = _selectedProcedure.ProcedureName,
                Body = _editDefinition,
                WithEncryption = _selectedProcedure.WithEncryption
            };
            var result = await _manager.AlterProcedure(alter);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndProcedures();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDrop(StoredProcedureOperation.Information proc)
    {
        _selectedProcedure = proc;
        _showDropModal = true;
    }

    private async Task ExecuteDropProcedure()
    {
        if (_manager is null || _selectedProcedure is null) return;
        _isSaving = true;
        try
        {
            var drop = new StoredProcedureOperation.Drop
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _selectedProcedure.SchemaName,
                ProcedureName = _selectedProcedure.ProcedureName
            };
            var result = await _manager.DropProcedure(drop);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndProcedures();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseModals()
    {
        _showCreateModal = false;
        _showDefinitionModal = false;
        _showDropModal = false;
        _selectedProcedure = null;
        _isDecrypted = false;
        _isDacRequired = false;
        _modalMessage = null;
        _isCopied = false;
    }

    private async Task CopyDefinitionToClipboard()
    {
        if (string.IsNullOrWhiteSpace(_editDefinition)) return;
        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", _editDefinition);
            _isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Ignore clipboard errors
        }
    }

    private void ShowMessage(OperationResult result)
    {
        _message = result.Message;
        _messageSuccess = result.Success;
    }

    private void ClearMessage() => _message = null;

    private static string FormatDate(DateTime date) =>
        date == DateTime.MinValue ? "—" : date.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}
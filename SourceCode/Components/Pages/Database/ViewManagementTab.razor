@using System.Data
@using System.Globalization
@using BprDevKit.Config
@using BprDevKit.DatabaseManagement.Models.Operations
@using BprDevKit.DatabaseManagement.Services
@using BprDevKit.Utility
@using BprDevKit.Localization
@inject DatabaseManagerFactory DatabaseManagerFactory
@inject ITranslationFactory TranslationFactory
@inject IJSRuntime JS

@{
    var t = TranslationFactory.Current;
}

<div class="views-management">
    <div class="views-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h5 mb-1"><i class="bi bi-eye text-primary me-2"></i>@t[TranslationKeys.Views]</h2>
            <p class="text-muted small mb-0">@t[TranslationKeys.ViewTabSubtitle]</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="RefreshViews" disabled="@(_isLoading || string.IsNullOrWhiteSpace(_selectedDatabase))">
                <i class="bi bi-arrow-clockwise me-1"></i>@t[TranslationKeys.Refresh]
            </button>
            <button class="btn btn-primary btn-sm" type="button" @onclick="OpenCreate" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase) || _isLoading)">
                <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.ViewTabCreateView]
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold mb-1" for="view-database-select">@t[TranslationKeys.Databases]</label>
                    <select id="view-database-select" class="form-select form-select-sm" value="@_selectedDatabase" @onchange="OnDatabaseChanged">
                        <option value="">@t[TranslationKeys.SchemaTabSelectDbPrompt]</option>
                        @foreach (var db in _databases)
                        {
                            <option value="@db">@db</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1" for="view-schema-filter">@t[TranslationKeys.Schemas]</label>
                    <select id="view-schema-filter" class="form-select form-select-sm" @bind="_selectedSchemaFilter" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase) || _schemas.Count == 0)">
                        <option value="">@t[TranslationKeys.TableTabAllSchemas]</option>
                        @foreach (var schema in _schemas)
                        {
                            <option value="@schema">@schema</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold mb-1" for="view-search-filter">@t[TranslationKeys.Search]</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input id="view-search-filter" class="form-control border-start-0" placeholder="@t[TranslationKeys.Search]" @bind="_searchFilter" @bind:event="oninput" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase))" />
                        @if (!string.IsNullOrWhiteSpace(_searchFilter))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => _searchFilter = string.Empty"><i class="bi bi-x"></i></button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <StatusAlert Message="@_message" Success="@_messageSuccess" OnDismiss="ClearMessage" />

    @if (string.IsNullOrWhiteSpace(_selectedDatabase))
    {
        <div class="text-center text-muted py-5 border rounded bg-light">
            <i class="bi bi-database display-6 d-block mb-2 text-secondary"></i>
            <p class="mb-0">@t[TranslationKeys.ViewTabSelectDbToManage]</p>
        </div>
    }
    else if (_isLoading)
    {
        <div class="text-center text-muted py-5">
            <span class="spinner-border text-primary me-2"></span>
            <span>@t[TranslationKeys.ViewTabLoadingViews]</span>
        </div>
    }
    else if (_views.Count == 0)
    {
        <div class="text-center text-muted py-5 border rounded bg-light">
            <i class="bi bi-eye-slash display-6 d-block mb-2 text-secondary"></i>
            <p class="mb-0">@t[TranslationKeys.ViewTabNoViewsFound]</p>
        </div>
    }
    else if (FilteredViews.Count == 0)
    {
        <div class="text-center text-muted py-4 border rounded bg-light">
            <p class="mb-0">@t[TranslationKeys.ViewTabNoMatchFilter]</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 3.5rem;">#</th>
                            <th style="width: 12rem;">@t[TranslationKeys.SchemaName]</th>
                            <th>@t[TranslationKeys.Name]</th>
                            <th style="width: 12rem;">@t[TranslationKeys.Created]</th>
                            <th style="width: 12rem;">@t[TranslationKeys.LastModified]</th>
                            <th style="width: 8rem;" class="text-end">@t[TranslationKeys.Actions]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var index = 1; }
                        @foreach (var view in FilteredViews)
                        {
                            <tr>
                                <td class="text-muted small">@(index++)</td>
                                <td>
                                    <span class="badge text-bg-light border font-monospace">@view.SchemaName</span>
                                </td>
                                <td>
                                    <strong class="font-monospace text-primary">@view.ViewName</strong>
                                    @if (view.IsEncrypted)
                                    {
                                        <span class="badge text-bg-warning ms-2" title="@t[TranslationKeys.CommonEncrypted]">
                                            <i class="bi bi-lock-fill me-1"></i>@t[TranslationKeys.CommonEncrypted]
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">@FormatDate(view.CreateDate)</td>
                                <td class="text-muted small">@FormatDate(view.ModifyDate)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" type="button" title="@t[TranslationKeys.ViewTabDefinition]" @onclick="() => OpenViewDefinition(view)" disabled="@_isSaving">
                                            <i class="bi bi-code-slash"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" type="button" title="@t[TranslationKeys.Delete]" @onclick="() => OpenDrop(view)" disabled="@_isSaving">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_showCreateModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-plus-circle me-2 text-primary"></i>@t[TranslationKeys.ViewTabCreateView]</h5>
                        <button type="button" class="btn-close" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-view-schema">@t[TranslationKeys.SchemaName]</label>
                                <select id="new-view-schema" class="form-select form-select-sm" @bind="_createModel.SchemaName">
                                    @foreach (var schema in _schemas)
                                    {
                                        <option value="@schema">@schema</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-view-name">@t[TranslationKeys.Name]</label>
                                <input id="new-view-name" class="form-control form-control-sm font-monospace" maxlength="128" placeholder="vw_MyView" @bind="_createModel.ViewName" />
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input id="new-view-encryption" class="form-check-input" type="checkbox" @bind="_createModel.WithEncryption" />
                                    <label class="form-check-label small" for="new-view-encryption">@t[TranslationKeys.ViewTabWithEncryption]</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-semibold mb-0" for="new-view-sql">@t[TranslationKeys.ViewTabDefinition]</label>
                                    <button class="btn btn-outline-info btn-sm py-0" type="button" @onclick="TestCreateQuery" disabled="@(_isTesting || string.IsNullOrWhiteSpace(_createModel.SelectStatement))">
                                        @if (_isTesting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        <i class="bi bi-play-circle me-1"></i>@t[TranslationKeys.ViewTabTestQuery]
                                    </button>
                                </div>
                                <textarea id="new-view-sql" class="form-control font-monospace" rows="9" placeholder="SELECT Id, Name FROM dbo.MyTable" @bind="_createModel.SelectStatement"></textarea>
                            </div>
                        </div>

                        @if (_testResultTable is not null)
                        {
                            <div class="card border-info mb-3">
                                <div class="card-header bg-info-subtle py-1 fw-semibold small d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-table me-1"></i>@t[TranslationKeys.ViewTabTestResults] (@_testResultTable.Rows.Count rows)</span>
                                    <button class="btn-close btn-sm" type="button" @onclick="() => _testResultTable = null"></button>
                                </div>
                                <div class="card-body p-0 table-responsive" style="max-height: 12rem;">
                                    <table class="table table-sm table-striped mb-0 small">
                                        <thead>
                                            <tr>
                                                @foreach (DataColumn col in _testResultTable.Columns)
                                                {
                                                    <th>@col.ColumnName</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (DataRow row in _testResultTable.Rows.Cast<DataRow>().Take(20))
                                            {
                                                <tr>
                                                    @foreach (DataColumn col in _testResultTable.Columns)
                                                    {
                                                        <td class="font-monospace">@(row[col] is DBNull ? "NULL" : row[col]?.ToString())</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Cancel]</button>
                        <button type="button" class="btn btn-sm btn-success" @onclick="ExecuteCreateView" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_createModel.ViewName) || string.IsNullOrWhiteSpace(_createModel.SelectStatement))">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @t[TranslationKeys.Create]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showDefinitionModal && _selectedView is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title font-monospace mb-0"><i class="bi bi-code-square me-2 text-primary"></i>@($"{_selectedView.SchemaName}.{_selectedView.ViewName}")</h5>
                            @if (_selectedView.IsEncrypted)
                            {
                                if (_isDecrypted)
                                {
                                    <span class="badge text-bg-success"><i class="bi bi-unlock-fill me-1"></i>@t[TranslationKeys.CommonDecrypted]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning"><i class="bi bi-lock-fill me-1"></i>@t[TranslationKeys.CommonEncrypted]</span>
                                }
                            }
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(_modalMessage))
                        {
                            <div class="alert @(_modalMessageSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show py-2 px-3 mb-3 small" role="alert">
                                <i class="bi @(_modalMessageSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") me-2"></i>
                                <span>@_modalMessage</span>
                                <button type="button" class="btn-close py-2" @onclick="() => _modalMessage = null"></button>
                            </div>
                        }

                        @if (_isLoadingDefinition)
                        {
                            <div class="text-center py-4">
                                <span class="spinner-border spinner-border-sm text-primary me-2"></span>
                                <span class="text-muted small">@t[TranslationKeys.Loading]</span>
                            </div>
                        }
                        else
                        {
                            @if (_selectedView.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition))
                            {
                                <div class="alert alert-warning border-warning-subtle shadow-sm mb-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <i class="bi bi-shield-lock-fill text-warning fs-3 mt-1"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="alert-heading fw-bold mb-1">@t[TranslationKeys.CommonEncrypted]</h6>
                                            <p class="small mb-3">@t[TranslationKeys.CommonEncryptedNotice]</p>

                                            @if (_isDacRequired)
                                            {
                                                <div class="alert alert-info py-2 px-3 small border-0 mb-3">
                                                    <i class="bi bi-info-circle-fill me-2"></i>@t[TranslationKeys.CommonDacRequiredPrompt]
                                                    <div class="mt-2">
                                                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="ExecuteEnableRemoteDac" disabled="@_isEnablingDac">
                                                            @if (_isEnablingDac)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                                <span>@t[TranslationKeys.CommonEnablingRemoteDac]</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-shield-check me-1"></i>
                                                                <span>@t[TranslationKeys.CommonEnableRemoteDac]</span>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            <div>
                                                <button class="btn btn-warning btn-sm fw-semibold shadow-sm" type="button" @onclick="ExecuteDecryptView" disabled="@_isDecrypting">
                                                    @if (_isDecrypting)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                        <span>@t[TranslationKeys.CommonDecrypting]</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-unlock-fill me-1"></i>
                                                        <span>@t[TranslationKeys.CommonDecryptObject]</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">@t[TranslationKeys.ViewTabDefinition]</label>
                                <textarea class="form-control font-monospace" rows="14" @bind="_editDefinition" @bind:event="oninput"></textarea>
                            </div>
                        }
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(_editDefinition))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyDefinitionToClipboard" title="@t[TranslationKeys.CommonCopy]">
                                    @if (_isCopied)
                                    {
                                        <i class="bi bi-check-lg text-success me-1"></i>
                                        <span class="text-success small fw-semibold">@t[TranslationKeys.CommonCopied]</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-clipboard me-1"></i>
                                        <span>@t[TranslationKeys.CommonCopy]</span>
                                    }
                                </button>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Close]</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ExecuteAlterView" disabled="@(_isSaving || _isLoadingDefinition || string.IsNullOrWhiteSpace(_editDefinition) || (_selectedView.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition)))">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @t[TranslationKeys.Save]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showDropModal && _selectedView is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content border-danger">
                    <div class="modal-header bg-danger text-white py-2">
                        <h5 class="modal-title h6 mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>@t.Get(TranslationKeys.ViewTabDropTitle, _selectedView.ViewName)</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">@t.Get(TranslationKeys.ViewTabDropConfirm, $"{_selectedView.SchemaName}.{_selectedView.ViewName}")</p>
                    </div>
                    <div class="modal-footer py-2">
                        <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Cancel]</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="ExecuteDropView" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @t[TranslationKeys.Delete]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ServerConfiguration? ServerConfig { get; set; }
    [Parameter] public EventCallback<string> OnOperationComplete { get; set; }

    private ITranslator t => TranslationFactory.Current;
    private DatabaseManager? _manager;
    private List<string> _databases = new();
    private List<string> _schemas = new();
    private List<ViewOperation.Information> _views = new();
    private string _selectedDatabase = string.Empty;
    private string _selectedSchemaFilter = string.Empty;
    private string _searchFilter = string.Empty;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isTesting;
    private bool _isLoadingDefinition;
    private bool _isDecrypting;
    private bool _isDecrypted;
    private bool _isDacRequired;
    private bool _isEnablingDac;
    private string? _message;
    private bool _messageSuccess;
    private string? _modalMessage;
    private bool _modalMessageSuccess;
    private bool _isCopied;

    private bool _showCreateModal;
    private bool _showDefinitionModal;
    private bool _showDropModal;
    private ViewOperation.Information? _selectedView;
    private ViewOperation.Create _createModel = new();
    private string _editDefinition = string.Empty;
    private DataTable? _testResultTable;

    private List<ViewOperation.Information> FilteredViews => _views
        .Where(v => string.IsNullOrWhiteSpace(_selectedSchemaFilter) || string.Equals(v.SchemaName, _selectedSchemaFilter, StringComparison.OrdinalIgnoreCase))
        .Where(v => string.IsNullOrWhiteSpace(_searchFilter) || v.ViewName.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (ServerConfig is not null)
        {
            _manager = DatabaseManagerFactory.Create(ServerConfig);
            await LoadDatabases();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ServerConfig is not null)
        {
            _manager = DatabaseManagerFactory.Create(ServerConfig);
            if (_databases.Count == 0)
            {
                await LoadDatabases();
            }
        }
    }

    private async Task LoadDatabases()
    {
        if (_manager is null) return;
        _isLoading = true;
        try
        {
            var result = await _manager.GetDatabases();
            if (result.operationResult.Success)
            {
                _databases = result.databases;
                _selectedDatabase = string.Empty;
            }
            else
            {
                ShowMessage(result.operationResult);
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnDatabaseChanged(ChangeEventArgs e)
    {
        _selectedDatabase = e.Value?.ToString() ?? string.Empty;
        _selectedSchemaFilter = string.Empty;
        _searchFilter = string.Empty;
        ClearMessage();
        if (!string.IsNullOrWhiteSpace(_selectedDatabase))
        {
            await LoadSchemasAndViews();
        }
    }

    private async Task LoadSchemasAndViews()
    {
        if (_manager is null || string.IsNullOrWhiteSpace(_selectedDatabase)) return;
        _isLoading = true;
        try
        {
            var schemasTask = _manager.GetSchemas(_selectedDatabase);
            var viewsTask = _manager.GetViews(_selectedDatabase);
            await Task.WhenAll(schemasTask, viewsTask);

            var schemaRes = await schemasTask;
            if (schemaRes.operationResult.Success)
                _schemas = schemaRes.schemas;

            var viewsRes = await viewsTask;
            if (viewsRes.operationResult.Success)
                _views = viewsRes.views;
            else
                ShowMessage(viewsRes.operationResult);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshViews() => await LoadSchemasAndViews();

    private void OpenCreate()
    {
        _createModel = new ViewOperation.Create
        {
            DatabaseName = _selectedDatabase,
            SchemaName = _schemas.FirstOrDefault() ?? "dbo",
            ViewName = string.Empty,
            SelectStatement = string.Empty,
            WithEncryption = false
        };
        _testResultTable = null;
        _showCreateModal = true;
    }

    private async Task TestCreateQuery()
    {
        if (_manager is null || string.IsNullOrWhiteSpace(_createModel.SelectStatement)) return;
        _isTesting = true;
        _testResultTable = null;
        try
        {
            var result = await _manager.TestView(_selectedDatabase, _createModel.SelectStatement);
            if (result.operationResult.Success && result.testResult is not null)
            {
                _testResultTable = result.testResult;
            }
            else
            {
                ShowMessage(result.operationResult);
            }
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task ExecuteCreateView()
    {
        if (_manager is null) return;
        _isSaving = true;
        try
        {
            _createModel.DatabaseName = _selectedDatabase;
            var result = await _manager.CreateView(_createModel);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndViews();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task OpenViewDefinition(ViewOperation.Information view)
    {
        if (_manager is null) return;
        _selectedView = view;
        _isLoadingDefinition = true;
        _showDefinitionModal = true;
        _editDefinition = string.Empty;
        _isDecrypted = false;
        _isDacRequired = false;
        _modalMessage = null;
        _isCopied = false;

        try
        {
            var info = await _manager.GetViewInformation(_selectedDatabase, view.SchemaName, view.ViewName);
            if (info.operationResult.Success && info.view is not null)
            {
                _selectedView = info.view;
                _editDefinition = info.view.Definition;
            }
            else
            {
                ShowMessage(info.operationResult);
            }
        }
        finally
        {
            _isLoadingDefinition = false;
        }
    }

    private async Task ExecuteDecryptView()
    {
        if (_manager is null || _selectedView is null) return;
        _isDecrypting = true;
        _isDacRequired = false;
        _modalMessage = null;
        try
        {
            var result = await _manager.DecryptView(_selectedDatabase, _selectedView.SchemaName, _selectedView.ViewName);
            if (result.Success && !string.IsNullOrWhiteSpace(result.DecryptedDefinition))
            {
                _editDefinition = result.DecryptedDefinition;
                _isDecrypted = true;
                _isDacRequired = false;
                _modalMessage = t[TranslationKeys.CommonDecryptedSuccess];
                _modalMessageSuccess = true;
                ShowMessage(OperationResult.SuccessResult(t[TranslationKeys.CommonDecryptedSuccess]));
            }
            else
            {
                if (result.IsDacRequired)
                {
                    _isDacRequired = true;
                }
                _modalMessage = t.Get(TranslationKeys.CommonDecryptionFailed, result.Message);
                _modalMessageSuccess = false;
                ShowMessage(OperationResult.ErrorResult(t.Get(TranslationKeys.CommonDecryptionFailed, result.Message)));
            }
        }
        finally
        {
            _isDecrypting = false;
        }
    }

    private async Task ExecuteEnableRemoteDac()
    {
        if (_manager is null) return;
        _isEnablingDac = true;
        _modalMessage = null;
        try
        {
            var result = await _manager.EnableRemoteDac();
            if (result.Success)
            {
                _isDacRequired = false;
                _modalMessage = t[TranslationKeys.CommonRemoteDacEnabled];
                _modalMessageSuccess = true;
                ShowMessage(OperationResult.SuccessResult(t[TranslationKeys.CommonRemoteDacEnabled]));
            }
            else
            {
                _modalMessage = result.Message;
                _modalMessageSuccess = false;
                ShowMessage(result);
            }
        }
        finally
        {
            _isEnablingDac = false;
        }
    }

    private async Task ExecuteAlterView()
    {
        if (_manager is null || _selectedView is null) return;
        _isSaving = true;
        try
        {
            var alter = new ViewOperation.Alter
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _selectedView.SchemaName,
                ViewName = _selectedView.ViewName,
                SelectStatement = _editDefinition,
                WithEncryption = _selectedView.WithEncryption
            };
            var result = await _manager.AlterView(alter);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndViews();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDrop(ViewOperation.Information view)
    {
        _selectedView = view;
        _showDropModal = true;
    }

    private async Task ExecuteDropView()
    {
        if (_manager is null || _selectedView is null) return;
        _isSaving = true;
        try
        {
            var drop = new ViewOperation.Drop
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _selectedView.SchemaName,
                ViewName = _selectedView.ViewName
            };
            var result = await _manager.DropView(drop);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndViews();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseModals()
    {
        _showCreateModal = false;
        _showDefinitionModal = false;
        _showDropModal = false;
        _selectedView = null;
        _testResultTable = null;
        _isDecrypted = false;
        _isDacRequired = false;
        _modalMessage = null;
        _isCopied = false;
    }

    private async Task CopyDefinitionToClipboard()
    {
        if (string.IsNullOrWhiteSpace(_editDefinition)) return;
        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", _editDefinition);
            _isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Ignore clipboard errors
        }
    }

    private void ShowMessage(OperationResult result)
    {
        _message = result.Message;
        _messageSuccess = result.Success;
    }

    private void ClearMessage() => _message = null;

    private static string FormatDate(DateTime date) =>
        date == DateTime.MinValue ? "—" : date.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}
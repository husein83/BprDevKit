@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert @(Success ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
        <i class="bi @(Success ? "bi-check-circle-fill" : "bi-x-octagon-fill") me-2"></i>@Message
        <button class="btn-close" type="button" @onclick="OnDismiss"></button>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Success { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
}

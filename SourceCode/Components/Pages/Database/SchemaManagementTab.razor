@using BprDevKit.Utility
@using BprDevKit.Config
@using BprDevKit.DatabaseManagement.Models.Metadata
@using BprDevKit.DatabaseManagement.Models.Operations
@using BprDevKit.DatabaseManagement.Services
@inject DatabaseManagerFactory DatabaseManagerFactory
@inject ITranslationFactory TranslationFactory

@{
    var t = TranslationFactory.Current;
}

<div class="schemas-management">
    <div class="schema-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h4 mb-1"><i class="bi bi-diagram-3 text-primary me-2"></i>@t[TranslationKeys.Schemas]</h2>
            <p class="text-muted mb-0">@t[TranslationKeys.SchemaTabSubtitle]</p>
        </div>
        <button class="create-schema-button btn btn-primary" type="button" @onclick="OpenCreateSchema" disabled="@(!HasDatabase || _isSaving)">
            <i class="bi bi-plus-lg me-1"></i> @t[TranslationKeys.SchemaTabCreateSchema]
        </button>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-8 col-lg-6">
                    <label class="form-label fw-semibold" for="schema-database"><i class="bi bi-database me-1 text-primary"></i>@t[TranslationKeys.Database]</label>
                    <select id="schema-database" class="form-select" @bind="_selectedDatabase" @bind:after="OnDatabaseSelected" disabled="@(_isLoadingDatabases || _isSaving)">
                        <option value="">@t[TranslationKeys.SchemaTabSelectDbPrompt]</option>
                        @foreach (var databaseName in _databases)
                        {
                            <option value="@databaseName">@databaseName</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-secondary" type="button" @onclick="RefreshAll" disabled="@(_isLoadingDatabases || _isLoadingSchemas || _isSaving)">
                        <i class="bi bi-arrow-clockwise me-1"></i> @t[TranslationKeys.Refresh]
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="schema-alert alert @_messageClass alert-dismissible fade show" role="alert">
            <i class="bi @_messageIcon me-2"></i>@_message
            <button class="btn-close" type="button" @onclick="ClearMessage"></button>
        </div>
    }

    @if (_showCreateForm)
    {
        <div class="schema-editor card border-primary shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-plus-square me-2"></i>@t.Get(TranslationKeys.SchemaTabCreateInDb, _selectedDatabase)</span>
                <button class="btn-close btn-close-white" type="button" @onclick="CloseCreateSchema"></button>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="schema-name">@t[TranslationKeys.SchemaName]</label>
                        <input id="schema-name" class="form-control" maxlength="@(ServerConfig?.Database?.MaxSchemaNameLength ?? Constants.MaxSchemaNameLength)" @bind="_createConfiguration.SchemaName" placeholder="Sales" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="schema-owner">@t[TranslationKeys.SchemaTabOwner] <span class="text-muted fw-normal">@t[TranslationKeys.DbTabOptional]</span></label>
                        <select id="schema-owner" class="form-select" @bind="_createConfiguration.Owner">
                            <option value="">@t[TranslationKeys.SchemaTabDefaultOwner]</option>
                            @foreach (var owner in _owners)
                            {
                                <option value="@owner">@owner</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn btn-light" type="button" @onclick="CloseCreateSchema">@t[TranslationKeys.Cancel]</button>
                    <button class="btn btn-success" type="button" @onclick="CreateSchema" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @t[TranslationKeys.SchemaTabCreateSchema]
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (!HasDatabase)
            {
                <div class="text-center text-muted py-5"><i class="bi bi-database display-6"></i><p class="mt-3 mb-0">@t[TranslationKeys.SchemaTabSelectDbToManage]</p></div>
            }
            else if (_isLoadingSchemas)
            {
                <div class="text-center py-5"><span class="spinner-border text-primary me-2"></span>@t[TranslationKeys.SchemaTabLoadingSchemas]</div>
            }
            else if (_schemas.Count == 0)
            {
                <div class="text-center text-muted py-5"><i class="bi bi-diagram-3 display-6"></i><p class="mt-3 mb-0">@t[TranslationKeys.SchemaTabNoSchemasFound]</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="schema-list-table table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th class="ps-4">@t[TranslationKeys.SchemaName]</th><th>@t[TranslationKeys.SchemaTabOwner]</th><th class="text-center">@t[TranslationKeys.SchemaTabObjects]</th><th class="text-end pe-4">@t[TranslationKeys.Actions]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var schema in _schemas)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <i class="bi bi-diagram-3 me-2 text-primary"></i><span class="font-monospace">@schema.SchemaName</span>
                                        @if (schema.IsProtected)
                                        {
                                            <span class="badge text-bg-secondary ms-2">@t[TranslationKeys.SchemaTabBuiltIn]</span>
                                        }
                                    </td>
                                    <td class="font-monospace small">@schema.OwnerName</td>
                                    <td class="text-center"><span class="badge text-bg-light border">@schema.ObjectCount</span></td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" type="button" title="@t[TranslationKeys.SchemaTabViewObjects]" @onclick="() => OpenViewSchema(schema.SchemaName)"><i class="bi bi-list-ul"></i></button>
                                            <button class="btn btn-outline-secondary" type="button" title="@t.Get(TranslationKeys.SchemaTabEditHeading, schema.SchemaName)" disabled="@schema.IsProtected" @onclick="() => OpenEditSchema(schema)"><i class="bi bi-pencil-square"></i></button>
                                            <button class="btn btn-outline-danger" type="button" title="@t[TranslationKeys.Delete]" disabled="@schema.IsProtected" @onclick="() => OpenDeleteSchema(schema.SchemaName)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (_showEditDialog)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5"><i class="bi bi-pencil-square me-2"></i>@t.Get(TranslationKeys.SchemaTabEditHeading, _dialogSchemaName)</h2>
                        <button class="btn-close" type="button" @onclick="CloseDialogs"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="edit-schema-name">@t[TranslationKeys.SchemaName]</label>
                            <input id="edit-schema-name" class="form-control" maxlength="@(ServerConfig?.Database?.MaxSchemaNameLength ?? Constants.MaxSchemaNameLength)" @bind="_editNewName" @bind:event="oninput" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="edit-schema-owner">@t[TranslationKeys.SchemaTabOwner]</label>
                            <select id="edit-schema-owner" class="form-select" @bind="_editOwner">
                                @foreach (var owner in GetOwnerOptions())
                                {
                                    <option value="@owner">@owner</option>
                                }
                            </select>
                        </div>
                        @if (IsRenameRequested)
                        {
                            <div class="alert alert-warning small mb-0">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                @t[TranslationKeys.SchemaTabRenameWarning]
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-light" type="button" @onclick="CloseDialogs">@t[TranslationKeys.Cancel]</button>
                        <button class="btn btn-primary" type="button" @onclick="SaveSchemaChanges" disabled="@(_isSaving || !HasEditChanges)">@t[TranslationKeys.SaveChanges]</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (_showDeleteDialog)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h2 class="modal-title fs-5"><i class="bi bi-exclamation-triangle-fill me-2"></i>@t[TranslationKeys.Delete]</h2>
                        <button class="btn-close btn-close-white" type="button" @onclick="CloseDialogs"></button>
                    </div>
                    <div class="modal-body">
                        @if (_isLoadingObjects)
                        {
                            <div class="text-center py-3"><span class="spinner-border spinner-border-sm me-2"></span>@t[TranslationKeys.SchemaTabCheckingContents]</div>
                        }
                        else if (_dialogSchema is not null && _dialogSchema.Objects.Count > 0)
                        {
                            <div class="alert alert-warning small">
                                @t.Get(TranslationKeys.SchemaTabContainsObjectsWarning, _dialogSchemaName, _dialogSchema!.Objects.Count)
                            </div>
                            <SchemaObjectList Schema="_dialogSchema" />
                        }
                        else
                        {
                            <p>@t.Get(TranslationKeys.SchemaTabDeleteConfirm, _dialogSchemaName)</p>
                            <p class="text-danger small mb-0">@t[TranslationKeys.ServerActionUndoneWarning]</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-light" type="button" @onclick="CloseDialogs">@t[TranslationKeys.Cancel]</button>
                        <button class="btn btn-danger" type="button" @onclick="DeleteSchema" disabled="@(_isSaving || _isLoadingObjects || _dialogSchema is null || _dialogSchema.Objects.Count > 0)">@t[TranslationKeys.Delete]</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (_showViewDialog)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5"><i class="bi bi-list-ul me-2"></i>@t.Get(TranslationKeys.SchemaTabObjectsInSchema, _dialogSchemaName)</h2>
                        <button class="btn-close" type="button" @onclick="CloseDialogs"></button>
                    </div>
                    <div class="modal-body">
                        @if (_isLoadingObjects)
                        {
                            <div class="text-center py-3"><span class="spinner-border spinner-border-sm me-2"></span>@t[TranslationKeys.SchemaTabLoadingObjects]</div>
                        }
                        else
                        {
                            <SchemaObjectList Schema="_dialogSchema" />
                        }
                    </div>
                    <div class="modal-footer"><button class="btn btn-primary" type="button" @onclick="CloseDialogs">@t[TranslationKeys.Close]</button></div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
</div>

@code {
    [Parameter] public ServerConfiguration? ServerConfig { get; set; }
    [Parameter] public EventCallback<string> OnOperationComplete { get; set; }

    private DatabaseManager? _databaseManager;
    private Guid? _loadedServerId;
    private List<string> _databases = new();
    private List<string> _owners = new();
    private List<SchemaOperation.Information> _schemas = new();
    private SchemaOperation.Information? _dialogSchema;
    private SchemaOperation.Create _createConfiguration = new();
    private string _selectedDatabase = string.Empty;
    private string _dialogSchemaName = string.Empty;
    private string _editNewName = string.Empty;
    private string _editOwner = string.Empty;
    private string _editOriginalOwner = string.Empty;
    private bool _showCreateForm;
    private bool _showEditDialog;
    private bool _showDeleteDialog;
    private bool _showViewDialog;
    private bool _isLoadingDatabases;
    private bool _isLoadingSchemas;
    private bool _isLoadingObjects;
    private bool _isSaving;
    private string? _message;
    private string _messageClass = "alert-info";
    private string _messageIcon = "bi-info-circle-fill";

    private bool HasDatabase => !string.IsNullOrWhiteSpace(_selectedDatabase);
    private bool IsRenameRequested => !string.IsNullOrWhiteSpace(_editNewName) && !string.Equals(_editNewName.Trim(), _dialogSchemaName, StringComparison.Ordinal);
    private bool HasEditChanges => IsRenameRequested || !string.Equals(_editOwner, _editOriginalOwner, StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        if (ServerConfig?.Id == _loadedServerId)
            return;

        _loadedServerId = ServerConfig?.Id;
        _databaseManager = ServerConfig is null ? null : DatabaseManagerFactory.Create(ServerConfig);
        ResetState();

        if (_databaseManager is not null)
            await LoadDatabases();
    }

    private void ResetState()
    {
        _databases.Clear();
        _owners.Clear();
        _schemas.Clear();
        _selectedDatabase = string.Empty;
        CloseCreateSchema();
        CloseDialogs();
    }

    private async Task LoadDatabases()
    {
        if (_databaseManager is null) return;
        _isLoadingDatabases = true;
        try
        {
            var result = await _databaseManager.GetDatabases();
            if (result.operationResult.Success)
                _databases = result.databases;
            else
                ShowError(result.operationResult.Message);
        }
        catch (Exception exception) { ShowError($"Unable to load databases: {exception.Message}"); }
        finally { _isLoadingDatabases = false; }
    }

    private async Task LoadSchemas()
    {
        if (_databaseManager is null || !HasDatabase) return;

        var databaseName = _selectedDatabase;
        _isLoadingSchemas = true;
        try
        {
            var schemaResult = await _databaseManager.GetSchemaList(databaseName);
            var ownerResult = await _databaseManager.GetSchemaOwners(databaseName);

            // The user may have picked another database while the queries were running.
            if (databaseName != _selectedDatabase) return;

            if (schemaResult.operationResult.Success)
                _schemas = schemaResult.schemas;
            else
                ShowError(schemaResult.operationResult.Message);

            if (ownerResult.operationResult.Success)
                _owners = ownerResult.owners;
        }
        catch (Exception exception) { ShowError($"Unable to load schemas: {exception.Message}"); }
        finally { _isLoadingSchemas = false; }
    }

    private async Task OnDatabaseSelected()
    {
        CloseCreateSchema();
        CloseDialogs();
        _schemas = new List<SchemaOperation.Information>();
        _owners = new List<string>();
        await LoadSchemas();
    }

    private async Task RefreshAll()
    {
        await LoadDatabases();
        if (HasDatabase && !_databases.Contains(_selectedDatabase))
        {
            _selectedDatabase = string.Empty;
            _schemas = new List<SchemaOperation.Information>();
        }

        await LoadSchemas();
    }

    private void OpenCreateSchema()
    {
        _createConfiguration = new SchemaOperation.Create();
        _showCreateForm = true;
    }

    private void CloseCreateSchema()
    {
        _showCreateForm = false;
        _createConfiguration = new SchemaOperation.Create();
    }

    private async Task CreateSchema()
    {
        if (_databaseManager is null || !HasDatabase) return;

        _createConfiguration.DatabaseName = _selectedDatabase;
        _createConfiguration.SchemaName = (_createConfiguration.SchemaName ?? string.Empty).Trim();

        _isSaving = true;
        try
        {
            var result = await _databaseManager.CreateSchema(_createConfiguration);
            ShowResult(result);
            if (result.Success)
            {
                CloseCreateSchema();
                await LoadSchemas();
            }

            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowError($"Unable to create schema: {exception.Message}"); }
        finally { _isSaving = false; }
    }

    private void OpenEditSchema(SchemaOperation.Information schema)
    {
        CloseDialogs();
        _dialogSchemaName = schema.SchemaName;
        _editNewName = schema.SchemaName;
        _editOwner = _editOriginalOwner = schema.OwnerName;
        _showEditDialog = true;
    }

    private async Task SaveSchemaChanges()
    {
        if (_databaseManager is null || !HasDatabase) return;

        var request = new SchemaOperation.Alter
        {
            DatabaseName = _selectedDatabase,
            SchemaName = _dialogSchemaName,
            NewSchemaName = IsRenameRequested ? _editNewName.Trim() : null,
            Owner = string.Equals(_editOwner, _editOriginalOwner, StringComparison.Ordinal) ? null : _editOwner
        };

        _isSaving = true;
        try
        {
            var result = await _databaseManager.AlterSchema(request);
            ShowResult(result);
            if (result.Success)
            {
                CloseDialogs();
                await LoadSchemas();
            }

            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowError($"Unable to update schema: {exception.Message}"); }
        finally { _isSaving = false; }
    }

    private async Task OpenDeleteSchema(string schemaName)
    {
        CloseDialogs();
        _dialogSchemaName = schemaName;
        _showDeleteDialog = true;
        await LoadDialogObjects();
    }

    private async Task DeleteSchema()
    {
        if (_databaseManager is null || !HasDatabase) return;

        _isSaving = true;
        try
        {
            var result = await _databaseManager.DropSchema(new SchemaOperation.Drop
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _dialogSchemaName
            });
            ShowResult(result);
            if (result.Success)
            {
                CloseDialogs();
                await LoadSchemas();
            }

            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowError($"Unable to delete schema: {exception.Message}"); }
        finally { _isSaving = false; }
    }

    private async Task OpenViewSchema(string schemaName)
    {
        CloseDialogs();
        _dialogSchemaName = schemaName;
        _showViewDialog = true;
        await LoadDialogObjects();
    }

    private async Task LoadDialogObjects()
    {
        if (_databaseManager is null || !HasDatabase) return;

        var schemaName = _dialogSchemaName;
        _isLoadingObjects = true;
        try
        {
            var result = await _databaseManager.GetSchemaInformation(new SchemaOperation.Information
            {
                DatabaseName = _selectedDatabase,
                SchemaName = schemaName
            });

            if (schemaName != _dialogSchemaName) return;

            if (result.operationResult.Success)
                _dialogSchema = result.schema;
            else
            {
                CloseDialogs();
                ShowError(result.operationResult.Message);
            }
        }
        catch (Exception exception)
        {
            CloseDialogs();
            ShowError($"Unable to load schema objects: {exception.Message}");
        }
        finally { _isLoadingObjects = false; }
    }

    private void CloseDialogs()
    {
        _showEditDialog = _showDeleteDialog = _showViewDialog = false;
        _dialogSchemaName = string.Empty;
        _dialogSchema = null;
    }

    /// <summary>The current owner may not be in the list (for example a fixed role), so it is always offered.</summary>
    private IEnumerable<string> GetOwnerOptions()
    {
        return _owners.Contains(_editOriginalOwner, StringComparer.Ordinal)
            ? _owners
            : _owners.Prepend(_editOriginalOwner);
    }

    private void ShowResult(OperationResult result)
    {
        _message = result.Message;
        _messageClass = result.Success ? "alert-success" : "alert-danger";
        _messageIcon = result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill";
    }

    private void ShowError(string message)
    {
        _message = message;
        _messageClass = "alert-danger";
        _messageIcon = "bi-x-octagon-fill";
    }

    private void ClearMessage() => _message = null;
}

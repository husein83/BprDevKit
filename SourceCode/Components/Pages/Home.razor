@page "/"
@inject ITranslationFactory TranslationFactory

@{
    var t = TranslationFactory.Current;
}

<div class="home-page">
    <section class="home-hero">
        <p class="home-eyebrow">@t[TranslationKeys.HomeEyebrow]</p>
        <h1>@t[TranslationKeys.HomeTitle]</h1>
        <p>@t[TranslationKeys.HomeSubtitle]</p>
    </section>

    <section class="home-actions" aria-label="Main areas">
        <a class="home-action-card database-action" href="database-management">
            <span class="home-action-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5C4 3.57 7.58 2 12 2s8 1.57 8 3.5S16.42 9 12 9 4 7.43 4 5.5Zm0 6C4 13.43 7.58 15 12 15s8-1.57 8-3.5v4C20 17.43 16.42 19 12 19s-8-1.57-8-3.5v-4Zm0 6C4 19.43 7.58 21 12 21s8-1.57 8-3.5v-1.1C18.17 20.4 15.2 21 12 21s-6.17-.6-8-1.6v-1.9Z" /></svg>
            </span>
            <span class="home-action-body">
                <strong>@t[TranslationKeys.DatabaseManagement]</strong>
                <small>@t[TranslationKeys.HomeDbCardDesc]</small>
            </span>
            <span class="home-action-arrow" aria-hidden="true">@(t.IsRtl ? "←" : "→")</span>
        </a>

        <a class="home-action-card script-action" href="script-generator">
            <span class="home-action-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm-1.5 14.5-2.5-2.5 2.5-2.5 1.06 1.06-1.44 1.44 1.44 1.44-1.06 1.06zm3 0-1.06-1.06 1.44-1.44-1.44-1.44 1.06-1.06 2.5 2.5-2.5 2.5zM13 9V3.5L18.5 9H13z"/></svg>
            </span>
            <span class="home-action-body">
                <strong>@t[TranslationKeys.ScriptGenerator]</strong>
                <small>@t[TranslationKeys.HomeScriptCardDesc]</small>
            </span>
            <span class="home-action-arrow" aria-hidden="true">@(t.IsRtl ? "←" : "→")</span>
        </a>

        <a class="home-action-card settings-action" href="server-management">
            <span class="home-action-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8.25a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Zm0 2.25c.8 0 1.57-.16 2.27-.45l1.6 1.6-1.2 2.08 1.55 2.68 2.4-.62 1.2 2.08-1.74 1.74-2.08-1.2-2.68 1.55.62 2.4H10.8l.62-2.4-2.68-1.55-2.08 1.2-1.74-1.74 1.2-2.08-1.55-2.68-2.4.62v-2.4l2.4.62 1.55-2.68-1.2-2.08 1.74-1.74 2.08 1.2c.7-.29 1.47-.45 2.27-.45Zm0 2.5a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Z" /></svg>
            </span>
            <span class="home-action-body">
                <strong>@t[TranslationKeys.Settings]</strong>
                <small>@t[TranslationKeys.HomeSettingsCardDesc]</small>
            </span>
            <span class="home-action-arrow" aria-hidden="true">@(t.IsRtl ? "←" : "→")</span>
        </a>

        <a class="home-action-card logs-action" href="logs">
            <span class="home-action-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
            </span>
            <span class="home-action-body">
                <strong>@t[TranslationKeys.Logs]</strong>
                <small>@t[TranslationKeys.HomeLogsCardDesc]</small>
            </span>
            <span class="home-action-arrow" aria-hidden="true">@(t.IsRtl ? "←" : "→")</span>
        </a>
    </section>
</div>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="cs-p-key" @bind="_editingProfile.Options.CSharp.IncludeKeyAttribute" />
                                            <label class="form-check-label small" for="cs-p-key">@t[TranslationKeys.DataModelCsKeyAttribute]</label>
                                        </div>
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="cs-p-dbgen" @bind="_editingProfile.Options.CSharp.IncludeDatabaseGeneratedAttribute" />
                                            <label class="form-check-label small" for="cs-p-dbgen">@t[TranslationKeys.DataModelCsDatabaseGeneratedAttribute]</label>
                                        </div>
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="cs-p-timestamp" @bind="_editingProfile.Options.CSharp.IncludeTimestampAttribute" />
                                            <label class="form-check-label small" for="cs-p-timestamp">@t[TranslationKeys.DataModelCsIncludeTimestamp]</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Display & Documentation Card -->
                            <div class="col-md-6">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-white py-2">
                                        <span class="small fw-semibold">
                                            <code class="text-info-emphasis fw-bold me-1">[Display]</code> &amp; Metadata
                                        </span>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="cs-p-display" @bind="_editingProfile.Options.CSharp.IncludeDisplayAttribute" />
                                            <label class="form-check-label small" for="cs-p-display">@t[TranslationKeys.DataModelCsDisplayAttribute]</label>
                                        </div>
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="cs-p-desc" @bind="_editingProfile.Options.CSharp.IncludeDescriptionAttribute" />
                                            <label class="form-check-label small" for="cs-p-desc">@t[TranslationKeys.DataModelCsDescriptionAttribute]</label>
                                        </div>
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="cs-p-json" @bind="_editingProfile.Options.CSharp.IncludeJsonAttributes" />
                                            <label class="form-check-label small" for="cs-p-json">@t[TranslationKeys.DataModelCsJsonAttributes]</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Entity Framework Core & Class Attributes Card -->
                        <div class="col-12">
                            <div class="card border shadow-sm">
                                <div class="card-header bg-white py-2">
                                    <span class="small fw-semibold">
                                        <i class="bi bi-database me-1 text-primary"></i>Entity Framework Core &amp; Architecture
                                    </span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <div class="form-check form-switch mb-2">
                                                <input class="form-check-input" type="checkbox" id="cs-p-ef" @bind="_editingProfile.Options.CSharp.IncludeEfCoreTableAttributes" />
                                                <label class="form-check-label small" for="cs-p-ef">@t[TranslationKeys.DataModelCsEfTableAttributes]</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check form-switch mb-2">
                                                <input class="form-check-input" type="checkbox" id="cs-p-keyless" @bind="_editingProfile.Options.CSharp.IncludeKeylessAttributeForViews" />
                                                <label class="form-check-label small" for="cs-p-keyless">@t[TranslationKeys.DataModelCsKeylessAttribute]</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check form-switch mb-2">
                                                <input class="form-check-input" type="checkbox" id="cs-p-idx" @bind="_editingProfile.Options.CSharp.IncludeIndexesAsAttributes" />
                                                <label class="form-check-label small" for="cs-p-idx">@t[TranslationKeys.DataModelCsIncludeIndexes]</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check form-switch mb-2">
                                                <input class="form-check-input" type="checkbox" id="cs-p-nameof" @bind="_editingProfile.Options.CSharp.UseNameofInAttributes" />
                                                <label class="form-check-label small" for="cs-p-nameof">@t[TranslationKeys.DataModelCsUseNameof]</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Custom FK and PK Attributes -->
                        <div class="col-md-6">
                            <div class="card h-100 border shadow-sm">
                                <div class="card-header bg-white py-2">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="cs-p-fk-attr" @bind="_editingProfile.Options.CSharp.EnableCustomFkAttribute" />
                                        <label class="form-check-label small fw-semibold" for="cs-p-fk-attr">@t[TranslationKeys.DataModelCsEnableCustomFk]</label>
                                    </div>
                                </div>
                                <div class="card-body p-3">
                                    @if (_editingProfile.Options.CSharp.EnableCustomFkAttribute)
                                    {
                                        <input type="text" class="form-control form-control-sm font-monospace mb-1" placeholder='[FkProperty(Name = "{FullFieldName}")]' @bind="_editingProfile.Options.CSharp.CustomFkAttributeTemplate" />
                                        <div class="small text-muted" style="font-size: 0.72rem;">
                                            Tokens:
                                            <code class="user-select-all cursor-pointer me-1" @onclick='() => AppendFkToken("{FullFieldName}")'>{FullFieldName}</code>
                                            <code class="user-select-all cursor-pointer me-1" @onclick='() => AppendFkToken("{PropertyName}")'>{PropertyName}</code>
                                            <code class="user-select-all cursor-pointer me-1" @onclick='() => AppendFkToken("{ColumnName}")'>{ColumnName}</code>
                                            <code class="user-select-all cursor-pointer" @onclick='() => AppendFkToken("{TargetTable}")'>{TargetTable}</code>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">Disabled</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card h-100 border shadow-sm">
                                <div class="card-header bg-white py-2">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="cs-p-pk-attr" @bind="_editingProfile.Options.CSharp.EnableCustomPkAttribute" />
                                        <label class="form-check-label small fw-semibold" for="cs-p-pk-attr">@t[TranslationKeys.DataModelCsEnableCustomPk]</label>
                                    </div>
                                </div>
                                <div class="card-body p-3">
                                    @if (_editingProfile.Options.CSharp.EnableCustomPkAttribute)
                                    {
                                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="[Key]" @bind="_editingProfile.Options.CSharp.CustomPkAttributeTemplate" />
                                    }
                                    else
                                    {
                                        <div class="text-muted small">Disabled</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Custom Rules & Templates -->
                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsCustomColumnRules]</label>
                            <textarea class="form-control form-control-sm font-monospace" rows="2" placeholder="@("*Date:[Auditable]\nuniqueidentifier:[GuidColumn]")" @bind="_editingProfile.Options.CSharp.CustomColumnAttributeRules"></textarea>
                            <div class="small text-muted" style="font-size: 0.72rem;">
                                Tokens: <code>{ColumnName}</code> <code>{PropertyName}</code> <code>{DataType}</code> <code>{Length}</code> <code>{Precision}</code> <code>{Scale}</code>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsCustomClassAttributes]</label>
                            <textarea class="form-control form-control-sm font-monospace" rows="3" placeholder="@("[DataContract]\n[Serializable]")" @bind="_editingProfile.Options.CSharp.CustomClassAttributes"></textarea>
                            <div class="small text-muted" style="font-size: 0.72rem;">
                                Tokens: <code>{ClassName}</code> <code>{TableName}</code> <code>{SchemaName}</code> <code>{Database}</code>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsDefaultPropertyAttributes]</label>
                            <textarea class="form-control form-control-sm font-monospace" rows="3" placeholder="@("[DataMember]\n[Column]")" @bind="_editingProfile.Options.CSharp.DefaultPropertyAttributes"></textarea>
                            <div class="small text-muted" style="font-size: 0.72rem;">
                                @t[TranslationKeys.DataModelCsDefaultPropertyAttributesHelp] &bull; Tokens: <code>{ColumnName}</code> <code>{PropertyName}</code> <code>{DataType}</code> <code>{Length}</code>
                            </div>
                        </div>
                    </div>
                }
                else if (_csActiveTab == "navigation")
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsNavigationStyle]</label>
                            <select class="form-select form-select-sm" @bind="_editingProfile.Options.CSharp.NavigationStyle">
                                <option value="Standard">@t[TranslationKeys.DataModelCsNavStandard]</option>
                                <option value="Enterprise">@t[TranslationKeys.DataModelCsNavEnterprise]</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsNavigationPropertyAttributes]</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. [DataMember]" @bind="_editingProfile.Options.CSharp.NavigationPropertyAttributes" />
                            <div class="small text-muted" style="font-size: 0.72rem;">@t[TranslationKeys.DataModelCsNavigationPropertyAttributesHelp]</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsCustomNavReferenceAttr]</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. [ForeignKey(nameof({FkProperty}))]" @bind="_editingProfile.Options.CSharp.CustomNavReferenceAttribute" />
                            <div class="small text-muted" style="font-size: 0.72rem;">
                                Tokens: <code>{FkProperty}</code> <code>{TargetType}</code> <code>{TargetClass}</code> <code>{OtherKey}</code>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsCustomNavInverseAttr]</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. [InverseProperty(nameof({InverseType}.{InverseProperty}))]" @bind="_editingProfile.Options.CSharp.CustomNavInversePropertyAttribute" />
                            <div class="small text-muted" style="font-size: 0.72rem;">
                                Tokens: <code>{InverseType}</code> <code>{InverseProperty}</code> <code>{ChildClass}</code> <code>{ChildFk}</code> <code>{OtherKey}</code>
                            </div>
                        </div>

                        @if (_editingProfile.Options.CSharp.NavigationStyle == "Enterprise")
                        {
                            <div class="col-12">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="cs-p-nav-full-ns" @bind="_editingProfile.Options.CSharp.UseFullNamespaceForNavTypes" />
                                    <label class="form-check-label small" for="cs-p-nav-full-ns">@t[TranslationKeys.DataModelCsUseFullNamespaceForNav]</label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="cs-p-nav-null-colls" @bind="_editingProfile.Options.CSharp.MakeCollectionsNullable" />
                                    <label class="form-check-label small" for="cs-p-nav-null-colls">@t[TranslationKeys.DataModelCsMakeCollectionsNullable]</label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="cs-p-nav-schema-prefix" @bind="_editingProfile.Options.CSharp.IncludeSchemaInRelationName" />
                                    <label class="form-check-label small" for="cs-p-nav-schema-prefix">@t[TranslationKeys.DataModelCsIncludeSchemaInRelationName]</label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_csActiveTab == "transform")
                {
                    <!-- Smart Property Transformations Engine -->
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => AddQuickRule(QuickRuleType.JsonDictionary)">
                            + JSON &rarr; Dictionary
                        </button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => AddQuickRule(QuickRuleType.JsonDocument)">
                            + JSON &rarr; JsonDocument
                        </button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => AddQuickRule(QuickRuleType.Xml)">
                            + XML &rarr; XElement
                        </button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => AddQuickRule(QuickRuleType.CsvList)">
                            + CSV &rarr; List&lt;string&gt;
                        </button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => AddQuickRule(QuickRuleType.Enum)">
                            + Int &rarr; Enum
                        </button>
                        <button class="btn btn-sm btn-success ms-auto" type="button" @onclick="OpenNewRuleModal">
                            <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.DataModelTransformAddRule]
                        </button>
                    </div>

                    @if (_showRuleModal)
                    {
                        <div class="card p-3 mb-3 border-primary shadow-sm bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold text-primary">
                                    <i class="bi bi-sliders2 me-1"></i>@(_isNewRule ? t[TranslationKeys.DataModelTransformAddRule] : "Edit Rule")
                                </span>
                                <button class="btn btn-sm btn-link text-muted p-0" type="button" @onclick="() => _showRuleModal = false">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-12">
                                    <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformRuleName]</label>
                                    <input type="text" class="form-control form-control-sm" @bind="_editingRule.RuleName" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformColPattern]</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="*Json" @bind="_editingRule.ColumnNamePattern" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformTypePattern]</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="json" @bind="_editingRule.DataTypePattern" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformActionType]</label>
                                    <select class="form-select form-select-sm" @bind="_editingRule.ActionType">
                                        <option value="NotMappedHelper">@t[TranslationKeys.DataModelTransformNotMappedHelper]</option>
                                        <option value="CustomGetterSetter">@t[TranslationKeys.DataModelTransformCustomGetterSetter]</option>
                                        <option value="TypeOverride">@t[TranslationKeys.DataModelTransformTypeOverride]</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformTargetType]</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="Dictionary<string, object?>?" @bind="_editingRule.TargetType" />
                                </div>
                                @if (_editingRule.ActionType == "NotMappedHelper")
                                {
                                    <div class="col-12">
                                        <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformHelperPropName]</label>
                                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="{PropertyName}Data" @bind="_editingRule.HelperPropertyNameTemplate" />
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="rule-twoway" @bind="_editingRule.EnableTwoWaySync" />
                                            <label class="form-check-label small" for="rule-twoway">@t[TranslationKeys.DataModelTransformTwoWaySync]</label>
                                        </div>
                                        <div class="form-text small">@t[TranslationKeys.DataModelTransformTwoWaySyncHelp]</div>
                                    </div>
                                }
                                <div class="col-12">
                                    <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformGetter]</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" @bind="_editingRule.GetterTemplate" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformSetter]</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" @bind="_editingRule.SetterTemplate" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-1">@t[TranslationKeys.DataModelTransformUsing]</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="System.Text.Json" @bind="_editingRule.RequiredUsing" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => _showRuleModal = false">
                                    @t[TranslationKeys.Cancel]
                                </button>
                                <button class="btn btn-primary btn-sm" type="button" @onclick="SaveRule">
                                    <i class="bi bi-check-lg me-1"></i>@t[TranslationKeys.Save]
                                </button>
                            </div>
                        </div>
                    }

                    @if (_editingProfile.Options.CSharp.TransformRules.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small bg-white rounded border">
                            @t[TranslationKeys.DataModelTransformNoRules]
                        </div>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var rule in _editingProfile.Options.CSharp.TransformRules)
                            {
                                <div class="col-md-6">
                                    <div class="card p-3 border shadow-sm bg-white">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <input class="form-check-input mt-0" type="checkbox" @bind="rule.IsEnabled" title="Enable/Disable" />
                                                <strong class="small text-dark">@rule.RuleName</strong>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-link btn-sm text-primary p-0 me-2" type="button" @onclick="() => EditRule(rule)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button class="btn btn-link btn-sm text-danger p-0" type="button" @onclick="() => DeleteRule(rule)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="small text-muted font-monospace">
                                            <span class="badge text-bg-light border me-1">@rule.ColumnNamePattern</span>
                                            <span class="badge text-bg-secondary me-1">@rule.ActionType</span>
                                            <span class="text-primary">@rule.TargetType</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else if (_csActiveTab == "customSnippet")
                {
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsCustomSnippet]</label>
                            <textarea class="form-control form-control-sm font-monospace" rows="8" placeholder="@("// Custom properties or methods\npublic string FullTitle => $\"{Id} - {Title}\";")" @bind="_editingProfile.Options.CSharp.CustomClassBodySnippet"></textarea>
                            <div class="small text-muted mt-1">
                                Tokens: <code>{ClassName}</code>, <code>{TableName}</code>, <code>{SchemaName}</code>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (_editingProfile.Options.Language == DataModelLanguage.Python)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelPyStyle]</label>
                        <select class="form-select form-select-sm" @bind="_editingProfile.Options.Python.Style">
                            <option value="pydantic">@t[TranslationKeys.DataModelPyPydantic]</option>
                            <option value="dataclass">@t[TranslationKeys.DataModelPyDataclass]</option>
                            <option value="sqlalchemy">@t[TranslationKeys.DataModelPySqlAlchemy]</option>
                            <option value="typeddict">@t[TranslationKeys.DataModelPyTypedDict]</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelBaseClass]</label>
                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. BaseEntity" @bind="_editingProfile.Options.Python.BaseClass" />
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="py-p-snake" @bind="_editingProfile.Options.Python.UseSnakeCaseProperties" />
                            <label class="form-check-label small" for="py-p-snake">@t[TranslationKeys.DataModelPySnakeCase]</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="py-p-opt" @bind="_editingProfile.Options.Python.UseOptionalTypeHinting" />
                            <label class="form-check-label small" for="py-p-opt">@t[TranslationKeys.DataModelPyOptional]</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="py-p-doc" @bind="_editingProfile.Options.Python.IncludeDocstrings" />
                            <label class="form-check-label small" for="py-p-doc">@t[TranslationKeys.DataModelPyDocstrings]</label>

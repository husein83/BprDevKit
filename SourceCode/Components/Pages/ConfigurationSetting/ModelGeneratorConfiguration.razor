</div>

@code {
    [Parameter] public EventCallback OnConfigurationChanged { get; set; }

    private List<DataModelProfile> _profiles = new();
    private List<ServerConfig> _servers = new();
    private bool _isEditingProfile = false;
    private DataModelProfile _editingProfile = new();
    private string _filterText = string.Empty;
    private string _csActiveTab = "structure";
    private BprMessage? _panelMessage;

    // Database & Schema state
    private List<string> _profileDatabases = new();
    private bool _isLoadingDatabases = false;
    private bool _showAddSchemaRuleModal = false;
    private string _newSourceSchema = string.Empty;
    private string _modalSelectedTargetSchema = string.Empty;
    private List<string> _modalSelectedTargetSchemasList = new();
    private bool _isLoadingSchemas = false;
    private List<string> _dbSchemas = new();
    private Dictionary<Guid, string> _quickAddTarget = new();

    // Rule modal inside Profile editor
    private bool _showRuleModal = false;
    private PropertyTransformRule _editingRule = new();
    private bool _isNewRule = true;

    public int ProfilesCount => _profiles.Count;

    private enum QuickRuleType
    {
        JsonDictionary,
        JsonDocument,
        Xml,
        CsvList,
        Enum
    }

    private List<DataModelProfile> FilteredProfiles =>
        string.IsNullOrWhiteSpace(_filterText)
            ? _profiles
            : _profiles.Where(p =>
                p.ProfileName.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ||
                (p.ServerName != null && p.ServerName.Contains(_filterText, StringComparison.OrdinalIgnoreCase)) ||
                (p.DatabaseName != null && p.DatabaseName.Contains(_filterText, StringComparison.OrdinalIgnoreCase))
            ).ToList();

    protected override void OnInitialized()
    {
        LoadAllData();
    }

    public void LoadAllData()
    {
        try
        {
            _servers = ServerConfig.LoadAllFromEncryptedFile(false)
                .Where(s => s.Id.HasValue)
                .ToList();
            _profiles = ModelGenConfig.LoadAllProfiles();
        }
        catch (Exception ex)
        {
            _panelMessage = BprMessage.Error(ex.Message);
        }
    }

    public void CreateNewProfile()
    {
        _editingProfile = new DataModelProfile
        {
            ProfileName = string.Empty,
            Options = new DataModelOptions()
        };
        _profileDatabases.Clear();
        _isEditingProfile = true;
        StateHasChanged();
    }

    private async Task EditProfile(DataModelProfile profile)
    {
        try
        {
            _panelMessage = null;
            var json = JsonSerializer.Serialize(profile);
            _editingProfile = JsonSerializer.Deserialize<DataModelProfile>(json) ?? new DataModelProfile();
            _isEditingProfile = true;

            // Initialize known schemas from saved rules first as immediate fallback
            _dbSchemas = _editingProfile.Options.SchemaAccessRules
                .Select(r => r.SourceSchema)
                .Concat(_editingProfile.Options.SchemaAccessRules.SelectMany(r => r.AllowedTargetSchemas))
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s)
                .ToList();

            if (_editingProfile.ServerId.HasValue)
            {
                var s = _servers.FirstOrDefault(x => x.Id == _editingProfile.ServerId.Value);
                if (s != null)
                {
                    await LoadDatabasesForServer(s);
                    if (!string.IsNullOrWhiteSpace(_editingProfile.DatabaseName))
                    {
                        await LoadSchemasForDatabase(silent: true);
                    }
                }
            }
            else
            {
                _profileDatabases.Clear();
                _dbSchemas.Clear();
            }
        }
        catch
        {
            _editingProfile = profile;
            _isEditingProfile = true;
        }
    }

    private void CloneProfile(DataModelProfile profile)
    {
        try
        {
            var json = JsonSerializer.Serialize(profile);
            var clone = JsonSerializer.Deserialize<DataModelProfile>(json) ?? new DataModelProfile();
            clone.Id = Guid.NewGuid();
            clone.ProfileName = profile.ProfileName + " (Copy)";
            clone.CreateDate = DateTime.UtcNow;
            clone.LastModifiedDate = null;
            ModelGenConfig.SaveProfile(clone);
            LoadAllData();
            OnConfigurationChanged.InvokeAsync();
            _panelMessage = BprMessage.Success(TranslationFactory.Current[TranslationKeys.DataModelProfileSaveSuccess]);
        }
        catch (Exception ex)
        {
            _panelMessage = BprMessage.Error(ex.Message);
        }
    }

    private void DeleteProfile(DataModelProfile profile)
    {
        try
        {
            ModelGenConfig.DeleteProfile(profile.Id);
            LoadAllData();
            OnConfigurationChanged.InvokeAsync();
            _panelMessage = BprMessage.Information(TranslationFactory.Current[TranslationKeys.DataModelProfileDeleteSuccess]);
        }
        catch (Exception ex)
        {
            _panelMessage = BprMessage.Error(ex.Message);
        }
    }

    private void CancelEditing()
    {
        _isEditingProfile = false;
        _editingProfile = new DataModelProfile();
    }

    private void SaveCurrentProfile()
    {
        if (string.IsNullOrWhiteSpace(_editingProfile.ProfileName))
        {
            _panelMessage = BprMessage.Warning(TranslationFactory.Current[TranslationKeys.DataModelProfileName]);
            return;
        }

        try
        {
            if (_editingProfile.ServerId.HasValue)
            {
                var s = _servers.FirstOrDefault(x => x.Id == _editingProfile.ServerId.Value);
                _editingProfile.ServerName = s?.Server.ServerName;
            }
            else
            {
                _editingProfile.ServerName = null;
            }

            ModelGenConfig.SaveProfile(_editingProfile);
            _panelMessage = BprMessage.Success(TranslationFactory.Current[TranslationKeys.DataModelProfileSaveSuccess]);
            _isEditingProfile = false;
            LoadAllData();
            OnConfigurationChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _panelMessage = BprMessage.Error(ex.Message);
        }
    }

    private async Task OnProfileServerChanged()
    {
        _profileDatabases.Clear();
        _editingProfile.DatabaseName = null;
        _dbSchemas.Clear();

        if (_editingProfile.ServerId.HasValue)
        {
            var s = _servers.FirstOrDefault(x => x.Id == _editingProfile.ServerId.Value);
            _editingProfile.ServerName = s?.Server.ServerName;
            if (s != null)
            {
                await LoadDatabasesForServer(s);
            }
        }
        else
        {
            _editingProfile.ServerName = null;
        }
    }

    private async Task OnProfileDatabaseChanged()
    {
        _dbSchemas.Clear();
        if (_editingProfile.ServerId.HasValue && !string.IsNullOrWhiteSpace(_editingProfile.DatabaseName))
        {
            await LoadSchemasForDatabase(silent: true);
        }
    }

    private void SetCsActiveTab(string tab)
    {
        _csActiveTab = tab;
    }

    private async Task LoadDatabasesForServer(ServerConfig server)
    {
        _isLoadingDatabases = true;
        _profileDatabases.Clear();
        try
        {
            var manager = DatabaseManagerFactory.Create(server);
            var (res, dbs) = await manager.GetDatabases();
            if (res.Success && dbs != null)
            {
                _profileDatabases = dbs.OrderBy(d => d).ToList();
            }
        }
        catch (Exception ex)
        {
            _panelMessage = BprMessage.Warning($"Could not load databases from server: {ex.Message}");
        }
        finally
        {
            _isLoadingDatabases = false;
            StateHasChanged();
        }
    }

    private async Task OpenAddSchemaRuleModal()
    {
        if (_dbSchemas.Count == 0 && _editingProfile.ServerId.HasValue && !string.IsNullOrWhiteSpace(_editingProfile.DatabaseName))
        {
            await LoadSchemasForDatabase(silent: true);
        }
        _newSourceSchema = _dbSchemas.FirstOrDefault(s => !_editingProfile.Options.SchemaAccessRules.Any(r => string.Equals(r.SourceSchema, s, StringComparison.OrdinalIgnoreCase))) ?? _dbSchemas.FirstOrDefault() ?? string.Empty;
        _modalSelectedTargetSchema = string.Empty;
        _modalSelectedTargetSchemasList.Clear();
        _showAddSchemaRuleModal = true;
    }

    private void AddModalTargetSchema()
    {
        if (!string.IsNullOrWhiteSpace(_modalSelectedTargetSchema))
        {
            var trimmed = _modalSelectedTargetSchema.Trim();
            if (!_modalSelectedTargetSchemasList.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
            {
                _modalSelectedTargetSchemasList.Add(trimmed);
            }
            _modalSelectedTargetSchema = string.Empty;
        }
    }

    private void SaveSchemaRule()
    {
        if (string.IsNullOrWhiteSpace(_newSourceSchema)) return;

        var source = _newSourceSchema.Trim();
        var existing = _editingProfile.Options.SchemaAccessRules.FirstOrDefault(r => string.Equals(r.SourceSchema, source, StringComparison.OrdinalIgnoreCase));
        if (existing == null)
        {
            existing = new SchemaAccessRule
            {
                SourceSchema = source
            };
            _editingProfile.Options.SchemaAccessRules.Add(existing);
        }

        foreach (var target in _modalSelectedTargetSchemasList)
        {
            if (!existing.AllowedTargetSchemas.Any(x => string.Equals(x, target, StringComparison.OrdinalIgnoreCase)))
            {
                existing.AllowedTargetSchemas.Add(target);
            }
        }

        _showAddSchemaRuleModal = false;
        StateHasChanged();
    }

    private void DeleteSchemaRule(SchemaAccessRule rule)
    {
        _editingProfile.Options.SchemaAccessRules.Remove(rule);
        StateHasChanged();
    }

    private void RemoveTargetSchemaFromRule(SchemaAccessRule rule, string target)
    {
        rule.AllowedTargetSchemas.RemoveAll(x => string.Equals(x, target, StringComparison.OrdinalIgnoreCase));
        StateHasChanged();
    }

    private void AddTargetSchemaToRule(SchemaAccessRule rule)
    {
        if (_quickAddTarget.TryGetValue(rule.Id, out var target) && !string.IsNullOrWhiteSpace(target))
        {
            var trimmed = target.Trim();
            if (!rule.AllowedTargetSchemas.Any(x => string.Equals(x, trimmed, StringComparison.OrdinalIgnoreCase)))
            {
                rule.AllowedTargetSchemas.Add(trimmed);
            }
            _quickAddTarget[rule.Id] = string.Empty;
            StateHasChanged();
        }
    }

    private void OnQuickAddKeyDown(KeyboardEventArgs e, SchemaAccessRule rule)
    {
        if (e.Key == "Enter")
        {
            AddTargetSchemaToRule(rule);
        }
    }

    private async Task LoadSchemasForDatabase(bool silent = true)
    {
        if (!_editingProfile.ServerId.HasValue || string.IsNullOrWhiteSpace(_editingProfile.DatabaseName))
            return;

        var server = _servers.FirstOrDefault(x => x.Id == _editingProfile.ServerId.Value);
        if (server == null) return;

        _isLoadingSchemas = true;
        try
        {
            var manager = DatabaseManagerFactory.Create(server);
            var (res, schemas) = await manager.GetSchemas(_editingProfile.DatabaseName);
            if (res.Success && schemas != null)
            {
                var ruleSchemas = _editingProfile.Options.SchemaAccessRules
                    .Select(r => r.SourceSchema)
                    .Concat(_editingProfile.Options.SchemaAccessRules.SelectMany(r => r.AllowedTargetSchemas))
                    .Where(s => !string.IsNullOrWhiteSpace(s));

                _dbSchemas = schemas
                    .Concat(ruleSchemas)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(s => s)
                    .ToList();

                if (!silent)
                {
                    _panelMessage = BprMessage.Success($"Loaded {_dbSchemas.Count} schemas from database.");
                }
            }
            else if (!silent)
            {
                _panelMessage = BprMessage.Warning(res.Message);
            }
        }
        catch (Exception ex)
        {
            if (!silent)
            {
                _panelMessage = BprMessage.Warning($"Failed to load schemas: {ex.Message}");
            }
        }
        finally
        {
            _isLoadingSchemas = false;
            StateHasChanged();
        }
    }

    private async Task DetectSchemasFromDb()
    {
        if (!_editingProfile.ServerId.HasValue || string.IsNullOrWhiteSpace(_editingProfile.DatabaseName))
            return;

        var server = _servers.FirstOrDefault(x => x.Id == _editingProfile.ServerId.Value);
        if (server == null) return;

        _isLoadingSchemas = true;
        try
        {
            var manager = DatabaseManagerFactory.Create(server);
            var (res, schemas) = await manager.GetSchemas(_editingProfile.DatabaseName);
            if (res.Success && schemas != null)
            {
                var ruleSchemas = _editingProfile.Options.SchemaAccessRules
                    .Select(r => r.SourceSchema)
                    .Concat(_editingProfile.Options.SchemaAccessRules.SelectMany(r => r.AllowedTargetSchemas))
                    .Where(s => !string.IsNullOrWhiteSpace(s));

                _dbSchemas = schemas
                    .Concat(ruleSchemas)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(s => s)
                    .ToList();

                foreach (var s in _dbSchemas)
                {
                    if (!_editingProfile.Options.SchemaAccessRules.Any(r => string.Equals(r.SourceSchema, s, StringComparison.OrdinalIgnoreCase)))
                    {
                        _editingProfile.Options.SchemaAccessRules.Add(new SchemaAccessRule
                        {
                            SourceSchema = s,
                            AllowedTargetSchemas = new List<string>()
                        });
                    }
                }
                _panelMessage = BprMessage.Success($"Loaded {_dbSchemas.Count} schemas from database.");
            }
            else
            {
                _panelMessage = BprMessage.Warning(res.Message);
            }
        }
        catch (Exception ex)
        {
            _panelMessage = BprMessage.Warning($"Failed to load schemas: {ex.Message}");
        }
        finally
        {
            _isLoadingSchemas = false;
            StateHasChanged();
        }
    }

    private void AddQuickRule(QuickRuleType type)
    {
        var rule = type switch
        {
            QuickRuleType.JsonDictionary => new PropertyTransformRule
            {
                RuleName = "JSON to Dictionary",
                ColumnNamePattern = "*Json",
                DataTypePattern = "json",
                ActionType = "NotMappedHelper",
                HelperPropertyNameTemplate = "{PropertyName}Data",
                TargetType = "Dictionary<string, object?>?",
                GetterTemplate = "string.IsNullOrWhiteSpace({PropertyName}) ? null : JsonSerializer.Deserialize<Dictionary<string, object?>>({PropertyName})",
                SetterTemplate = "{PropertyName} = value == null ? null : JsonSerializer.Serialize(value);",
                RequiredUsing = "System.Text.Json"
            },
            QuickRuleType.JsonDocument => new PropertyTransformRule
            {
                RuleName = "JSON to JsonDocument",
                ColumnNamePattern = "*Payload",
                DataTypePattern = "json",
                ActionType = "NotMappedHelper",
                HelperPropertyNameTemplate = "{PropertyName}Doc",
                TargetType = "JsonDocument?",
                GetterTemplate = "string.IsNullOrWhiteSpace({PropertyName}) ? null : JsonDocument.Parse({PropertyName})",
                SetterTemplate = "{PropertyName} = value?.RootElement.ToString();",
                RequiredUsing = "System.Text.Json"
            },
            QuickRuleType.Xml => new PropertyTransformRule
            {
                RuleName = "XML to XElement",
                ColumnNamePattern = "*Xml",
                DataTypePattern = "xml",
                ActionType = "NotMappedHelper",
                HelperPropertyNameTemplate = "{PropertyName}Xml",
                TargetType = "XElement?",
                GetterTemplate = "string.IsNullOrWhiteSpace({PropertyName}) ? null : XElement.Parse({PropertyName})",
                SetterTemplate = "{PropertyName} = value?.ToString();",
                RequiredUsing = "System.Xml.Linq"
            },
            QuickRuleType.CsvList => new PropertyTransformRule
            {
                RuleName = "CSV to List<string>",
                ColumnNamePattern = "*Tags",
                DataTypePattern = "*",
                ActionType = "NotMappedHelper",
                HelperPropertyNameTemplate = "{PropertyName}List",
                TargetType = "List<string>?",
                GetterTemplate = "string.IsNullOrWhiteSpace({PropertyName}) ? null : {PropertyName}.Split(',').ToList()",
                SetterTemplate = "{PropertyName} = value == null ? null : string.Join(\",\", value);",
                RequiredUsing = "System.Linq"
            },
            QuickRuleType.Enum => new PropertyTransformRule
            {
                RuleName = "Int to Enum",
                ColumnNamePattern = "*Status",
                DataTypePattern = "int",
                ActionType = "TypeOverride",
                TargetType = "MyStatusEnum",
                RequiredUsing = "MyProject.Enums"
            },
            _ => new PropertyTransformRule()
        };

        _editingProfile.Options.CSharp.TransformRules.Add(rule);
    }

    private void OpenNewRuleModal()
    {
        _editingRule = new PropertyTransformRule();
        _isNewRule = true;
        _showRuleModal = true;
    }

    private void EditRule(PropertyTransformRule rule)
    {
        _editingRule = rule;
        _isNewRule = false;
        _showRuleModal = true;
    }

    private void DeleteRule(PropertyTransformRule rule)
    {
        _editingProfile.Options.CSharp.TransformRules.Remove(rule);
    }

    private void SaveRule()
    {
        if (_isNewRule)
        {
            _editingProfile.Options.CSharp.TransformRules.Add(_editingRule);
        }
        _showRuleModal = false;
    }

    private void AppendNamespaceToken(string token)
    {
        _editingProfile.Options.CSharp.Namespace += (_editingProfile.Options.CSharp.Namespace.EndsWith(".") ? "" : ".") + token;
    }

    private void AppendFkToken(string token)
    {
        _editingProfile.Options.CSharp.CustomFkAttributeTemplate += token;
    }

    private void AppendRequiredErrorToken(string token)
    {
        _editingProfile.Options.CSharp.RequiredErrorMessageTemplate =
            (_editingProfile.Options.CSharp.RequiredErrorMessageTemplate ?? string.Empty) + token;
    }

    private void EnsureInitialConstants()
    {
        if (_editingProfile.Options.CSharp.IncludeConstants && _editingProfile.Options.CSharp.Constants.Count == 0)
        {
            _editingProfile.Options.CSharp.Constants.Add(new ClassConstantDefinition
            {
                AccessModifier = "public",
                Type = "string",
                Name = "TABLE_NAME",
                ValueTemplate = "\"{TableName}\""
            });
            _editingProfile.Options.CSharp.Constants.Add(new ClassConstantDefinition
            {
                AccessModifier = "public",
                Type = "string",
                Name = "SCHEMA_NAME",
                ValueTemplate = "\"{SchemaName}\""
            });
        }
    }

    private void AddConstant()
    {
        _editingProfile.Options.CSharp.Constants.Add(new ClassConstantDefinition
        {
            AccessModifier = "public",
            Type = "string",
            Name = "NEW_CONSTANT",
            ValueTemplate = "\"{TableName}\""
        });
    }

    private void RemoveConstant(ClassConstantDefinition item)
    {
        _editingProfile.Options.CSharp.Constants.Remove(item);
    }

    private void AppendSchemaNsToken(string token)
    {
        _editingProfile.Options.CSharp.SchemaNamespacePattern +=
            (_editingProfile.Options.CSharp.SchemaNamespacePattern.EndsWith(".") ? "" : ".") + token;
    }

    private void AppendSingleNsToken(string token)
    {
        if (string.IsNullOrWhiteSpace(_editingProfile.Options.CSharp.Namespace))
        {
            _editingProfile.Options.CSharp.Namespace = token;
        }
        else
        {
            _editingProfile.Options.CSharp.Namespace +=
                (_editingProfile.Options.CSharp.Namespace.EndsWith(".") ? "" : ".") + token;
        }
    }

    private async Task CopyToken(string token)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", token);
            _panelMessage = BprMessage.Success($"Token {token} copied to clipboard.");
        }
        catch
        {
            // fallback if clipboard API is restricted
        }
    }

    private void AddSchemaNamespaceMapping()
    {
        var schema = _dbSchemas.FirstOrDefault() ?? "dbo";
        var db = !string.IsNullOrWhiteSpace(_editingProfile.DatabaseName) ? _editingProfile.DatabaseName : "MyProject";
        _editingProfile.Options.CSharp.SchemaNamespaceMappings.Add(new SchemaNamespaceMapping
        {
            SchemaName = schema,
            Namespace = $"{db}.{schema}.DataModel"
        });
    }

    private void RemoveSchemaNamespaceMapping(SchemaNamespaceMapping map)
    {
        _editingProfile.Options.CSharp.SchemaNamespaceMappings.Remove(map);
    }

    private void EnsureInitialOverrides()
    {
        if (_editingProfile.Options.CSharp.IncludeOverrides && _editingProfile.Options.CSharp.Overrides.Count == 0)
        {
            _editingProfile.Options.CSharp.Overrides.Add(new ClassOverrideDefinition
            {
                AccessModifier = "public",
                MemberKind = "Property",
                ReturnType = "string",
                Name = "TableName",
                IsExpressionBodied = true,
                Body = "\"{TableName}\""
            });
            _editingProfile.Options.CSharp.Overrides.Add(new ClassOverrideDefinition
            {
                AccessModifier = "public",
                MemberKind = "Property",
                ReturnType = "string",
                Name = "SchemaName",
                IsExpressionBodied = true,
                Body = "\"{SchemaName}\""
            });
        }
    }

    private void AddOverride()
    {
        _editingProfile.Options.CSharp.Overrides.Add(new ClassOverrideDefinition
        {
            AccessModifier = "public",
            MemberKind = "Property",
            ReturnType = "string",
            Name = "NewOverride",
            IsExpressionBodied = true,
            Body = "\"{TableName}\""
        });
    }

    private void RemoveOverride(ClassOverrideDefinition item)
    {
        _editingProfile.Options.CSharp.Overrides.Remove(item);
    }

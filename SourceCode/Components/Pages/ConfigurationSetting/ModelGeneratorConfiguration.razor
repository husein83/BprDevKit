                                            <label class="form-check-label small fw-semibold" for="cs-p-strlen">@t[TranslationKeys.DataModelCsStringLengthAttribute]</label>
                                        </div>

                                        @if (_editingProfile.Options.CSharp.IncludeStringLengthAttribute)
                                        {
                                            <div class="ps-3 border-start">
                                                <label class="form-label small mb-1">@t[TranslationKeys.DataModelCsStringLengthKind]</label>
                                                <select class="form-select form-select-sm" @bind="_editingProfile.Options.CSharp.StringLengthAttributeKind">
                                                    <option value="StringLength">[StringLength(n)]</option>
                                                    <option value="MaxLength">[MaxLength(n)]</option>
                                                </select>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Primary Key & Database Generated Card -->
                            <div class="col-md-6">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-white py-2">

@using System.Text.Json
@using BprDevKit.Config
@using BprDevKit.DataModelGenerator.Models
@using BprDevKit.DataModelGenerator.Services
@using BprDevKit.DatabaseManagement
@using BprDevKit.DatabaseManagement.Connections
@using BprDevKit.Localization
@using BprDevKit.Utility
@using ModelGenConfig = BprDevKit.Config.DataModelProfile
@using ServerConfig = BprDevKit.Config.ServerConfiguration
@inject ITranslationFactory TranslationFactory
@inject DatabaseManagerFactory DatabaseManagerFactory
@inject IJSRuntime JSRuntime

@{
    var t = TranslationFactory.Current;
}

<div class="model-generator-configuration-section">
    <!-- Header / Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="h5 fw-bold mb-1">
                <i class="bi bi-boxes text-primary me-2"></i>@t[TranslationKeys.ModelGeneratorConfigurationTab]
            </h3>
            <p class="text-muted small mb-0">@t[TranslationKeys.ModelProfilesCount]</p>
        </div>

        @if (!_isEditingProfile)
        {
            <button class="btn btn-primary shadow-sm" type="button" @onclick="CreateNewProfile">
                <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.DataModelProfileSaveAs]
            </button>
        }
        else
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" type="button" @onclick="CancelEditing">
                    @t[TranslationKeys.Cancel]
                </button>
                <button class="btn btn-success shadow-sm" type="button" @onclick="SaveCurrentProfile" disabled="@string.IsNullOrWhiteSpace(_editingProfile.ProfileName)">
                    <i class="bi bi-check-lg me-1"></i>@t[TranslationKeys.Save]
                </button>
            </div>
        }
    </div>

    <BprAlert Message="@_panelMessage" OnDismiss="() => _panelMessage = null" />

    @if (!_isEditingProfile)
    {
        <!-- Profiles List View -->
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control" placeholder="@t[TranslationKeys.Search]..." @bind="_filterText" @bind:event="oninput" />
                </div>
            </div>
        </div>

        @if (FilteredProfiles.Count == 0)
        {
            <div class="text-center py-5 text-muted card border shadow-sm">
                <i class="bi bi-bookmark-x display-4 opacity-50 d-block mb-3"></i>
                <h3 class="h6 mb-2">@t[TranslationKeys.DataModelNoProfileSelected]</h3>
                <p class="small mb-3 text-muted">@t[TranslationKeys.DataModelCreateProfilePrompt]</p>
                <div>
                    <button class="btn btn-primary btn-sm px-3" type="button" @onclick="CreateNewProfile">
                        <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.DataModelProfileSaveAs]
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var prof in FilteredProfiles)
                {
                    var isGlobal = !prof.ServerId.HasValue && string.IsNullOrWhiteSpace(prof.DatabaseName);
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border shadow-sm">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="h6 fw-bold mb-0 text-primary text-truncate" title="@prof.ProfileName">
                                        @prof.ProfileName
                                    </h3>
                                    <span class="badge text-bg-light border font-monospace">@prof.Options.Language</span>
                                </div>

                                <div class="small text-muted mb-3 flex-fill">
                                    <div class="mb-1">
                                        <i class="bi bi-hdd-network me-1"></i>
                                        @(string.IsNullOrWhiteSpace(prof.ServerName) ? t[TranslationKeys.DataModelProfileGlobal] : prof.ServerName)
                                    </div>
                                    <div class="mb-1">
                                        <i class="bi bi-database me-1"></i>
                                        @(string.IsNullOrWhiteSpace(prof.DatabaseName) ? t[TranslationKeys.DataModelProfileGlobal] : prof.DatabaseName)
                                    </div>
                                    @if (prof.Options.Language == DataModelLanguage.CSharp && prof.Options.CSharp.TransformRules.Count > 0)
                                    {
                                        <div class="mt-2">
                                            <span class="badge text-bg-info-subtle text-info">
                                                @prof.Options.CSharp.TransformRules.Count Transform Rules
                                            </span>
                                        </div>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <span class="small text-muted">
                                        @(prof.LastModifiedDate?.ToLocalTime().ToString("yyyy/MM/dd") ?? prof.CreateDate.ToLocalTime().ToString("yyyy/MM/dd"))
                                    </span>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" type="button" @onclick="() => EditProfile(prof)" title="@t[TranslationKeys.Edit]">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" type="button" @onclick="() => CloneProfile(prof)" title="Clone Profile">
                                            <i class="bi bi-copy"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" type="button" @onclick="() => DeleteProfile(prof)" title="@t[TranslationKeys.Delete]">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- Profile Editor View -->
        <div class="profile-editor card shadow-sm border-0 p-4 mb-4">
            <!-- Profile Metadata -->
            <div class="row g-3 mb-4 p-3 bg-light rounded border">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelProfileName] *</label>
                    <input type="text" class="form-control form-control-sm" placeholder="e.g. EF Core Domain Entities" @bind="_editingProfile.ProfileName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.ServerName] (Optional)</label>
                    <select class="form-select form-select-sm" @bind="_editingProfile.ServerId" @bind:after="OnProfileServerChanged">
                        <option value="">-- @t[TranslationKeys.DataModelProfileGlobal] --</option>
                        @foreach (var s in _servers)
                        {
                            <option value="@s.Id">@s.Server.ServerName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.Database] (Optional)</label>
                    @if (!_editingProfile.ServerId.HasValue)
                    {
                        <select class="form-select form-select-sm" disabled>
                            <option value="">-- @t[TranslationKeys.DataModelProfileGlobal] (@t[TranslationKeys.AllDatabases]) --</option>
                        </select>
                        <small class="text-muted d-block mt-1">@t[TranslationKeys.SelectServerFirstForDatabase]</small>
                    }
                    else if (_isLoadingDatabases)
                    {
                        <div class="d-flex align-items-center gap-2 py-1">
                            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                            <span class="small text-muted">@t[TranslationKeys.Loading]...</span>
                        </div>
                    }
                    else
                    {
                        <select class="form-select form-select-sm" @bind="_editingProfile.DatabaseName" @bind:after="OnProfileDatabaseChanged">
                            <option value="">-- @t[TranslationKeys.DataModelProfileGlobal] (@t[TranslationKeys.AllDatabases]) --</option>
                            @foreach (var db in _profileDatabases)
                            {
                                <option value="@db">@db</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.ZipPackagingStructure]</label>
                    <select class="form-select form-select-sm" @bind="_editingProfile.Options.ZipPackaging">
                        <option value="@ZipPackagingStructure.Flat">@t[TranslationKeys.ZipPackagingFlat]</option>
                        <option value="@ZipPackagingStructure.BySchema">@t[TranslationKeys.ZipPackagingBySchema]</option>
                        <option value="@ZipPackagingStructure.ByNamespace">@t[TranslationKeys.ZipPackagingByNamespace]</option>
                    </select>
                </div>
            </div>

            <!-- Language Selector -->
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 border-bottom pb-2">
                <label class="form-label small fw-bold mb-0">@t[TranslationKeys.DataModelLanguage]</label>
                <div class="btn-group btn-group-sm">
                    <button class="btn @(_editingProfile.Options.Language == DataModelLanguage.CSharp ? "btn-primary" : "btn-outline-secondary")"
                            type="button" @onclick="() => _editingProfile.Options.Language = DataModelLanguage.CSharp">
                        C# (.NET)
                    </button>
                    <button class="btn @(_editingProfile.Options.Language == DataModelLanguage.Python ? "btn-primary" : "btn-outline-secondary")"
                            type="button" @onclick="() => _editingProfile.Options.Language = DataModelLanguage.Python">
                        Python
                    </button>
                    <button class="btn @(_editingProfile.Options.Language == DataModelLanguage.Dart ? "btn-primary" : "btn-outline-secondary")"
                            type="button" @onclick="() => _editingProfile.Options.Language = DataModelLanguage.Dart">
                        Dart (Flutter)
                    </button>
                    <button class="btn @(_editingProfile.Options.Language == DataModelLanguage.Java ? "btn-primary" : "btn-outline-secondary")"
                            type="button" @onclick="() => _editingProfile.Options.Language = DataModelLanguage.Java">
                        Java
                    </button>
                    <button class="btn @(_editingProfile.Options.Language == DataModelLanguage.TypeScript ? "btn-primary" : "btn-outline-secondary")"
                            type="button" @onclick="() => _editingProfile.Options.Language = DataModelLanguage.TypeScript">
                        TypeScript
                    </button>
                </div>
            </div>

            @if (_editingProfile.Options.Language == DataModelLanguage.CSharp)
            {
                <!-- C# Sub-Tabs -->
                <ul class="nav nav-tabs mb-4">
                    <li class="nav-item">
                        <button class="nav-link @(_csActiveTab == "structure" ? "active fw-bold" : "")" type="button" @onclick='() => _csActiveTab = "structure"'>
                            <i class="bi bi-box me-1"></i>@t[TranslationKeys.DataModelCsStructureTab]
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link position-relative @(_csActiveTab == "schemaAccess" ? "active fw-bold" : "")" type="button" @onclick='() => SetCsActiveTab("schemaAccess")'>
                            <i class="bi bi-shield-check me-1"></i>@t[TranslationKeys.DataModelSchemaAccessTab]
                            @if (_editingProfile.Options.EnableSchemaAccessControl && _editingProfile.Options.SchemaAccessRules.Count > 0)
                            {
                                <span class="badge rounded-pill bg-primary ms-1">@_editingProfile.Options.SchemaAccessRules.Count</span>
                            }
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_csActiveTab == "namespace" ? "active fw-bold" : "")" type="button" @onclick='() => _csActiveTab = "namespace"'>
                            <i class="bi bi-diagram-2 me-1"></i>@t[TranslationKeys.DataModelCsNamespaceTab]
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_csActiveTab == "attributes" ? "active fw-bold" : "")" type="button" @onclick='() => _csActiveTab = "attributes"'>
                            <i class="bi bi-tags me-1"></i>@t[TranslationKeys.DataModelCsAttributesTab]
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_csActiveTab == "navigation" ? "active fw-bold" : "")" type="button" @onclick='() => _csActiveTab = "navigation"'>
                            <i class="bi bi-bezier2 me-1"></i>@t[TranslationKeys.DataModelCsNavFkTab]
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link position-relative @(_csActiveTab == "transform" ? "active fw-bold" : "")" type="button" @onclick='() => _csActiveTab = "transform"'>
                            <i class="bi bi-magic me-1"></i>@t[TranslationKeys.DataModelCsTransformTab]
                            @if (_editingProfile.Options.CSharp.TransformRules.Count > 0)
                            {
                                <span class="badge rounded-pill bg-danger ms-1">@_editingProfile.Options.CSharp.TransformRules.Count</span>
                            }
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_csActiveTab == "customSnippet" ? "active fw-bold" : "")" type="button" @onclick='() => _csActiveTab = "customSnippet"'>
                            <i class="bi bi-code-slash me-1"></i>@t[TranslationKeys.DataModelCsCustomSnippetTab]
                        </button>
                    </li>
                </ul>

                @if (_csActiveTab == "structure")
                {
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsTypeKind]</label>
                            <select class="form-select form-select-sm" @bind="_editingProfile.Options.CSharp.TypeKind">
                                <option value="class">@t[TranslationKeys.DataModelCsClass]</option>
                                <option value="record">@t[TranslationKeys.DataModelCsRecord]</option>
                                <option value="struct">@t[TranslationKeys.DataModelCsStruct]</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsAccessor]</label>
                            <select class="form-select form-select-sm" @bind="_editingProfile.Options.CSharp.PropertyAccessor">
                                <option value="get_set">@t[TranslationKeys.DataModelCsGetSet]</option>
                                <option value="get_init">@t[TranslationKeys.DataModelCsGetInit]</option>
                                <option value="backing_field">@t[TranslationKeys.DataModelCsBackingField]</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsStringInit]</label>
                            <select class="form-select form-select-sm" @bind="_editingProfile.Options.CSharp.StringInitialization">
                                <option value="EmptyString">@t[TranslationKeys.DataModelCsStringEmpty]</option>
                                <option value="NullForgiving">@t[TranslationKeys.DataModelCsStringNullForgiving]</option>
                                <option value="None">@t[TranslationKeys.DataModelCsStringNone]</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsBaseClass]</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. EntityBase" @bind="_editingProfile.Options.CSharp.BaseClass" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsInterfaces]</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. IAuditable, IEntity" @bind="_editingProfile.Options.CSharp.Interfaces" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsOverrideProperties]</label>
                            <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. Id, CreatedDate" @bind="_editingProfile.Options.CSharp.OverrideProperties" />
                        </div>

                        <div class="col-12"><hr class="my-2" /></div>

                        <div class="col-md-6">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="cs-p-partial" @bind="_editingProfile.Options.CSharp.IsPartial" />
                                <label class="form-check-label small" for="cs-p-partial">@t[TranslationKeys.DataModelCsIsPartial]</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="cs-p-null-ref" @bind="_editingProfile.Options.CSharp.NullableReferenceTypes" />
                                <label class="form-check-label small" for="cs-p-null-ref">@t[TranslationKeys.DataModelCsNullableRef]</label>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="cs-p-regions" @bind="_editingProfile.Options.CSharp.UseRegions" />
                                <label class="form-check-label small fw-bold" for="cs-p-regions">@t[TranslationKeys.DataModelCsUseRegions]</label>
                            </div>

                            @if (_editingProfile.Options.CSharp.UseRegions)
                            {
                                <div class="ps-3 border-start mb-2">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="cs-p-ctor" @bind="_editingProfile.Options.CSharp.IncludeConstructor" />
                                        <label class="form-check-label small" for="cs-p-ctor">@t[TranslationKeys.DataModelCsIncludeConstructor]</label>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small mb-1" for="cs-p-outer-region">@t[TranslationKeys.DataModelCsOuterRegionName]</label>
                                        <input type="text" id="cs-p-outer-region" class="form-control form-control-sm font-monospace" placeholder="e.g. Generator" @bind="_editingProfile.Options.CSharp.OuterRegionName" />
                                        <span class="text-muted" style="font-size: 0.72rem;">@t[TranslationKeys.DataModelCsOuterRegionHelp]</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="cs-p-dbcontext" @bind="_editingProfile.Options.CSharp.GenerateDbContext" />
                                <label class="form-check-label small fw-semibold" for="cs-p-dbcontext">@t[TranslationKeys.DataModelCsGenerateDbContext]</label>
                            </div>
                            @if (_editingProfile.Options.CSharp.GenerateDbContext)
                            {
                                <div class="ps-3 border-start mb-2">
                                    <div class="mb-2">
                                        <label class="form-label small mb-1">@t[TranslationKeys.DataModelCsDbContextName]</label>
                                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="AppDbContext" @bind="_editingProfile.Options.CSharp.DbContextName" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small mb-1">@t[TranslationKeys.DataModelCsDbContextNamespace]</label>
                                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. {Database}.Context or MyProject.Data" @bind="_editingProfile.Options.CSharp.DbContextNamespace" />
                                    </div>
                                    <div class="form-check form-switch mb-1">
                                        <input class="form-check-input" type="checkbox" id="cs-p-db-fqn" @bind="_editingProfile.Options.CSharp.DbContextUseFullyQualifiedModelNames" />
                                        <label class="form-check-label small" for="cs-p-db-fqn">@t[TranslationKeys.DataModelCsDbContextUseFullyQualified]</label>
                                    </div>
                                </div>
                            }

                            <div class="form-check form-switch mb-2 mt-3">
                                <input class="form-check-input" type="checkbox" id="cs-p-fluent" @bind="_editingProfile.Options.CSharp.GenerateEntityTypeConfigurations" />
                                <label class="form-check-label small fw-semibold" for="cs-p-fluent">@t[TranslationKeys.DataModelCsGenerateFluentApi]</label>
                            </div>
                            @if (_editingProfile.Options.CSharp.GenerateEntityTypeConfigurations)
                            {
                                <div class="ps-3 border-start mb-2">
                                    <div class="mb-2">
                                        <label class="form-label small mb-1">@t[TranslationKeys.DataModelCsEntityConfigNamespace]</label>
                                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. {Database}.Configurations" @bind="_editingProfile.Options.CSharp.EntityConfigurationNamespace" />
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- User-defined Class Constants -->
                        <div class="col-12 mt-3">
                            <div class="card p-3 border shadow-sm bg-white rounded-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="cs-p-consts" @bind="_editingProfile.Options.CSharp.IncludeConstants" @bind:after="EnsureInitialConstants" />
                                        <label class="form-check-label small fw-bold" for="cs-p-consts">@t[TranslationKeys.DataModelCsIncludeConstants]</label>
                                    </div>
                                    @if (_editingProfile.Options.CSharp.IncludeConstants)
                                    {
                                        <button class="btn btn-xs btn-outline-primary" type="button" @onclick="AddConstant">
                                            <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.DataModelAddConstant]
                                        </button>
                                    }
                                </div>

                                @if (_editingProfile.Options.CSharp.IncludeConstants)
                                {
                                    <div class="small text-muted mb-2">
                                        Available tokens:
                                        <code class="user-select-all cursor-pointer me-1" title="Click to copy token" @onclick='() => CopyToken("{TableName}")'>{TableName}</code>
                                        <code class="user-select-all cursor-pointer me-1" title="Click to copy token" @onclick='() => CopyToken("{SchemaName}")'>{SchemaName}</code>
                                        <code class="user-select-all cursor-pointer me-1" title="Click to copy token" @onclick='() => CopyToken("{ClassName}")'>{ClassName}</code>
                                        <code class="user-select-all cursor-pointer" title="Click to copy token" @onclick='() => CopyToken("{Database}")'>{Database}</code>
                                    </div>
                                    @if (_editingProfile.Options.CSharp.Constants.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered align-middle small mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 120px;">@t[TranslationKeys.DataModelConstantModifier]</th>
                                                        <th style="width: 110px;">@t[TranslationKeys.DataModelConstantType]</th>
                                                        <th style="width: 200px;">@t[TranslationKeys.DataModelConstantName]</th>
                                                        <th>@t[TranslationKeys.DataModelConstantValue]</th>
                                                        <th style="width: 45px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var c in _editingProfile.Options.CSharp.Constants)
                                                    {
                                                        var item = c;
                                                        <tr>
                                                            <td>
                                                                <select class="form-select form-select-sm" @bind="item.AccessModifier">
                                                                    <option value="public">public</option>
                                                                    <option value="private">private</option>
                                                                    <option value="internal">internal</option>
                                                                    <option value="protected">protected</option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="string" @bind="item.Type" />
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="TABLE_NAME" @bind="item.Name" />
                                                            </td>
                                                            <td>
                                                                <textarea class="form-control form-control-sm font-monospace" rows="1" style="min-height: 31px; resize: vertical;" placeholder='"{TableName}"' @bind="item.ValueTemplate"></textarea>
                                                            </td>
                                                            <td class="text-center">
                                                                <button class="btn btn-link btn-sm text-danger p-0" type="button" @onclick="() => RemoveConstant(item)">
                                                                    <i class="bi bi-trash3"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- User-defined Class Overrides (Properties & Methods) -->
                        <div class="col-12 mt-3">
                            <div class="card p-3 border shadow-sm bg-white rounded-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" id="cs-p-overrides-switch" @bind="_editingProfile.Options.CSharp.IncludeOverrides" @bind:after="EnsureInitialOverrides" />
                                        <label class="form-check-label small fw-bold" for="cs-p-overrides-switch">@t[TranslationKeys.DataModelCsIncludeOverrides]</label>
                                    </div>
                                    @if (_editingProfile.Options.CSharp.IncludeOverrides)
                                    {
                                        <button class="btn btn-xs btn-outline-primary" type="button" @onclick="AddOverride">
                                            <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.DataModelAddOverride]
                                        </button>
                                    }
                                </div>

                                @if (_editingProfile.Options.CSharp.IncludeOverrides)
                                {
                                    <div class="small text-muted mb-2">
                                        Available tokens: <code>{TableName}</code>, <code>{SchemaName}</code>, <code>{ClassName}</code>, <code>{Database}</code>
                                    </div>
                                    @if (_editingProfile.Options.CSharp.Overrides.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered align-middle small mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 105px;">@t[TranslationKeys.DataModelConstantModifier]</th>
                                                        <th style="width: 110px;">@t[TranslationKeys.DataModelOverrideKind]</th>
                                                        <th style="width: 110px;">@t[TranslationKeys.DataModelOverrideReturnType]</th>
                                                        <th style="width: 160px;">@t[TranslationKeys.DataModelOverrideName]</th>
                                                        <th style="width: 150px;">@t[TranslationKeys.DataModelOverrideParams]</th>
                                                        <th style="width: 80px;" class="text-center" title="@t[TranslationKeys.DataModelOverrideExpression]">@t[TranslationKeys.DataModelOverrideExpression]</th>
                                                        <th>@t[TranslationKeys.DataModelOverrideBody]</th>
                                                        <th style="width: 45px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var ov in _editingProfile.Options.CSharp.Overrides)
                                                    {
                                                        var item = ov;
                                                        <tr>
                                                            <td>
                                                                <select class="form-select form-select-sm" @bind="item.AccessModifier">
                                                                    <option value="public">public</option>
                                                                    <option value="protected">protected</option>
                                                                    <option value="internal">internal</option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <select class="form-select form-select-sm" @bind="item.MemberKind">
                                                                    <option value="Property">@t[TranslationKeys.DataModelOverrideProperty]</option>
                                                                    <option value="Method">@t[TranslationKeys.DataModelOverrideMethod]</option>
                                                                </select>
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="string" @bind="item.ReturnType" />
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="TableName" @bind="item.Name" />
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. int id" @bind="item.Parameters" disabled="@(item.MemberKind != "Method")" />
                                                            </td>
                                                            <td class="text-center">
                                                                <input class="form-check-input" type="checkbox" @bind="item.IsExpressionBodied" title="@t[TranslationKeys.DataModelOverrideExpression]" />
                                                            </td>
                                                            <td>
                                                                <textarea class="form-control form-control-sm font-monospace" rows="2" style="min-height: 38px; resize: vertical;" placeholder='@(item.IsExpressionBodied ? "\"{TableName}\"" : "return \"{TableName}\";")' @bind="item.Body"></textarea>
                                                            </td>
                                                            <td class="text-center">
                                                                <button class="btn btn-link btn-sm text-danger p-0" type="button" @onclick="() => RemoveOverride(item)">
                                                                    <i class="bi bi-trash3"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (_csActiveTab == "schemaAccess")
                {
                    <div class="card p-3 border shadow-sm bg-white rounded-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div>
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" id="enableSchemaAccess" @bind="_editingProfile.Options.EnableSchemaAccessControl" />
                                    <label class="form-check-label fw-bold" for="enableSchemaAccess">@t[TranslationKeys.DataModelEnableSchemaAccess]</label>
                                </div>
                                <p class="text-muted small mb-0">@t[TranslationKeys.DataModelSchemaAccessHelp]</p>
                            </div>
                            @if (_editingProfile.Options.EnableSchemaAccessControl)
                            {
                                <div class="d-flex gap-2">
                                    @if (_editingProfile.ServerId.HasValue && !string.IsNullOrWhiteSpace(_editingProfile.DatabaseName))
                                    {
                                        <button class="btn btn-outline-primary btn-sm" type="button" @onclick="DetectSchemasFromDb" disabled="@_isLoadingSchemas">
                                            @if (_isLoadingSchemas)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-repeat me-1"></i>
                                            }
                                            @t[TranslationKeys.DataModelFetchSchemasFromDb]
                                        </button>
                                    }
                                    <button class="btn btn-primary btn-sm" type="button" @onclick="OpenAddSchemaRuleModal" disabled="@(!_editingProfile.ServerId.HasValue || string.IsNullOrWhiteSpace(_editingProfile.DatabaseName) || _isLoadingSchemas)">
                                        <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.DataModelAddSchemaRule]
                                    </button>
                                </div>
                            }
                        </div>

                        @if (_editingProfile.Options.EnableSchemaAccessControl)
                        {
                            @if (!_editingProfile.ServerId.HasValue || string.IsNullOrWhiteSpace(_editingProfile.DatabaseName))
                            {
                                <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                                    <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
                                    <span>@t[TranslationKeys.DataModelSchemaAccessServerDbRequired]</span>
                                </div>
                            }
                            else if (_isLoadingSchemas && _dbSchemas.Count == 0)
                            {
                                <div class="d-flex align-items-center gap-2 text-muted small py-2 mb-3">
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Loading database schemas...</span>
                                </div>
                            }
                            else if (_dbSchemas.Count == 0)
                            {
                                <div class="alert alert-info py-2 px-3 small d-flex align-items-center justify-content-between gap-2 mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                                        <span>Click to fetch database schemas from <strong>@_editingProfile.DatabaseName</strong>.</span>
                                    </div>
                                    <button class="btn btn-sm btn-info text-white" type="button" @onclick="() => LoadSchemasForDatabase(silent: false)" disabled="@_isLoadingSchemas">
                                        <i class="bi bi-download me-1"></i>@t[TranslationKeys.DataModelFetchSchemasFromDb]
                                    </button>
                                </div>
                            }

                            @if (_showAddSchemaRuleModal)
                            {
                                <div class="card p-3 mb-3 border-primary shadow-sm bg-light-subtle">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small fw-bold text-primary">
                                            <i class="bi bi-shield-plus me-1"></i>@t[TranslationKeys.DataModelAddSchemaRule]
                                        </span>
                                        <button class="btn btn-sm btn-link text-muted p-0" type="button" @onclick="() => _showAddSchemaRuleModal = false">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>

                                    <div class="row g-2 mb-3">
                                        <div class="col-md-5">
                                            <label class="form-label small mb-1 fw-semibold">@t[TranslationKeys.DataModelSourceSchema] *</label>
                                            @if (_dbSchemas.Count > 0)
                                            {
                                                <select class="form-select form-select-sm font-monospace" @bind="_newSourceSchema">
                                                    <option value="">-- @t[TranslationKeys.DataModelSelectSchema] --</option>
                                                    @foreach (var s in _dbSchemas)
                                                    {
                                                        <option value="@s">@s</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. dbo" @bind="_newSourceSchema" />
                                            }
                                        </div>
                                        <div class="col-md-7">
                                            <label class="form-label small mb-1 fw-semibold">@t[TranslationKeys.DataModelAllowedTargetSchemas]</label>
                                            <div class="input-group input-group-sm">
                                                @if (_dbSchemas.Count > 0)
                                                {
                                                    <select class="form-select font-monospace" @bind="_modalSelectedTargetSchema">
                                                        <option value="">-- @t[TranslationKeys.DataModelSelectTargetSchemaPrompt] --</option>
                                                        @foreach (var s in _dbSchemas.Where(x => !string.Equals(x, _newSourceSchema, StringComparison.OrdinalIgnoreCase) && !_modalSelectedTargetSchemasList.Contains(x, StringComparer.OrdinalIgnoreCase)))
                                                        {
                                                            <option value="@s">@s</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control font-monospace" placeholder="e.g. Mat" @bind="_modalSelectedTargetSchema" />
                                                }
                                                <button class="btn btn-outline-primary" type="button" @onclick="AddModalTargetSchema" disabled="@string.IsNullOrWhiteSpace(_modalSelectedTargetSchema)">
                                                    <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.Add]
                                                </button>
                                            </div>
                                            @if (_modalSelectedTargetSchemasList.Count > 0)
                                            {
                                                <div class="d-flex flex-wrap gap-1 mt-2">
                                                    @foreach (var target in _modalSelectedTargetSchemasList)
                                                    {
                                                        var targetSchema = target;
                                                        <span class="badge text-bg-primary-subtle text-primary border font-monospace d-inline-flex align-items-center gap-1">
                                                            @targetSchema
                                                            <i class="bi bi-x cursor-pointer" @onclick="() => _modalSelectedTargetSchemasList.Remove(targetSchema)"></i>
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <small class="text-muted d-block mt-1">@t[TranslationKeys.DataModelIsolatedSchema]</small>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => _showAddSchemaRuleModal = false">
                                            @t[TranslationKeys.Cancel]
                                        </button>
                                        <button class="btn btn-primary btn-sm" type="button" @onclick="SaveSchemaRule" disabled="@string.IsNullOrWhiteSpace(_newSourceSchema)">
                                            <i class="bi bi-check-lg me-1"></i>@t[TranslationKeys.Save]
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (_editingProfile.Options.SchemaAccessRules.Count == 0)
                            {
                                <div class="p-4 text-center text-muted small bg-light rounded border">
                                    <i class="bi bi-shield-slash fs-4 d-block mb-2 text-secondary opacity-50"></i>
                                    No schema rules defined. Click "@t[TranslationKeys.DataModelAddSchemaRule]" or "@t[TranslationKeys.DataModelFetchSchemasFromDb]".
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var rule in _editingProfile.Options.SchemaAccessRules)
                                    {
                                        var currentRule = rule;
                                        if (!_quickAddTarget.ContainsKey(currentRule.Id))
                                        {
                                            _quickAddTarget[currentRule.Id] = string.Empty;
                                        }
                                        <div class="col-md-6 col-lg-4">
                                            <div class="card h-100 p-3 border shadow-sm bg-white">
                                                <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <i class="bi bi-shield-shaded text-primary"></i>
                                                        <strong class="font-monospace text-primary fs-6">[@currentRule.SourceSchema]</strong>
                                                    </div>
                                                    <button class="btn btn-link btn-sm text-danger p-0" type="button" @onclick="() => DeleteSchemaRule(currentRule)" title="@t[TranslationKeys.Delete]">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </div>

                                                <div class="small mb-3">
                                                    <span class="text-muted d-block mb-1 fw-semibold">@t[TranslationKeys.DataModelAllowedTargetSchemas]:</span>
                                                    @if (currentRule.AllowedTargetSchemas.Count == 0)
                                                    {
                                                        <span class="badge text-bg-secondary-subtle text-secondary border">
                                                            <i class="bi bi-slash-circle me-1"></i>@t[TranslationKeys.DataModelIsolatedSchema]
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex flex-wrap gap-1">
                                                            @foreach (var target in currentRule.AllowedTargetSchemas)
                                                            {
                                                                var targetSchema = target;
                                                                <span class="badge text-bg-primary-subtle text-primary border font-monospace d-inline-flex align-items-center gap-1">
                                                                    @targetSchema
                                                                    <i class="bi bi-x cursor-pointer" @onclick="() => RemoveTargetSchemaFromRule(currentRule, targetSchema)"></i>
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                <div class="mt-auto pt-2 border-top">
                                                    <div class="input-group input-group-sm">
                                                        <select class="form-select font-monospace" @bind="_quickAddTarget[currentRule.Id]">
                                                            <option value="">-- @t[TranslationKeys.DataModelSelectTargetSchemaPrompt] --</option>
                                                            @foreach (var s in _dbSchemas.Where(x => !string.Equals(x, currentRule.SourceSchema, StringComparison.OrdinalIgnoreCase) && !currentRule.AllowedTargetSchemas.Contains(x, StringComparer.OrdinalIgnoreCase)))
                                                            {
                                                                <option value="@s">@s</option>
                                                            }
                                                        </select>
                                                        <button class="btn btn-outline-primary" type="button" @onclick="() => AddTargetSchemaToRule(currentRule)" disabled="@string.IsNullOrWhiteSpace(_quickAddTarget[currentRule.Id])">
                                                            <i class="bi bi-plus-lg"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
                else if (_csActiveTab == "namespace")
                {
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold mb-2">@t[TranslationKeys.DataModelNamespaceMode]</label>
                            <div class="btn-group btn-group-sm d-flex mb-3" style="max-width: 520px;">
                                <button type="button" class="btn @(_editingProfile.Options.CSharp.NamespaceMode != "PerSchema" ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                        @onclick='() => _editingProfile.Options.CSharp.NamespaceMode = "Single"'>
                                    <i class="bi bi-box me-1"></i>@t[TranslationKeys.DataModelNamespaceModeSingle]
                                </button>
                                <button type="button" class="btn @(_editingProfile.Options.CSharp.NamespaceMode == "PerSchema" ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                        @onclick='() => _editingProfile.Options.CSharp.NamespaceMode = "PerSchema"'>
                                    <i class="bi bi-diagram-3 me-1"></i>@t[TranslationKeys.DataModelNamespaceModePerSchema]
                                </button>
                            </div>
                        </div>

                        @if (_editingProfile.Options.CSharp.NamespaceMode != "PerSchema")
                        {
                            <div class="col-12">
                                <div class="card p-3 bg-light border-0">
                                    <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsNamespace]</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="MyProject.Models" @bind="_editingProfile.Options.CSharp.Namespace" />
                                    <div class="small text-muted mt-1">
                                        Available tokens:
                                        <code class="user-select-all cursor-pointer me-1" @onclick='() => AppendSingleNsToken("{Database}")'>{Database}</code>
                                        <code class="user-select-all cursor-pointer me-1" @onclick='() => AppendSingleNsToken("{Schema}")'>{Schema}</code>
                                        <code class="user-select-all cursor-pointer" @onclick='() => AppendSingleNsToken("{Table}")'>{Table}</code>
                                    </div>
                                    <div class="small text-muted mt-1">@t[TranslationKeys.DataModelNamespaceSingleHelp]</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="card p-3 bg-light border-0">
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelSchemaNamespacePattern]</label>
                                        <input type="text" class="form-control form-control-sm font-monospace" placeholder="{Database}.{Schema}.DataModel" @bind="_editingProfile.Options.CSharp.SchemaNamespacePattern" />
                                        <div class="small text-muted mt-1">
                                            Available tokens:
                                            <code class="user-select-all cursor-pointer me-1" @onclick='() => AppendSchemaNsToken("{Database}")'>{Database}</code>
                                            <code class="user-select-all cursor-pointer me-1" @onclick='() => AppendSchemaNsToken("{Schema}")'>{Schema}</code>
                                            <code class="user-select-all cursor-pointer" @onclick='() => AppendSchemaNsToken("{Table}")'>{Table}</code>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label small fw-semibold mb-0">@t[TranslationKeys.DataModelExplicitSchemaNamespaces]</label>
                                        <button class="btn btn-xs btn-outline-primary" type="button" @onclick="AddSchemaNamespaceMapping">
                                            <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.Add]
                                        </button>
                                    </div>

                                    @if (_editingProfile.Options.CSharp.SchemaNamespaceMappings.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered bg-white align-middle small mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 35%;">@t[TranslationKeys.SchemaName]</th>
                                                        <th>@t[TranslationKeys.DataModelCsNamespace]</th>
                                                        <th style="width: 45px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var map in _editingProfile.Options.CSharp.SchemaNamespaceMappings)
                                                    {
                                                        var m = map;
                                                        <tr>
                                                            <td>
                                                                @if (_dbSchemas.Count > 0)
                                                                {
                                                                    <select class="form-select form-select-sm font-monospace" @bind="m.SchemaName">
                                                                        <option value="">-- @t[TranslationKeys.DataModelSelectSchema] --</option>
                                                                        @foreach (var s in _dbSchemas)
                                                                        {
                                                                            <option value="@s">@s</option>
                                                                        }
                                                                    </select>
                                                                }
                                                                else
                                                                {
                                                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. SysMan" @bind="m.SchemaName" />
                                                                }
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. BexSys.SysMan.DataModel" @bind="m.Namespace" />
                                                            </td>
                                                            <td class="text-center">
                                                                <button class="btn btn-link btn-sm text-danger p-0" type="button" @onclick="() => RemoveSchemaNamespaceMapping(m)">
                                                                    <i class="bi bi-trash3"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsCustomUsings]</label>
                            <textarea class="form-control form-control-sm font-monospace" rows="4" placeholder="@("MyCompany.Data;\nMyCompany.Core;")" @bind="_editingProfile.Options.CSharp.CustomUsings"></textarea>
                        </div>
                    </div>
                }
                else if (_csActiveTab == "attributes")
                {
                    <div class="row g-3">
                        <!-- Master Switch Header -->
                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 border">
                                <div>
                                    <div class="form-check form-switch mb-1">
                                        <input class="form-check-input" type="checkbox" id="cs-p-ann" @bind="_editingProfile.Options.CSharp.IncludeDataAnnotations" />
                                        <label class="form-check-label fw-bold" for="cs-p-ann">
                                            <i class="bi bi-shield-check text-primary me-1"></i>@t[TranslationKeys.DataModelCsAnnotationsManagement]
                                        </label>
                                    </div>
                                    <div class="text-muted small">@t[TranslationKeys.DataModelCsAnnotationsManagementDesc]</div>
                                </div>
                                <span class="badge @(_editingProfile.Options.CSharp.IncludeDataAnnotations ? "text-bg-success" : "text-bg-secondary")">
                                    @(_editingProfile.Options.CSharp.IncludeDataAnnotations ? "Active" : "Disabled")
                                </span>
                            </div>
                        </div>

                        <!-- Data Annotations Cards -->
                        @if (_editingProfile.Options.CSharp.IncludeDataAnnotations)
                        {
                            <!-- Required Attribute Card -->
                            <div class="col-md-6">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" id="cs-p-req" @bind="_editingProfile.Options.CSharp.IncludeRequiredAttribute" />
                                            <label class="form-check-label fw-semibold small" for="cs-p-req">
                                                <code class="text-danger fw-bold me-1">[Required]</code>@t[TranslationKeys.DataModelCsRequiredAttribute]
                                            </label>
                                        </div>
                                    </div>
                                    <div class="card-body p-3 @(!_editingProfile.Options.CSharp.IncludeRequiredAttribute ? "opacity-50 pointer-events-none" : "")">
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsRequiredScope]</label>
                                            <select class="form-select form-select-sm" @bind="_editingProfile.Options.CSharp.RequiredAttributeScope" disabled="@(!_editingProfile.Options.CSharp.IncludeRequiredAttribute)">
                                                <option value="AllNonNullable">@t[TranslationKeys.DataModelCsRequiredScopeAll]</option>
                                                <option value="StringsAndByteArrays">@t[TranslationKeys.DataModelCsRequiredScopeStrings]</option>
                                                <option value="NonIdentity">@t[TranslationKeys.DataModelCsRequiredScopeNonIdentity]</option>
                                            </select>
                                        </div>

                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" id="cs-p-req-pk" @bind="_editingProfile.Options.CSharp.RequiredIncludePrimaryKeys" disabled="@(!_editingProfile.Options.CSharp.IncludeRequiredAttribute)" />
                                            <label class="form-check-label small" for="cs-p-req-pk">@t[TranslationKeys.DataModelCsRequiredIncludePk]</label>
                                        </div>

                                        <div>
                                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsRequiredErrorMsg]</label>
                                            <input type="text" class="form-control form-control-sm font-monospace mb-1" placeholder='e.g. {PropertyName} is required.' @bind="_editingProfile.Options.CSharp.RequiredErrorMessageTemplate" disabled="@(!_editingProfile.Options.CSharp.IncludeRequiredAttribute)" />
                                            <div class="small text-muted" style="font-size: 0.72rem;">
                                                @t[TranslationKeys.DataModelCsRequiredErrorMsgHint]
                                                <span class="ms-1">
                                                    <code class="user-select-all cursor-pointer me-1" @onclick='() => AppendRequiredErrorToken("{PropertyName}")'>{PropertyName}</code>
                                                    <code class="user-select-all cursor-pointer" @onclick='() => AppendRequiredErrorToken("{ColumnName}")'>{ColumnName}</code>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Column & String Length Card -->
                            <div class="col-md-6">
                                <div class="card h-100 border shadow-sm">
                                    <div class="card-header bg-white py-2">
                                        <span class="small fw-semibold">
                                            <code class="text-primary fw-bold me-1">[Column]</code> &amp; <code class="text-primary fw-bold me-1">[StringLength]</code>
                                        </span>
                                    </div>
                                    <div class="card-body p-3">
                                        <!-- Column Placement Mode -->
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold mb-1">@t[TranslationKeys.DataModelCsColumnMode]</label>
                                            <select class="form-select form-select-sm" @bind="_editingProfile.Options.CSharp.ColumnAttributeMode">
                                                <option value="WhenNameDiffers">@t[TranslationKeys.DataModelCsColumnModeDiffers]</option>
                                                <option value="Always">@t[TranslationKeys.DataModelCsColumnModeAlways]</option>

@using System.Data
@using System.Globalization
@using BprDevKit.Config
@using BprDevKit.DatabaseManagement.Models.Operations
@using BprDevKit.DatabaseManagement
@using BprDevKit.Utility
@using BprDevKit.Localization
@inject DatabaseManagerFactory DatabaseManagerFactory
@inject ITranslationFactory TranslationFactory
@inject IJSRuntime JS

@{
    var t = TranslationFactory.Current;
}

<div class="triggers-management">
    <div class="triggers-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h5 mb-1"><i class="bi bi-lightning-charge text-primary me-2"></i>@t[TranslationKeys.Triggers]</h2>
            <p class="text-muted small mb-0">@t[TranslationKeys.TriggerTabSubtitle]</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="RefreshTriggers" disabled="@(_isLoading || string.IsNullOrWhiteSpace(_selectedDatabase))">
                <i class="bi bi-arrow-clockwise me-1"></i>@t[TranslationKeys.Refresh]
            </button>
            <button class="btn btn-primary btn-sm" type="button" @onclick="OpenCreate" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase) || _isLoading)">
                <i class="bi bi-plus-lg me-1"></i>@t[TranslationKeys.TriggerTabCreateTrigger]
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-end">
                <div class="col-md">
                    <label class="form-label small text-muted mb-1" for="trigger-db-select">@t[TranslationKeys.Databases]</label>
                    <select id="trigger-db-select" class="form-select form-select-sm" value="@_selectedDatabase" @onchange="OnDatabaseChanged">
                        <option value="">@t[TranslationKeys.SchemaTabSelectDbPrompt]</option>
                        @foreach (var db in _databases)
                        {
                            <option value="@db">@db</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1" for="trigger-schema-filter">@t[TranslationKeys.Schemas]</label>
                    <select id="trigger-schema-filter" class="form-select form-select-sm" @bind="_selectedSchemaFilter" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase))">
                        <option value="">@t[TranslationKeys.TableTabAllSchemas]</option>
                        @foreach (var schema in _schemas)
                        {
                            <option value="@schema">@schema</option>
                        }
                    </select>
                </div>
                <div class="col-md">
                    <label class="form-label small text-muted mb-1" for="trigger-search">@t[TranslationKeys.Search]</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="trigger-search" class="form-control" placeholder="@t[TranslationKeys.Search]" @bind="_searchFilter" @bind:event="oninput" disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase))" />
                    </div>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center justify-content-center"
                            style="width: 34px; height: 31px;"
                            type="button"
                            @onclick="RefreshTriggers"
                            disabled="@(_isLoading || string.IsNullOrWhiteSpace(_selectedDatabase))"
                            title="@t[TranslationKeys.Refresh]">
                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
                        </svg>
                    </button>
                    <button class="btn btn-outline-danger btn-sm d-inline-flex align-items-center justify-content-center"
                            style="width: 34px; height: 31px;"
                            type="button"
                            @onclick="ClearSelection"
                            disabled="@(string.IsNullOrWhiteSpace(_selectedDatabase))"
                            title="@t[TranslationKeys.Clear]">
                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <BprAlert Message="@_bprMessage" OnDismiss="ClearMessage" CssClass="mb-4" />

    @if (string.IsNullOrWhiteSpace(_selectedDatabase))
    {
        <div class="text-center text-muted py-5 border rounded bg-light">
            <i class="bi bi-database display-6 d-block mb-2 text-secondary"></i>
            <p class="mb-0">@t[TranslationKeys.SchemaTabSelectDbToManage]</p>
        </div>
    }
    else if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@t[TranslationKeys.Loading]</span>
            </div>
        </div>
    }
    else if (_triggers.Count == 0)
    {
        <div class="text-center text-muted py-4 border rounded bg-light">
            <p class="mb-0">@t[TranslationKeys.TriggerTabNoTriggersFound]</p>
        </div>
    }
    else if (FilteredTriggers.Count == 0)
    {
        <div class="text-center text-muted py-4 border rounded bg-light">
            <p class="mb-0">@t[TranslationKeys.TriggerTabNoMatchFilter]</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 3.5rem;">#</th>
                            <th style="width: 10rem;">@t[TranslationKeys.SchemaName]</th>
                            <th>@t[TranslationKeys.Name]</th>
                            <th style="width: 14rem;">@t[TranslationKeys.TriggerTabTableName]</th>
                            <th style="width: 9rem;">@t[TranslationKeys.TriggerTabTiming]</th>
                            <th style="width: 11rem;">@t[TranslationKeys.TriggerTabEvents]</th>
                            <th style="width: 7rem;">@t[TranslationKeys.Status]</th>
                            <th style="width: 10rem;">@t[TranslationKeys.LastModified]</th>
                            <th style="width: 9rem;" class="text-end">@t[TranslationKeys.Actions]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var index = 1; }
                        @foreach (var trig in FilteredTriggers)
                        {
                            <tr>
                                <td class="text-muted small">@(index++)</td>
                                <td>
                                    <span class="badge text-bg-light border font-monospace">@trig.SchemaName</span>
                                </td>
                                <td>
                                    <strong class="font-monospace text-primary">@trig.TriggerName</strong>
                                    @if (trig.IsEncrypted)
                                    {
                                        <span class="badge text-bg-warning ms-1" title="@t[TranslationKeys.CommonEncrypted]">
                                            <i class="bi bi-lock-fill me-1"></i>@t[TranslationKeys.CommonEncrypted]
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(trig.TableName))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1" style="color: #212529 !important; background-color: #f8f9fa !important;">
                                            <i class="bi bi-table me-1 text-primary"></i>@(string.IsNullOrWhiteSpace(trig.TableSchema) ? trig.TableName : $"{trig.TableSchema}.{trig.TableName}")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(trig.IsInsteadOfTrigger ? "text-bg-info" : "text-bg-light border")">
                                        @(trig.IsInsteadOfTrigger ? "INSTEAD OF" : "AFTER")
                                    </span>
                                </td>
                                <td>
                                    <span class="small font-monospace text-muted">@trig.TriggerEvents</span>
                                </td>
                                <td>
                                    @if (trig.IsDisabled)
                                    {
                                        <span class="badge text-bg-danger">@t[TranslationKeys.TriggerTabDisabled]</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">@t[TranslationKeys.TriggerTabEnabled]</span>
                                    }
                                </td>
                                <td class="text-muted small">@FormatDate(trig.ModifyDate)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" type="button" title="@(trig.IsDisabled ? t[TranslationKeys.TriggerTabEnable] : t[TranslationKeys.TriggerTabDisable])" @onclick="() => ToggleTriggerState(trig)" disabled="@_isSaving">
                                            <i class="bi @(trig.IsDisabled ? "bi-toggle-off text-danger" : "bi-toggle-on text-success")"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" type="button" title="@t[TranslationKeys.TriggerTabBody]" @onclick="() => OpenTriggerDefinition(trig)" disabled="@_isSaving">
                                            <i class="bi bi-code-slash"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" type="button" title="@t[TranslationKeys.Delete]" @onclick="() => OpenDrop(trig)" disabled="@_isSaving">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_showCreateModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-plus-circle me-2 text-primary"></i>@t[TranslationKeys.TriggerTabCreateTrigger]</h5>
                        <button type="button" class="btn-close" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        <BprAlert Message="@_modalBprMessage" OnDismiss="() => _modalBprMessage = null" CssClass="py-2 px-3 mb-3 small" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-trig-schema">@t[TranslationKeys.SchemaName]</label>
                                <select id="new-trig-schema" class="form-select form-select-sm" @bind="_createModel.SchemaName">
                                    @foreach (var schema in _schemas)
                                    {
                                        <option value="@schema">@schema</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-trig-name">@t[TranslationKeys.Name]</label>
                                <input id="new-trig-name" class="form-control form-control-sm font-monospace" maxlength="@(ServerConfig?.Database?.MaxTableNameLength ?? Constants.MaxTableNameLength)" placeholder="trg_MyTrigger" @bind="_createModel.TriggerName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-trig-table">@t[TranslationKeys.TriggerTabTableName]</label>
                                <select id="new-trig-table" class="form-select form-select-sm" @bind="_createModel.TableName">
                                    <option value="">-- @t[TranslationKeys.TriggerTabTableName] --</option>
                                    @foreach (var tbl in _tableNames)
                                    {
                                        <option value="@tbl">@tbl</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="new-trig-timing">@t[TranslationKeys.TriggerTabTiming]</label>
                                <select id="new-trig-timing" class="form-select form-select-sm" @bind="_createModel.Timing">
                                    <option value="AFTER">AFTER / FOR</option>
                                    <option value="INSTEAD OF">INSTEAD OF</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold d-block">@t[TranslationKeys.TriggerTabEvents]</label>
                                <div class="d-flex gap-3 mt-1">
                                    <div class="form-check">
                                        <input id="trig-event-insert" class="form-check-input" type="checkbox" @bind="_createModel.OnInsert" />
                                        <label class="form-check-label small" for="trig-event-insert">INSERT</label>
                                    </div>
                                    <div class="form-check">
                                        <input id="trig-event-update" class="form-check-input" type="checkbox" @bind="_createModel.OnUpdate" />
                                        <label class="form-check-label small" for="trig-event-update">UPDATE</label>
                                    </div>
                                    <div class="form-check">
                                        <input id="trig-event-delete" class="form-check-input" type="checkbox" @bind="_createModel.OnDelete" />
                                        <label class="form-check-label small" for="trig-event-delete">DELETE</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold d-block">&nbsp;</label>
                                <div class="form-check mt-1">
                                    <input id="new-trig-encryption" class="form-check-input" type="checkbox" @bind="_createModel.WithEncryption" />
                                    <label class="form-check-label small" for="new-trig-encryption">@t[TranslationKeys.TriggerTabWithEncryption]</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold" for="new-trig-body">@t[TranslationKeys.TriggerTabBody]</label>
                                <textarea id="new-trig-body" class="form-control font-monospace" rows="12" placeholder="AS&#10;BEGIN&#10;    SET NOCOUNT ON;&#10;    -- Your logic here&#10;END" @bind="_createModel.Body"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Cancel]</button>
                        <button type="button" class="btn btn-sm btn-success" @onclick="ExecuteCreateTrigger" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_createModel.TriggerName) || string.IsNullOrWhiteSpace(_createModel.TableName) || string.IsNullOrWhiteSpace(_createModel.Body))">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @t[TranslationKeys.Create]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showDefinitionModal && _selectedTrigger is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog @(_isFullScreen ? "modal-fullscreen" : "modal-lg") modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header d-flex align-items-center justify-content-between flex-row" style="direction: ltr !important;">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="modal-title font-monospace mb-0" style="direction: ltr; text-align: left;"><i class="bi bi-lightning-charge me-2 text-primary"></i>@($"{_selectedTrigger.SchemaName}.{_selectedTrigger.TriggerName}")</h5>
                            @if (!string.IsNullOrWhiteSpace(_selectedTrigger.TableName))
                            {
                                <span class="badge bg-light text-dark border font-monospace px-2 py-1" style="color: #212529 !important; background-color: #f8f9fa !important; font-size: 0.85rem;" title="@t[TranslationKeys.TriggerTabTableName]">
                                    <i class="bi bi-table me-1 text-primary"></i>@(string.IsNullOrWhiteSpace(_selectedTrigger.TableSchema) ? _selectedTrigger.TableName : $"{_selectedTrigger.TableSchema}.{_selectedTrigger.TableName}")
                                </span>
                            }
                            @if (_selectedTrigger.IsEncrypted)
                            {
                                if (_isDecrypted)
                                {
                                    <span class="badge text-bg-success"><i class="bi bi-unlock-fill me-1"></i>@t[TranslationKeys.CommonDecrypted]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning"><i class="bi bi-lock-fill me-1"></i>@t[TranslationKeys.CommonEncrypted]</span>
                                }
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2 ms-auto" style="direction: ltr;">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 d-inline-flex align-items-center justify-content-center"
                                    @onclick="ToggleFullScreen"
                                    title="@t[_isFullScreen ? TranslationKeys.CommonExitFullScreen : TranslationKeys.CommonFullScreen]"
                                    style="min-width: 2rem; height: 1.85rem;">
                                @if (_isFullScreen)
                                {
                                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M3 0a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h1v-1H3a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1h1V2a2 2 0 0 0-2-2z"/>
                                        <path d="M5 4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-1 2a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M1.5 1a.5.5 0 0 0-.5.5v13a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-13a.5.5 0 0 0-.5-.5zM2 2h12v12H2z"/>
                                    </svg>
                                }
                            </button>
                            <button type="button" class="btn-close m-0" @onclick="CloseModals" aria-label="@t[TranslationKeys.Close]"></button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <BprAlert Message="@_modalBprMessage" OnDismiss="() => _modalBprMessage = null" CssClass="py-2 px-3 mb-3 small" />


                        @if (_isLoadingDefinition)
                        {
                            <div class="text-center py-4">
                                <span class="spinner-border spinner-border-sm text-primary me-2"></span>
                                <span class="text-muted small">@t[TranslationKeys.Loading]</span>
                            </div>
                        }
                        else
                        {
                            @if (_selectedTrigger.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition))
                            {
                                <div class="alert alert-warning border-warning-subtle shadow-sm mb-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <i class="bi bi-shield-lock-fill text-warning fs-3 mt-1"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="alert-heading fw-bold mb-1">@t[TranslationKeys.CommonEncrypted]</h6>
                                            <p class="small mb-3">@t[TranslationKeys.CommonEncryptedNotice]</p>

                                            @if (_isDacRequired)
                                            {
                                                <div class="alert alert-info py-2 px-3 small border-0 mb-3">
                                                    <i class="bi bi-info-circle-fill me-2"></i>@t[TranslationKeys.CommonDacRequiredPrompt]
                                                    <div class="mt-2">
                                                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="ExecuteEnableRemoteDac" disabled="@_isEnablingDac">
                                                            @if (_isEnablingDac)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                                <span>@t[TranslationKeys.CommonEnablingRemoteDac]</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-shield-check me-1"></i>
                                                                <span>@t[TranslationKeys.CommonEnableRemoteDac]</span>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            <div>
                                                <button class="btn btn-warning btn-sm fw-semibold shadow-sm" type="button" @onclick="ExecuteDecryptTrigger" disabled="@_isDecrypting">
                                                    @if (_isDecrypting)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                        <span>@t[TranslationKeys.CommonDecrypting]</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-unlock-fill me-1"></i>
                                                        <span>@t[TranslationKeys.CommonDecryptObject]</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">@t[TranslationKeys.TriggerTabBody]</label>
                                <textarea class="form-control font-monospace" rows="@(_isFullScreen ? 26 : 14)" @bind="_editDefinition" @bind:event="oninput"></textarea>
                            </div>
                        }
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(_editDefinition))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyDefinitionToClipboard" title="@t[TranslationKeys.CommonCopy]">
                                    @if (_isCopied)
                                    {
                                        <i class="bi bi-check-lg text-success me-1"></i>
                                        <span class="text-success small fw-semibold">@t[TranslationKeys.CommonCopied]</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-clipboard me-1"></i>
                                        <span>@t[TranslationKeys.CommonCopy]</span>
                                    }
                                </button>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Close]</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ExecuteAlterTrigger" disabled="@(_isSaving || _isLoadingDefinition || string.IsNullOrWhiteSpace(_editDefinition) || (_selectedTrigger.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition)))">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @t[TranslationKeys.Save]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showDropModal && _selectedTrigger is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>@t[TranslationKeys.TriggerTabDropTitle]</h5>
                        <button type="button" class="btn-close" @onclick="CloseModals"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">@t.Get(TranslationKeys.TriggerTabConfirmDrop, $"{_selectedTrigger.SchemaName}.{_selectedTrigger.TriggerName}")</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-light" @onclick="CloseModals">@t[TranslationKeys.Cancel]</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="ExecuteDropTrigger" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @t[TranslationKeys.Delete]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public ServerConfiguration? ServerConfig { get; set; }

    [Parameter]
    public EventCallback<string> OnOperationComplete { get; set; }

    private ITranslator t => TranslationFactory.Current;
    private DatabaseManager? _manager;
    private List<string> _databases = new();
    private List<string> _schemas = new();
    private List<string> _tableNames = new();
    private List<TriggerOperation.Information> _triggers = new();
    private string _selectedDatabase = string.Empty;
    private string _selectedSchemaFilter = string.Empty;
    private string _searchFilter = string.Empty;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isLoadingDefinition;
    private bool _isDecrypting;
    private bool _isDecrypted;
    private bool _isDacRequired;
    private bool _isEnablingDac;
    private BprMessage? _bprMessage;
    private BprMessage? _modalBprMessage;
    private bool _isCopied;
    private bool _isFullScreen;

    private bool _showCreateModal;
    private bool _showDefinitionModal;
    private bool _showDropModal;
    private TriggerOperation.Information? _selectedTrigger;
    private TriggerOperation.Create _createModel = new();
    private string _editDefinition = string.Empty;

    private List<TriggerOperation.Information> FilteredTriggers => _triggers
        .Where(trig => string.IsNullOrWhiteSpace(_selectedSchemaFilter) || string.Equals(trig.SchemaName, _selectedSchemaFilter, StringComparison.OrdinalIgnoreCase))
        .Where(trig => string.IsNullOrWhiteSpace(_searchFilter) || trig.TriggerName.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) || trig.TableName.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (ServerConfig is not null)
        {
            _manager = DatabaseManagerFactory.Create(ServerConfig);
            await LoadDatabases();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ServerConfig is not null)
        {
            _manager = DatabaseManagerFactory.Create(ServerConfig);
            if (_databases.Count == 0)
            {
                await LoadDatabases();
            }
        }
    }

    private async Task LoadDatabases()
    {
        if (_manager is null) return;
        _isLoading = true;
        try
        {
            var result = await _manager.GetDatabases();
            if (result.operationResult.Success)
            {
                _databases = result.databases;
                _selectedDatabase = string.Empty;
            }
            else
            {
                ShowMessage(result.operationResult);
            }
        }
        catch (Exception ex)
        {
            _bprMessage = BprMessage.Error(TranslationFactory.Current.Get(TranslationKeys.CommonOperationFailed, ex.Message));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnDatabaseChanged(ChangeEventArgs e)
    {
        _selectedDatabase = e.Value?.ToString() ?? string.Empty;
        _selectedSchemaFilter = string.Empty;
        _searchFilter = string.Empty;
        _triggers.Clear();
        _schemas.Clear();
        _tableNames.Clear();
        ClearMessage();

        if (!string.IsNullOrWhiteSpace(_selectedDatabase))
        {
            await LoadSchemasAndTriggers();
        }
    }

    private void ClearSelection()
    {
        _selectedDatabase = string.Empty;
        _selectedSchemaFilter = string.Empty;
        _searchFilter = string.Empty;
        _triggers.Clear();
        _schemas.Clear();
        _tableNames.Clear();
        ClearMessage();
    }

    private async Task RefreshTriggers()
    {
        if (!string.IsNullOrWhiteSpace(_selectedDatabase))
        {
            await LoadSchemasAndTriggers();
        }
    }

    private async Task LoadSchemasAndTriggers()
    {
        if (_manager is null || string.IsNullOrWhiteSpace(_selectedDatabase)) return;
        _isLoading = true;
        try
        {
            var schemasTask = _manager.GetSchemas(_selectedDatabase);
            var triggersTask = _manager.GetTriggers(_selectedDatabase);
            var tablesTask = _manager.GetTableList(_selectedDatabase);

            await Task.WhenAll(schemasTask, triggersTask, tablesTask);

            var schemasResult = await schemasTask;
            if (schemasResult.operationResult.Success)
            {
                _schemas = schemasResult.schemas;
            }

            var triggersResult = await triggersTask;
            if (triggersResult.operationResult.Success)
            {
                _triggers = triggersResult.triggers;
            }
            else
            {
                ShowMessage(triggersResult.operationResult);
            }

            var tablesResult = await tablesTask;
            if (tablesResult.operationResult.Success)
            {
                _tableNames = tablesResult.tables.Select(tbl => tbl.TableName).OrderBy(x => x).ToList();
            }
        }
        catch (Exception ex)
        {
            _bprMessage = BprMessage.Error(TranslationFactory.Current.Get(TranslationKeys.CommonOperationFailed, ex.Message));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreate()
    {
        _createModel = new TriggerOperation.Create
        {
            DatabaseName = _selectedDatabase,
            SchemaName = _schemas.FirstOrDefault() ?? "dbo",
            TableName = _tableNames.FirstOrDefault() ?? string.Empty,
            TableSchema = _schemas.FirstOrDefault() ?? "dbo",
            Timing = "AFTER",
            OnInsert = true,
            OnUpdate = false,
            OnDelete = false,
            WithEncryption = false,
            Body = "AS\nBEGIN\n    SET NOCOUNT ON;\n    -- Trigger logic here\nEND"
        };
        _modalBprMessage = null;
        _showCreateModal = true;
    }

    private async Task ExecuteCreateTrigger()
    {
        if (_manager is null) return;
        _isSaving = true;
        try
        {
            _createModel.DatabaseName = _selectedDatabase;
            var result = await _manager.CreateTrigger(_createModel);
            if (result.Success)
            {
                ShowMessage(result);
                CloseModals();
                await LoadSchemasAndTriggers();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
            else
            {
                _modalBprMessage = result;
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task OpenTriggerDefinition(TriggerOperation.Information trig)
    {
        if (_manager is null) return;
        _selectedTrigger = trig;
        _isLoadingDefinition = true;
        _showDefinitionModal = true;
        _editDefinition = string.Empty;
        _isDecrypted = false;
        _modalBprMessage = null;
        _isCopied = false;
        _isFullScreen = false;

        try
        {
            var info = await _manager.GetTriggerInformation(_selectedDatabase, trig.SchemaName, trig.TriggerName);
            if (info.operationResult.Success && info.trigger is not null)
            {
                _selectedTrigger = info.trigger;
                if (string.IsNullOrWhiteSpace(_selectedTrigger.TableName) && !string.IsNullOrWhiteSpace(trig.TableName))
                {
                    _selectedTrigger.TableName = trig.TableName;
                    _selectedTrigger.TableSchema = trig.TableSchema;
                }
                _editDefinition = info.trigger.Definition;
            }
            else
            {
                ShowMessage(info.operationResult);
            }
        }
        finally
        {
            _isLoadingDefinition = false;
        }
    }

    private async Task ExecuteDecryptTrigger()
    {
        if (_manager is null || _selectedTrigger is null) return;
        _isDecrypting = true;
        _isDacRequired = false;
        _modalBprMessage = null;
        try
        {
            var result = await _manager.DecryptTrigger(_selectedDatabase, _selectedTrigger.SchemaName, _selectedTrigger.TriggerName);
            if (result.Success && !string.IsNullOrWhiteSpace(result.DecryptedDefinition))
            {
                _editDefinition = result.DecryptedDefinition;
                _isDecrypted = true;
                _isDacRequired = false;
                _modalBprMessage = BprMessage.Success(t[TranslationKeys.CommonDecryptedSuccess]);
                ShowMessage(_modalBprMessage);
            }
            else
            {
                if (result.IsDacRequired)
                {
                    _isDacRequired = true;
                }
                _modalBprMessage = BprMessage.Error(t.Get(TranslationKeys.CommonDecryptionFailed, result.Message));
                ShowMessage(_modalBprMessage);
            }
        }
        finally
        {
            _isDecrypting = false;
        }
    }

    private async Task ExecuteEnableRemoteDac()
    {
        if (_manager is null) return;
        _isEnablingDac = true;
        _modalBprMessage = null;
        try
        {
            var result = await _manager.EnableRemoteDac();
            if (result.Success)
            {
                _isDacRequired = false;
                _modalBprMessage = BprMessage.Success(t[TranslationKeys.CommonRemoteDacEnabled]);
                ShowMessage(_modalBprMessage);
            }
            else
            {
                _modalBprMessage = result;
                ShowMessage(result);
            }
        }
        finally
        {
            _isEnablingDac = false;
        }
    }

    private async Task ExecuteAlterTrigger()
    {
        if (_manager is null || _selectedTrigger is null) return;
        if (_selectedTrigger.IsEncrypted && !_isDecrypted && string.IsNullOrWhiteSpace(_editDefinition))
        {
            _modalBprMessage = BprMessage.Warning(t[TranslationKeys.CommonCannotSaveEncryptedEmpty]);
            return;
        }

        _isSaving = true;
        try
        {
            var alter = new TriggerOperation.Alter
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _selectedTrigger.SchemaName,
                TriggerName = _selectedTrigger.TriggerName,
                TableSchema = _selectedTrigger.TableSchema,
                TableName = _selectedTrigger.TableName,
                Body = _editDefinition,
                WithEncryption = _selectedTrigger.WithEncryption
            };

            var result = await _manager.AlterTrigger(alter);
            if (result.Success)
            {
                ShowMessage(result);
                CloseModals();
                await LoadSchemasAndTriggers();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
            else
            {
                _modalBprMessage = result;
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleTriggerState(TriggerOperation.Information trig)
    {
        if (_manager is null) return;
        _isSaving = true;
        try
        {
            var toggle = new TriggerOperation.ToggleState
            {
                DatabaseName = _selectedDatabase,
                SchemaName = trig.SchemaName,
                TriggerName = trig.TriggerName,
                TableSchema = trig.TableSchema,
                TableName = trig.TableName,
                Enable = trig.IsDisabled // If currently disabled, enable it; and vice versa
            };

            var result = await _manager.ToggleTrigger(toggle);
            ShowMessage(result);
            if (result.Success)
            {
                await LoadSchemasAndTriggers();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDrop(TriggerOperation.Information trig)
    {
        _selectedTrigger = trig;
        _showDropModal = true;
    }

    private async Task ExecuteDropTrigger()
    {
        if (_manager is null || _selectedTrigger is null) return;
        _isSaving = true;
        try
        {
            var drop = new TriggerOperation.Drop
            {
                DatabaseName = _selectedDatabase,
                SchemaName = _selectedTrigger.SchemaName,
                TriggerName = _selectedTrigger.TriggerName
            };
            var result = await _manager.DropTrigger(drop);
            ShowMessage(result);
            if (result.Success)
            {
                CloseModals();
                await LoadSchemasAndTriggers();
                await OnOperationComplete.InvokeAsync(result.Message);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseModals()
    {
        _showCreateModal = false;
        _showDefinitionModal = false;
        _showDropModal = false;
        _selectedTrigger = null;
        _isDecrypted = false;
        _isDacRequired = false;
        _modalBprMessage = null;
        _isCopied = false;
        _isFullScreen = false;
    }

    private void ToggleFullScreen() => _isFullScreen = !_isFullScreen;

    private async Task CopyDefinitionToClipboard()
    {
        if (string.IsNullOrWhiteSpace(_editDefinition)) return;
        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", _editDefinition);
            _isCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _isCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Ignore clipboard errors
        }
    }

    private void ShowMessage(OperationResult result) => _bprMessage = result;
    private void ShowMessage(BprMessage? message) => _bprMessage = message;
    private void ClearMessage() => _bprMessage = null;

    private static string FormatDate(DateTime date) =>
        date == DateTime.MinValue ? "—" : date.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}

@using System.Data
@using BprDevKit.Config
@using BprDevKit.DatabaseManagement.Models.Operations;
@using BprDevKit.DatabaseManagement
@using BprDevKit.DatabaseManagement.Connections
@using BprDevKit.DatabaseManagement.Models
@using BprDevKit.Utility
@inject DatabaseManagerFactory DatabaseManagerFactory
@inject ITranslationFactory TranslationFactory

@{
    var t = TranslationFactory.Current;
}

<div class="databases-management">
    <div class="database-toolbar d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="h4 mb-1"><i class="bi bi-database-fill text-primary me-2"></i>@t[TranslationKeys.Databases]</h2>
            <p class="text-muted mb-0">@t[TranslationKeys.DbTabSubtitle]</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" type="button" @onclick="() => OpenRestoreDatabase()">
                <i class="bi bi-arrow-counterclockwise me-1"></i> @t[TranslationKeys.DbTabRestoreDb]
            </button>
            <button class="create-database-button btn btn-primary" type="button" @onclick="OpenCreateDatabase">
                <i class="bi bi-plus-lg me-1"></i> @t[TranslationKeys.DbTabCreateDb]
            </button>
        </div>
    </div>

    <BprAlert Message="@_bprMessage" OnDismiss="ClearMessage" CssClass="database-alert mb-4" />

    @if (_showCreateForm)
    {
        <div class="database-editor card border-primary shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-database-add me-2"></i>@t[TranslationKeys.DbTabCreateDb]</span>
                <button class="btn-close btn-close-white" type="button" @onclick="CloseCreateDatabase"></button>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="database-name">@t[TranslationKeys.Name]</label>
                        <input id="database-name" class="form-control" maxlength="@(ServerConfig?.Database?.MaxDatabaseNameLength ?? Constants.MaxDatabaseNameLength)" @bind="_createConfiguration.DatabaseName" placeholder="ExampleDb" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="database-collation">@t[TranslationKeys.DbTabCollation] <span class="text-muted fw-normal">@t[TranslationKeys.DbTabOptional]</span></label>
                        <select id="database-collation" class="form-select" @bind="_createConfiguration.Collation">
                            <option value="">@t[TranslationKeys.DbTabServerDefault]</option>
                            @foreach (var collation in _collations)
                            {
                                <option value="@collation">@collation</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="data-directory">@t[TranslationKeys.DbTabDataDirectory]</label>
                        <input id="data-directory" class="form-control" @bind="_createConfiguration.DataFilePath" placeholder="D:\\SqlData" />
                        <div class="form-text">@t[TranslationKeys.DbTabDataDirHelp]</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="log-directory">@t[TranslationKeys.DbTabLogDirectory] <span class="text-muted fw-normal">@t[TranslationKeys.DbTabOptional]</span></label>
                        <input id="log-directory" class="form-control" @bind="_createConfiguration.LogFilePath" placeholder="D:\\SqlLogs" />
                        <div class="form-text">@t[TranslationKeys.DbTabLogDirHelp]</div>
                    </div>
                </div>

                <hr class="my-4" />
                <h3 class="h6 text-uppercase text-muted mb-3">@t[TranslationKeys.DbTabDataFile]</h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="data-initial-size">@t[TranslationKeys.DbTabInitialSizeMB]</label>
                        <input id="data-initial-size" type="number" min="1" class="form-control" @bind="_createConfiguration.InitialSizeMB" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="data-max-size">@t[TranslationKeys.DbTabMaxSizeMB]</label>
                        <input id="data-max-size" type="number" min="1" class="form-control" @bind="_createConfiguration.MaxSizeMB" placeholder="@t[TranslationKeys.DbTabUnlimited]" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="data-growth">@t[TranslationKeys.DbTabGrowthMB]</label>
                        <input id="data-growth" type="number" min="1" class="form-control" @bind="_createConfiguration.FileGrowthMB" />
                    </div>
                </div>

                <h3 class="h6 text-uppercase text-muted mb-3 mt-4">@t[TranslationKeys.DbTabLogFile]</h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="log-initial-size">@t[TranslationKeys.DbTabInitialSizeMB]</label>
                        <input id="log-initial-size" type="number" min="1" class="form-control" @bind="_createConfiguration.LogInitialSizeMB" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="log-max-size">@t[TranslationKeys.DbTabMaxSizeMB]</label>
                        <input id="log-max-size" type="number" min="1" class="form-control" @bind="_createConfiguration.LogMaxSizeMB" placeholder="@t[TranslationKeys.DbTabUnlimited]" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="log-growth">@t[TranslationKeys.DbTabGrowthMB]</label>
                        <input id="log-growth" type="number" min="1" class="form-control" @bind="_createConfiguration.LogFileGrowthMB" />
                    </div>
                </div>

                <h3 class="h6 text-uppercase text-muted mb-3 mt-4">@t[TranslationKeys.DbTabDbOptions]</h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="recovery-model">@t[TranslationKeys.DbTabRecoveryModel]</label>
                        <select id="recovery-model" class="form-select" @bind="_createConfiguration.RecoveryModel">
                            <option value="SIMPLE">@t[TranslationKeys.DbTabRecoverySimple]</option>
                            <option value="FULL">@t[TranslationKeys.DbTabRecoveryFull]</option>
                            <option value="BULK_LOGGED">@t[TranslationKeys.DbTabRecoveryBulkLogged]</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="page-verify">@t[TranslationKeys.DbTabPageVerify]</label>
                        <select id="page-verify" class="form-select" @bind="_createConfiguration.PageVerify">
                            <option value="CHECKSUM">@t[TranslationKeys.DbTabPageVerifyChecksum]</option>
                            <option value="TORN_PAGE_DETECTION">@t[TranslationKeys.DbTabPageVerifyTornPage]</option>
                            <option value="NONE">@t[TranslationKeys.DbTabPageVerifyNone]</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="compatibility-level">@t[TranslationKeys.DbTabCompatibilityLevel] <span class="text-muted fw-normal">@t[TranslationKeys.DbTabOptional]</span></label>
                        <input id="compatibility-level" type="number" min="1" class="form-control" @bind="_createConfiguration.CompatibilityLevel" placeholder="@t[TranslationKeys.DbTabServerDefault]" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="file-group">@t[TranslationKeys.DbTabAdditionalFilegroup] <span class="text-muted fw-normal">@t[TranslationKeys.DbTabOptional]</span></label>
                        <input id="file-group" maxlength="128" class="form-control" @bind="_createConfiguration.FileGroup" placeholder="Reporting" />
                        <div class="form-text">@t[TranslationKeys.DbTabFilegroupHelp]</div>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input id="is-read-only" class="form-check-input" type="checkbox" @bind="_createConfiguration.IsReadOnly" /><label class="form-check-label" for="is-read-only">@t[TranslationKeys.DbTabReadOnly]</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input id="auto-shrink" class="form-check-input" type="checkbox" @bind="_createConfiguration.AutoShrink" /><label class="form-check-label" for="auto-shrink">@t[TranslationKeys.DbTabAutoShrink]</label>
                        </div>
                    </div>
                    <div class="col-md-4"><div class="form-check form-switch"><input id="auto-close" class="form-check-input" type="checkbox" @bind="_createConfiguration.AutoClose" /><label class="form-check-label" for="auto-close">@t[TranslationKeys.DbTabAutoClose]</label></div></div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button class="btn btn-light" type="button" @onclick="CloseCreateDatabase">@t[TranslationKeys.Cancel]</button>
                    <button class="btn btn-success" type="button" @onclick="CreateDatabase" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @t[TranslationKeys.DbTabCreateDb]
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (_isLoading)
            {
                <div class="text-center py-5"><span class="spinner-border text-primary me-2"></span>@t[TranslationKeys.DbTabLoadingDatabases]</div>
            }
            else if (_databases.Count == 0)
            {
                <div class="text-center text-muted py-5"><i class="bi bi-database-x display-6"></i><p class="mt-3 mb-0">@t[TranslationKeys.DbTabNoDatabasesFound]</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="database-list-table table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th class="ps-4">@t[TranslationKeys.Database]</th><th class="text-end pe-4">@t[TranslationKeys.Actions]</th></tr></thead>
                        <tbody>
                            @foreach (var databaseName in _databases)
                            {
                                <tr>
                                    <td class="ps-4"><i class="bi bi-database me-2 text-primary"></i><span class="font-monospace">@databaseName</span></td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-success" type="button" title="@t[TranslationKeys.DbTabBackupDb]" @onclick="() => OpenBackupDatabase(databaseName)"><i class="bi bi-hdd-fill"></i></button>
                                            <button class="btn btn-outline-primary" type="button" title="@t[TranslationKeys.DbTabViewDetails]" @onclick="() => ViewDatabase(databaseName)"><i class="bi bi-info-circle"></i></button>
                                            <button class="btn btn-outline-secondary" type="button" title="@t[TranslationKeys.DbTabEditOptions]" @onclick="() => OpenEditDatabase(databaseName)"><i class="bi bi-pencil-square"></i></button>
                                            <button class="btn btn-outline-danger" type="button" title="@t[TranslationKeys.DbTabDeleteDb]" @onclick="() => OpenDeleteDatabase(databaseName)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (_showEditDialog)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header"><h2 class="modal-title fs-5"><i class="bi bi-pencil-square me-2"></i>@t.Get(TranslationKeys.DbTabEditTitle, _editConfiguration.DatabaseName)</h2><button class="btn-close" type="button" @onclick="CloseDialogs"></button></div>
                    <div class="modal-body">
                        <p class="text-muted small">@t[TranslationKeys.DbTabKeepCurrentValueHelp]</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="edit-collation">@t[TranslationKeys.DbTabCollation]</label><select id="edit-collation" class="form-select" @bind="_editConfiguration.Collation">
                                <option value="">@t[TranslationKeys.DbTabKeepCurrentValue]</option>@foreach (var collation in _collations) {
                                <option value="@collation">@collation</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="edit-recovery">@t[TranslationKeys.DbTabRecoveryModel]</label><select id="edit-recovery" class="form-select" @bind="_editConfiguration.RecoveryModel"><option value="">@t[TranslationKeys.DbTabKeepCurrentValue]</option><option value="SIMPLE">@t[TranslationKeys.DbTabRecoverySimple]</option><option value="FULL">@t[TranslationKeys.DbTabRecoveryFull]</option><option value="BULK_LOGGED">@t[TranslationKeys.DbTabRecoveryBulkLogged]</option></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="edit-page-verify">@t[TranslationKeys.DbTabPageVerify]</label><select id="edit-page-verify" class="form-select" @bind="_editConfiguration.PageVerify"><option value="">@t[TranslationKeys.DbTabKeepCurrentValue]</option><option value="CHECKSUM">@t[TranslationKeys.DbTabPageVerifyChecksum]</option><option value="TORN_PAGE_DETECTION">@t[TranslationKeys.DbTabPageVerifyTornPage]</option><option value="NONE">@t[TranslationKeys.DbTabPageVerifyNone]</option></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="edit-compatibility">@t[TranslationKeys.DbTabCompatibilityLevel]</label><input id="edit-compatibility" type="number" min="1" class="form-control" @bind="_editConfiguration.CompatibilityLevel" placeholder="@t[TranslationKeys.DbTabKeepCurrentValue]" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="edit-read-only">@t[TranslationKeys.DbTabReadOnly]</label><select id="edit-read-only" class="form-select" @bind="_readOnlySelection"><option value="">@t[TranslationKeys.DbTabKeepCurrentValue]</option><option value="true">@t[TranslationKeys.Enable]</option><option value="false">@t[TranslationKeys.Disable]</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="edit-auto-shrink">@t[TranslationKeys.DbTabAutoShrink]</label><select id="edit-auto-shrink" class="form-select" @bind="_autoShrinkSelection"><option value="">@t[TranslationKeys.DbTabKeepCurrentValue]</option><option value="true">@t[TranslationKeys.Enable]</option><option value="false">@t[TranslationKeys.Disable]</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="edit-auto-close">@t[TranslationKeys.DbTabAutoClose]</label><select id="edit-auto-close" class="form-select" @bind="_autoCloseSelection"><option value="">@t[TranslationKeys.DbTabKeepCurrentValue]</option><option value="true">@t[TranslationKeys.Enable]</option><option value="false">@t[TranslationKeys.Disable]</option></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-light" type="button" @onclick="CloseDialogs">@t[TranslationKeys.Cancel]</button><button class="btn btn-primary" type="button" @onclick="SaveDatabaseChanges" disabled="@_isSaving">@t[TranslationKeys.SaveChanges]</button></div>
        </div>
    </div>
</div><div class="modal-backdrop fade show"></div>
}

@if (_showDeleteDialog)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h2 class="modal-title fs-5"><i class="bi bi-exclamation-triangle-fill me-2"></i>@t[TranslationKeys.DbTabDeleteDb]</h2><button class="btn-close btn-close-white" type="button" @onclick="CloseDialogs"></button>
                </div>
                <div class="modal-body">
                    <p>@t.Get(TranslationKeys.DbTabDeleteConfirm, _deleteConfiguration.DatabaseName)</p><p class="text-danger small">@t[TranslationKeys.ServerActionUndoneWarning]</p><div class="form-check"><input id="force-disconnect" type="checkbox" class="form-check-input" @bind="_deleteConfiguration.ForceDisconnect" /><label class="form-check-label" for="force-disconnect">@t[TranslationKeys.DbTabForceDisconnect]</label></div><div class="form-check mt-2"><input id="ignore-if-not-exists" type="checkbox" class="form-check-input" @bind="_deleteConfiguration.IgnoreIfNotExists" /><label class="form-check-label" for="ignore-if-not-exists">@t[TranslationKeys.DbTabIgnoreIfNotExists]</label></div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" type="button" @onclick="CloseDialogs">@t[TranslationKeys.Cancel]</button><button class="btn btn-danger" type="button" @onclick="DeleteDatabase" disabled="@_isSaving">@t[TranslationKeys.DbTabDeleteDb]</button>
                </div>
            </div>
        </div>
    </div><div class="modal-backdrop fade show"></div>
}

@if (_showInformationDialog && _databaseInformation is not null)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5"><i class="bi bi-info-circle me-2"></i>@t[TranslationKeys.DbTabDetailsTitle]</h2><button class="btn-close" type="button" @onclick="CloseDialogs"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
                        @foreach (DataColumn column in _databaseInformation.Columns)
                        {
                            <dt class="col-sm-5 text-muted">@column.ColumnName</dt>
                            <dd class="col-sm-7 text-break">@FormatValue(_databaseInformation.Rows[0][column])</dd>
                        }
                    </dl>
                </div>
                <div class="modal-footer"><button class="btn btn-primary" type="button" @onclick="CloseDialogs">@t[TranslationKeys.Close]</button></div>
            </div>
        </div>
    </div><div class="modal-backdrop fade show"></div>
}

@if (_showBackupDialog)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h2 class="modal-title fs-5"><i class="bi bi-hdd-fill me-2"></i>@t[TranslationKeys.DbTabBackupDb]: <span class="font-monospace">@_backupConfiguration.DatabaseName</span></h2>
                    <button class="btn-close btn-close-white" type="button" @onclick="CloseDialogs"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="backup-folder">@t[TranslationKeys.DbTabBackupFolder]</label>
                        <div class="input-group">
                            <input id="backup-folder" class="form-control font-monospace" @bind="_backupFolder" @bind:after="UpdateBackupFullPath" placeholder="D:\Backups" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="OpenFolderBrowserForBackup" title="@t[TranslationKeys.DbTabBrowse]">
                                <i class="bi bi-folder2-open me-1"></i> @t[TranslationKeys.DbTabBrowse]
                            </button>
                        </div>
                        <div class="form-text">@t[TranslationKeys.DbTabBackupPathHelp]</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="backup-filename">@t[TranslationKeys.DbTabBackupFileName]</label>
                        <input id="backup-filename" class="form-control font-monospace" @bind="_backupFileName" @bind:after="UpdateBackupFullPath" placeholder="Database_Backup.bak" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">@t[TranslationKeys.DbTabFullBackupPath]</label>
                        <div class="p-2 bg-light rounded font-monospace small text-break border">
                            <i class="bi bi-hdd me-1 text-primary"></i>@_backupConfiguration.BackupPath
                        </div>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input id="backup-compress" class="form-check-input" type="checkbox" @bind="_backupConfiguration.WithCompression" />
                        <label class="form-check-label" for="backup-compress">@t[TranslationKeys.DbTabWithCompression]</label>
                    </div>
                    <div class="form-check form-switch">
                        <input id="backup-copyonly" class="form-check-input" type="checkbox" @bind="_backupConfiguration.CopyOnly" />
                        <label class="form-check-label" for="backup-copyonly">@t[TranslationKeys.DbTabCopyOnly]</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" type="button" @onclick="CloseDialogs">@t[TranslationKeys.Cancel]</button>
                    <button class="btn btn-success" type="button" @onclick="ExecuteBackupDatabase" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_backupConfiguration.BackupPath))">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-hdd-fill me-1"></i> @t[TranslationKeys.DbTabBackupDb]
                    </button>
                </div>
            </div>
        </div>
    </div><div class="modal-backdrop fade show"></div>
}

@if (_showRestoreDialog)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h2 class="modal-title fs-5"><i class="bi bi-arrow-counterclockwise me-2"></i>@t[TranslationKeys.DbTabRestoreDb]</h2>
                    <button class="btn-close btn-close-white" type="button" @onclick="CloseDialogs"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="restore-db-name">@t[TranslationKeys.Database]</label>
                        <input id="restore-db-name" list="existing-databases-list" class="form-control font-monospace" @bind="_restoreConfiguration.DatabaseName" placeholder="MyDatabase" />
                        <datalist id="existing-databases-list">
                            @foreach (var db in _databases)
                            {
                                <option value="@db">@db</option>
                            }
                        </datalist>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="restore-path">@t[TranslationKeys.DbTabRestorePath]</label>
                        <div class="input-group">
                            <input id="restore-path" class="form-control font-monospace" @bind="_restoreConfiguration.RestorePath" placeholder="D:\Backups\MyDb_Backup.bak" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="OpenFileBrowserForRestore" title="@t[TranslationKeys.DbTabBrowse]">
                                <i class="bi bi-folder2-open me-1"></i> @t[TranslationKeys.DbTabBrowse]
                            </button>
                        </div>
                        <div class="form-text">@t[TranslationKeys.DbTabRestorePathHelp]</div>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input id="restore-replace" class="form-check-input" type="checkbox" @bind="_restoreConfiguration.WithReplace" />
                        <label class="form-check-label" for="restore-replace">@t[TranslationKeys.DbTabWithReplace]</label>
                    </div>
                    <div class="form-check form-switch">
                        <input id="restore-close-conn" class="form-check-input" type="checkbox" @bind="_restoreConfiguration.CloseExistingConnections" />
                        <label class="form-check-label" for="restore-close-conn">@t[TranslationKeys.DbTabCloseConnections]</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" type="button" @onclick="CloseDialogs">@t[TranslationKeys.Cancel]</button>
                    <button class="btn btn-primary" type="button" @onclick="ExecuteRestoreDatabase" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_restoreConfiguration.DatabaseName) || string.IsNullOrWhiteSpace(_restoreConfiguration.RestorePath))">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-arrow-counterclockwise me-1"></i> @t[TranslationKeys.DbTabRestoreDb]
                    </button>
                </div>
            </div>
        </div>
    </div><div class="modal-backdrop fade show"></div>
}

@if (_showBrowserDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.55); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" style="margin-top: 4rem;">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h2 class="modal-title fs-5">
                        <i class="bi @(_browserIsFileMode ? "bi-file-earmark-binary" : "bi-folder") me-2 text-warning"></i>
                        @(_browserIsFileMode ? t[TranslationKeys.DbTabSelectBakFile] : t[TranslationKeys.DbTabSelectFolder])
                    </h2>
                    <button class="btn-close btn-close-white" type="button" @onclick="() => _showBrowserDialog = false"></button>
                </div>
                <div class="modal-body p-3">
                    @if (_browserDrives.Count > 0)
                    {
                        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                            <span class="text-muted small fw-semibold">@t[TranslationKeys.DbTabDrives]:</span>
                            @foreach (var drive in _browserDrives)
                            {
                                <button type="button" class="btn btn-sm @(_browserCurrentPath.StartsWith(drive, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")" @onclick="() => NavigateToPath(drive)">
                                    <i class="bi bi-hdd me-1"></i>@drive
                                </button>
                            }
                        </div>
                    }
                    <div class="input-group mb-3">
                        <button class="btn btn-outline-secondary" type="button" @onclick="NavigateUp" title="@t[TranslationKeys.DbTabParentFolder]">
                            <i class="bi bi-arrow-up-circle"></i>
                        </button>
                        <input class="form-control font-monospace" @bind="_browserCurrentPath" @bind:event="onchange" />
                        <button class="btn btn-secondary" type="button" @onclick="() => NavigateToPath(_browserCurrentPath)">
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                    @if (_isLoadingBrowser)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    }
                    else if (_browserItems.Count == 0)
                    {
                        <div class="alert alert-light text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            @t[TranslationKeys.DbTabNoItems]
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush border rounded overflow-auto" style="max-height: 320px;">
                            @foreach (var item in _browserItems)
                            {
                                if (item.IsDirectory)
                                {
                                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2" @onclick="() => NavigateToPath(item.FullPath)">
                                        <span class="text-truncate">
                                            <i class="bi bi-folder-fill text-warning me-2 fs-5 align-middle"></i>
                                            <strong>@item.Name</strong>
                                        </span>
                                        <i class="bi bi-chevron-right text-muted small"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="list-group-item list-group-item-action list-group-item-light d-flex justify-content-between align-items-center py-2" @onclick="() => SelectFileFromBrowser(item.FullPath)">
                                        <span class="text-truncate">
                                            <i class="bi bi-database-fill-gear text-success me-2 fs-5 align-middle"></i>
                                            <span class="font-monospace">@item.Name</span>
                                        </span>
                                        @if (item.SizeBytes.HasValue)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary font-monospace">
                                                @(item.SizeBytes.Value >= 1024 * 1024 ? $"{item.SizeBytes.Value / (1024.0 * 1024.0):F1} MB" : $"{item.SizeBytes.Value / 1024.0:F1} KB")
                                            </span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light justify-content-between">
                    <div class="text-truncate small text-muted font-monospace" style="max-width: 55%;">
                        <i class="bi bi-geo-alt me-1"></i>@_browserCurrentPath
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => _showBrowserDialog = false">@t[TranslationKeys.Cancel]</button>
                        @if (!_browserIsFileMode)
                        {
                            <button class="btn btn-primary" type="button" @onclick="() => SelectFolderFromBrowser(_browserCurrentPath)">
                                <i class="bi bi-check2-circle me-1"></i>@t[TranslationKeys.DbTabSelectThisFolder]
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    [Parameter] public ServerConfiguration? ServerConfig { get; set; }
    [Parameter] public EventCallback<string> OnOperationComplete { get; set; }

    private DatabaseManager? _databaseManager;
    private Guid? _loadedServerId;
    private List<string> _databases = new();
    private List<string> _collations = new();
    private DatabaseOperation.Create _createConfiguration = new();
    private DatabaseOperation.Alter _editConfiguration = new();
    private DatabaseOperation.Drop _deleteConfiguration = new();
    private BackupOperation _backupConfiguration = new();
    private RestoreOperation _restoreConfiguration = new();
    private string _backupFolder = string.Empty;
    private string _backupFileName = string.Empty;
    private bool _showBrowserDialog;
    private bool _browserIsFileMode;
    private string _browserCurrentPath = "C:\\";
    private List<ServerFileSystemItem> _browserItems = new();
    private List<string> _browserDrives = new();
    private bool _isLoadingBrowser;
    private DataTable? _databaseInformation;
    private bool _showCreateForm;
    private bool _showEditDialog;
    private bool _showDeleteDialog;
    private bool _showInformationDialog;
    private bool _showBackupDialog;
    private bool _showRestoreDialog;
    private bool _isLoading;
    private bool _isSaving;
    private BprMessage? _bprMessage;
    private string _readOnlySelection = string.Empty;
    private string _autoShrinkSelection = string.Empty;
    private string _autoCloseSelection = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (ServerConfig?.Id == _loadedServerId)
            return;

        _loadedServerId = ServerConfig?.Id;
        _databaseManager = ServerConfig is null ? null : DatabaseManagerFactory.Create(ServerConfig);
        _databases.Clear();
        _collations.Clear();
        CloseCreateDatabase();
        CloseDialogs();

        if (_databaseManager is not null)
        {
            await LoadDatabases();
            await LoadCollations();
        }
    }

    private async Task LoadDatabases()
    {
        if (_databaseManager is null) return;
        _isLoading = true;
        try
        {
            var result = await _databaseManager.GetDatabases();
            if (result.operationResult.Success)
                _databases = result.databases;
            else
                ShowMessage(result.operationResult.Message, "alert-danger", "bi-x-octagon-fill");
        }
        catch (Exception exception)
        {
            ShowMessage(TranslationFactory.Current.Get(TranslationKeys.DbErrLoadDatabases, exception.Message), "alert-danger", "bi-x-octagon-fill");
        }
        finally { _isLoading = false; }
    }

    private async Task LoadCollations()
    {
        if (_databaseManager is null) return;
        var result = await _databaseManager.GetCollations();
        if (result.operationResult.Success) _collations = result.collations;
    }

    private void OpenCreateDatabase()
    {
        _createConfiguration = new DatabaseOperation.Create
        {
            InitialSizeMB = ServerConfig?.Database?.DefaultDataFileSizeMB ?? Constants.DefaultInitialDataSizeMB,
            FileGrowthMB = ServerConfig?.Database?.DefaultFileGrowthMB ?? Constants.DefaultFileGrowthMB,
            LogInitialSizeMB = ServerConfig?.Database?.DefaultLogFileSizeMB ?? Constants.DefaultInitialLogSizeMB,
            LogFileGrowthMB = ServerConfig?.Database?.DefaultLogFileGrowthMB ?? Constants.DefaultLogFileGrowthMB,
            RecoveryModel = "SIMPLE",
            PageVerify = "CHECKSUM"
        };
        _showCreateForm = true;
    }

    private void CloseCreateDatabase() { _showCreateForm = false; _createConfiguration = new DatabaseOperation.Create(); }

    private async Task CreateDatabase()
    {
        if (_databaseManager is null) return;
        _isSaving = true;
        try
        {
            var result = await _databaseManager.CreateDatabase(_createConfiguration);
            ShowMessage(result.Message, result.Success ? "alert-success" : "alert-danger", result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill");
            if (result.Success) { CloseCreateDatabase(); await LoadDatabases(); }
            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowMessage(TranslationFactory.Current.Get(TranslationKeys.DbErrCreateDatabase, exception.Message), "alert-danger", "bi-x-octagon-fill"); }
        finally { _isSaving = false; }
    }

    private async Task OpenEditDatabase(string databaseName)
    {
        if (_databaseManager is null) return;

        _isSaving = true;
        try
        {
            var result = await _databaseManager.GetDatabaseConfiguration(new DatabaseOperation.Information { DatabaseName = databaseName });
            if (result.operationResult.Success && result.configuration is not null)
            {
                _editConfiguration = result.configuration;
                _readOnlySelection = _editConfiguration.IsReadOnly switch
                {
                    true => "true",
                    false => "false",
                    _ => string.Empty
                };
                _autoShrinkSelection = _editConfiguration.AutoShrink switch
                {
                    true => "true",
                    false => "false",
                    _ => string.Empty
                };
                _autoCloseSelection = _editConfiguration.AutoClose switch
                {
                    true => "true",
                    false => "false",
                    _ => string.Empty
                };
                _showEditDialog = true;
            }
            else
            {
                ShowMessage(result.operationResult.Message, "alert-danger", "bi-x-octagon-fill");
            }
        }
        catch (Exception exception)
        {
            ShowMessage(TranslationFactory.Current.Get(TranslationKeys.DbErrLoadConfig, exception.Message), "alert-danger", "bi-x-octagon-fill");
        }
        finally { _isSaving = false; }
    }

    private async Task SaveDatabaseChanges()
    {
        if (_databaseManager is null) return;
        _editConfiguration.IsReadOnly = ParseNullableBoolean(_readOnlySelection);
        _editConfiguration.AutoShrink = ParseNullableBoolean(_autoShrinkSelection);
        _editConfiguration.AutoClose = ParseNullableBoolean(_autoCloseSelection);
        _isSaving = true;
        try
        {
            var result = await _databaseManager.AlterDatabase(_editConfiguration);
            ShowMessage(result.Message, result.Success ? "alert-success" : "alert-danger", result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill");
            if (result.Success) CloseDialogs();
            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowMessage(TranslationFactory.Current.Get(TranslationKeys.DbErrUpdateDatabase, exception.Message), "alert-danger", "bi-x-octagon-fill"); }
        finally { _isSaving = false; }
    }

    private void OpenDeleteDatabase(string databaseName)
    {
        _deleteConfiguration = new DatabaseOperation.Drop { DatabaseName = databaseName, IgnoreIfNotExists = true, ForceDisconnect = true };
        _showDeleteDialog = true;
    }

    private async Task DeleteDatabase()
    {
        if (_databaseManager is null) return;
        _isSaving = true;
        try
        {
            var result = await _databaseManager.DropDatabase(_deleteConfiguration);
            ShowMessage(result.Message, result.Success ? "alert-success" : "alert-danger", result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill");
            if (result.Success) { CloseDialogs(); await LoadDatabases(); }
            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception) { ShowMessage(TranslationFactory.Current.Get(TranslationKeys.DbErrDeleteDatabase, exception.Message), "alert-danger", "bi-x-octagon-fill"); }
        finally { _isSaving = false; }
    }

    private async Task ViewDatabase(string databaseName)
    {
        if (_databaseManager is null) return;
        try
        {
            var result = await _databaseManager.GetDatabaseInformation(new DatabaseOperation.Information { DatabaseName = databaseName });
            if (result.operationResult.Success && result.information is not null)
            {
                _databaseInformation = result.information;
                _showInformationDialog = true;
            }
            else ShowMessage(result.operationResult.Message, "alert-danger", "bi-x-octagon-fill");
        }
        catch (Exception exception) { ShowMessage(TranslationFactory.Current.Get(TranslationKeys.DbErrLoadDetails, exception.Message), "alert-danger", "bi-x-octagon-fill"); }
    }

    private void OpenBackupDatabase(string databaseName)
    {
        if (_databaseManager is null) return;
        _backupFileName = $"{databaseName}_Backup_{DevFunctions.GetReadableTimestamp()}.bak";
        _backupConfiguration = new BackupOperation
        {
            DatabaseName = databaseName,
            BackupPath = string.IsNullOrWhiteSpace(_backupFolder) ? _backupFileName : Path.Combine(_backupFolder, _backupFileName),
            WithCompression = true,
            CopyOnly = false
        };
        _showBackupDialog = true;
    }

    private void UpdateBackupFullPath()
    {
        _backupConfiguration.BackupPath = string.IsNullOrWhiteSpace(_backupFolder)
            ? _backupFileName
            : Path.Combine(_backupFolder, _backupFileName);
    }

    private async Task OpenFolderBrowserForBackup()
    {
        _browserIsFileMode = false;
        _browserCurrentPath = !string.IsNullOrWhiteSpace(_backupFolder) ? _backupFolder : "C:\\";
        await InitBrowser();
    }

    private async Task OpenFileBrowserForRestore()
    {
        _browserIsFileMode = true;
        if (!string.IsNullOrWhiteSpace(_restoreConfiguration.RestorePath))
        {
            var dir = Path.GetDirectoryName(_restoreConfiguration.RestorePath);
            _browserCurrentPath = !string.IsNullOrWhiteSpace(dir) ? dir : "C:\\";
        }
        else if (!string.IsNullOrWhiteSpace(_backupFolder))
        {
            _browserCurrentPath = _backupFolder;
        }
        else
        {
            _browserCurrentPath = "C:\\";
        }
        await InitBrowser();
    }

    private async Task InitBrowser()
    {
        _showBrowserDialog = true;
        _isLoadingBrowser = true;
        try
        {
            if (_databaseManager is not null)
            {
                _browserDrives = await _databaseManager.GetAvailableDrives();
                if (!_browserDrives.Any(d => _browserCurrentPath.StartsWith(d, StringComparison.OrdinalIgnoreCase)) && _browserDrives.Count > 0)
                {
                    _browserCurrentPath = _browserDrives[0];
                }
                _browserItems = await _databaseManager.GetFileSystemEntries(_browserCurrentPath, _browserIsFileMode);
            }
        }
        catch { }
        finally
        {
            _isLoadingBrowser = false;
        }
    }

    private async Task NavigateToPath(string path)
    {
        if (string.IsNullOrWhiteSpace(path) || _databaseManager is null) return;
        _isLoadingBrowser = true;
        _browserCurrentPath = path;
        try
        {
            _browserItems = await _databaseManager.GetFileSystemEntries(_browserCurrentPath, _browserIsFileMode);
        }
        catch { }
        finally
        {
            _isLoadingBrowser = false;
        }
    }

    private async Task NavigateUp()
    {
        if (string.IsNullOrWhiteSpace(_browserCurrentPath)) return;
        var parent = Path.GetDirectoryName(_browserCurrentPath.TrimEnd('\\'));
        if (!string.IsNullOrWhiteSpace(parent))
        {
            await NavigateToPath(parent);
        }
    }

    private void SelectFolderFromBrowser(string folderPath)
    {
        _backupFolder = folderPath;
        UpdateBackupFullPath();
        _showBrowserDialog = false;
    }

    private void SelectFileFromBrowser(string filePath)
    {
        _restoreConfiguration.RestorePath = filePath;
        if (string.IsNullOrWhiteSpace(_restoreConfiguration.DatabaseName))
        {
            var fileName = Path.GetFileNameWithoutExtension(filePath);
            var cleanName = fileName.Split('_')[0];
            if (!string.IsNullOrWhiteSpace(cleanName))
            {
                _restoreConfiguration.DatabaseName = cleanName;
            }
        }
        _showBrowserDialog = false;
    }

    private async Task ExecuteBackupDatabase()
    {
        if (_databaseManager is null || string.IsNullOrWhiteSpace(_backupConfiguration.BackupPath)) return;
        _isSaving = true;
        try
        {
            var result = await _databaseManager.BackupDatabase(_backupConfiguration);
            ShowMessage(result.Message, result.Success ? "alert-success" : "alert-danger", result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill");
            if (result.Success) CloseDialogs();
            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message, "alert-danger", "bi-x-octagon-fill");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenRestoreDatabase(string? defaultDb = null)
    {
        _restoreConfiguration = new RestoreOperation
        {
            DatabaseName = defaultDb ?? (_databases.Count > 0 ? _databases[0] : string.Empty),
            RestorePath = string.Empty,
            WithReplace = true,
            CloseExistingConnections = true
        };
        _showRestoreDialog = true;
    }

    private async Task ExecuteRestoreDatabase()
    {
        if (_databaseManager is null || string.IsNullOrWhiteSpace(_restoreConfiguration.DatabaseName) || string.IsNullOrWhiteSpace(_restoreConfiguration.RestorePath)) return;
        _isSaving = true;
        try
        {
            var result = await _databaseManager.RestoreDatabase(_restoreConfiguration);
            ShowMessage(result.Message, result.Success ? "alert-success" : "alert-danger", result.Success ? "bi-check-circle-fill" : "bi-x-octagon-fill");
            if (result.Success)
            {
                CloseDialogs();
                await LoadDatabases();
            }
            await OnOperationComplete.InvokeAsync(result.Message);
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message, "alert-danger", "bi-x-octagon-fill");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CloseDialogs()
    {
        _showEditDialog = _showDeleteDialog = _showInformationDialog = _showBackupDialog = _showRestoreDialog = _showBrowserDialog = false;
        _databaseInformation = null;
    }

    private void ShowMessage(BprMessage message) => _bprMessage = message;
    private void ShowMessage(OperationResult result) => _bprMessage = result;
    private void ShowMessage(string message, string messageClass = "alert-info", string messageIcon = "bi-info-circle-fill")
    {
        _bprMessage = messageClass.Contains("danger")
            ? BprMessage.Error(message)
            : messageClass.Contains("success")
                ? BprMessage.Success(message)
                : messageClass.Contains("warning")
                    ? BprMessage.Warning(message)
                    : BprMessage.Info(message);
    }
    private void ClearMessage() => _bprMessage = null;
    private static bool? ParseNullableBoolean(string value) => bool.TryParse(value, out var result) ? result : null;
    private static string FormatValue(object value) => value == DBNull.Value ? "—" : Convert.ToString(value) ?? "—";
}
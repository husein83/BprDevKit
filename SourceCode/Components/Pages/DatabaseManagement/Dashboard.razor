@page "/dashboard"
@using BprDevKit.DatabaseManagement
@using BprDevKit.Config
@using BprDevKit.Utility
@inject NavigationManager NavigationManager
@inject ServerConfiguration DatabaseConfig

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-12">
            <div class="dashboard-card p-4">
                <div class="dashboard-header d-flex justify-content-between align-items-center">
                    <h2 class="m-0">Database Dashboard</h2>
                </div>
                <div class="server-info">
                    <strong>Connected to:</strong> @_currentServerName
                </div>

                <div class="database-management-tabs mt-4">
                    <ul class="nav nav-tabs" id="managementTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="databases-tab" data-bs-toggle="tab" data-bs-target="#databases-tab-pane" type="button" role="tab">Databases</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="tables-tab" data-bs-toggle="tab" data-bs-target="#tables-tab-pane" type="button" role="tab">Tables</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="schemas-tab" data-bs-toggle="tab" data-bs-target="#schemas-tab-pane" type="button" role="tab">Schemas</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="views-tab" data-bs-toggle="tab" data-bs-target="#views-tab-pane" type="button" role="tab">Views</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="procedures-tab" data-bs-toggle="tab" data-bs-target="#procedures-tab-pane" type="button" role="tab">Procedures</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="functions-tab" data-bs-toggle="tab" data-bs-target="#functions-tab-pane" type="button" role="tab">Functions</button>
                        </li>
                    </ul>

                    <div class="tab-content mt-3" id="managementTabContent">
                        <div class="tab-pane fade show active" id="databases-tab-pane" role="tabpanel">
                            <DatabaseManagementTab ServerConfig="DatabaseConfig" />
                        </div>
                        <div class="tab-pane fade" id="tables-tab-pane" role="tabpanel">
                            <TableManagementTab ServerConfig="DatabaseConfig" />
                        </div>
                        <div class="tab-pane fade" id="schemas-tab-pane" role="tabpanel">
                            <SchemaManagementTab ServerConfig="DatabaseConfig" />
                        </div>
                        <div class="tab-pane fade" id="views-tab-pane" role="tabpanel">
                            <ViewManagementTab ServerConfig="DatabaseConfig" />
                        </div>
                        <div class="tab-pane fade" id="procedures-tab-pane" role="tabpanel">
                            <StoredProcedureManagementTab ServerConfig="DatabaseConfig" />
                        </div>
                        <div class="tab-pane fade" id="functions-tab-pane" role="tabpanel">
                            <FunctionManagementTab ServerConfig="DatabaseConfig" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _currentServerName = "Local SQL Server";
}
